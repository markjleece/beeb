\
\ God mode - activated by pressing and holding 'G' 'O' 'D' in quick succession
\  - gives K9 unlimited health and keys
\  - enables scrolling using the arror keys
\  - enables a specific level to be loaded using the number keys: 1..LEVEL_COUNT
\
\ Memory map:
\
\   +---------------------------------+ &FFFF
\   | Machine Operating System (MOS)  |
\   +---------------------------------+ &C000
\   | Paged ROMs / Sideways RAM       |
\   +---------------------------------+ &8000
\   | Screen (256x256, 4 color mode)  |
\   +---------------------------------+ &4000
\   | Game data (portions reloaded)   |
\   +---------------------------------+ &2C30
\   | Game code (6960 bytes)          |
\   +---------------------------------+ &1100
\   | Game data (portions reloaded)   | 
\   +---------------------------------+ &10E0
\   | DFS workspace                   |
\   +---------------------------------+ &10C0
\   | Game data (portions reloaded)   | 
\   +---------------------------------+ &1090
\   | DFS workspace                   |
\   +---------------------------------+ &1000
\   | Game data                       |
\   +---------------------------------+ &0E00
\   | MOS ROM workspace               |
\   +---------------------------------+ &0D60 
\   | Game data (portions reloaded)   | 
\   +---------------------------------+ &0900
\   | MOS sound/printer workspace     | 
\   +---------------------------------+ &08C0
\   | Game data (portions reloaded)   | 
\   +---------------------------------+ &0880
\   | MOS sound/printer workspace     | 
\   +---------------------------------+ &0800
\   | Game data (portions reloaded)   |
\   +---------------------------------+ &0300
\   | MOS general workspace           |
\   +---------------------------------+ &0200
\   | Stack (64 bytes)                | 
\   +---------------------------------+ &01C0
\   | Game data (portions reloaded)   |
\   +---------------------------------+ &0100
\   | Zero page MOS variables         |
\   +---------------------------------+ &0090
\   | Zero page game variables        |
\   +---------------------------------+ &0000
\
\ Memory addresses:
\
\   Address  Size  Description
\   -------  ----  -----------
\   &0100    192   1 enemy sprite*
\   &01C0    64    Program stack
\   &0200    256   MOS general workspace
\   &0300    192   1 enemy sprite*
\   &03C0    32    1 door sprite*
\   &03E0    32    Tile types* (repurposed MOS keyboard buffer)
\   &0400    480   10 game objects array*
\   &05E0    48    Game object order array*
\   &0610    384   2 enemy sprites*
\   &0790    96    1 K9 sprite*
\   &07F0    16    Black palette*
\   &0800    128   MOS workspace
\   &0880    64    Tile and sprite address tables (low-bytes)* (repurposed MOS printer buffer)
\   &08C0    64    MOS workspace
\   &0900    960   5 enemy sprites*
\   &0CC0    64    2 door sprites*
\   &0D00    32    Enemy health bar atlas* (repurposed NMI memory)
\   &0D20    64    Tile and sprite address tables (high-bytes)* (repurposed NMI memory)
\   &0D60    160   MOS ROM workspace
\   &0E00    384   2 enemy sprites*
\   &0F80    32    1 door sprite*
\   &0FA0    96    1 K9 sprite*
\   &1000    144   DFS workspace
\   &1090    48    Sound effects* (repurposed transient DFS memory)
\   &10C0    32    DFS workspace
\   &10E0    12    Sprite health bar table* (repurposed transient DFS memory)
\   &10EC    20    Draw object jump tables* (repurposed transient DFS memory)
\   &1100    6960  Program code
\   &2C30    864   9 K9 sprites*
\   &2F90    96    4 elevator sprites*
\   &2FF0    96    4 teleport sprites*
\   &3050    224   Gamebar sprites* (or sample.6502 if 16K+ of sideways RAM exists)
\   &3130    16    Level palette*
\   &3140    1728  Level tiles*
\   &3800    2048  Level tile grid*
\   &4000    16K   256x256 4-color screen**
\
\   * data updated on level load/reload
\   ** code and data is loaded beyond &4000 during startup and level load/reload
\
\ Scheduling:
\
\ Intermittent work is scheduled across frames using the frameCount variable, 
\ which is incremented each frame. Work is scheduled as follow:
\
\   Work                    Cadence 
\   ----                    -------
\   Redraw closed door      Every eight frames, offset by object index
\   Redraw static elevator  Every eight frames, offset by object index
\   Redraw static enemy     Every eight frames, offset by object index
\   Enemy AI                Every sixteen frames, offset by object index
\   End all enemy pursuit?  Every sixteen frames
\   Inflict damage on K9    Every sixteen frames, offset by 6 
\   Redraw gamebar          Every eight frames, offset by 2
\   Update draw order       Every thrity-two frames, offset by 8
\

\
\ Constants (addresses & VALUES)
\

\ debug flags
DEBUG_TILE_GRID_FLAGS = 0       \ overlay tile grid flags (super useful)
DEBUG_DISABLE_SIDEWAYS_RAM = 0  \ disable sideways RAM (useful to speed up startup time)
DEBUG_GODMODE_NO_REPLENISH = 0  \ disable god mode health & key replenishment (useful for testing levels)
DEBUG_WAIT_TENTHS = 0           \ waitTenths util routine (useful for debugging)

\ number of levels
LEVEL_COUNT = 6 \ max supported levels is 9

\ keys (keyTbl indices)
KEY_A = 0
KEY_D = 1
KEY_W = 2
KEY_S = 3
KEY_G = 4
KEY_O = 5
KEY_R = 6
KEY_SPACE = 7 
KEY_UP = 8
KEY_DOWN = 9 
KEY_LEFT = 10
KEY_RIGHT = 11
KEY_1 = 12
KEY_2 = 13
KEY_3 = 14
KEY_4 = 15
KEY_5 = 16
KEY_6 = 17
KEY_7 = 18
KEY_8 = 19
KEY_9 = 20
KEY_Z = 21
KEY_X = 22
KEY_COLON = 23
KEY_DIVIDE = 24
KEY_T = 25

\ object types (objectType bits 0,1)
OBJECT_TYPE_MASK = %00000011
OBJECT_TYPE_K9 = 0
OBJECT_TYPE_ENEMY = 1
OBJECT_TYPE_ELEVATOR = 2
OBJECT_TYPE_DOOR = 3

\ object animations (objectType bits 2..4)
ANIMATE_MASK = %00011100
ANIMATE_LOOK_LEFT = (0 << 2)
ANIMATE_LOOK_RIGHT = (1 << 2)
ANIMATE_MOVE_LEFT = (2 << 2)
ANIMATE_MOVE_RIGHT = (3 << 2)
ANIMATE_TURN_LEFT_TO_RIGHT = (4 << 2)
ANIMATE_TURN_RIGHT_TO_LEFT = (5 << 2)

\ enemy actions (objectType bits 5..7)
ACTION_MASK = %11100000
ACTION_LOOK = &00           \ zero
ACTION_PACE = &20           \ positive (non-zero)
ACTION_PURSUE_LEFT = &80    \ negative
ACTION_PURSUE_RIGHT = &A0   \ negative
ACTION_PURSUE_UP = &C0      \ negative
ACTION_PURSUE_DOWN = &E0    \ negative

\ animation counters
FRAME_COUNT_K9_TURN = 4
FRAME_COUNT_ENEMY_TURN = 8
FRAME_COUNT_ENEMY_WAIT = 150

\ laser frame count
LASER_FRAME_COUNT = 2

\ directions
DIRECTION_UP = -1
DIRECTION_DOWN = 1
DIRECTION_LEFT = -2
DIRECTION_RIGHT = 2

\ scrolling constants
AUTO_SCROLL_THRESHOLD = 96
AUTO_SCROLL_DISTANCE = 16

\ tile grid masks used to extract tile flags (top 3-bits) and tile indices (bottom 5 bits) from tile grid values
TILE_GRID_INDEX_MASK = &1F
TILE_GRID_FLAGS_MASK = &E0

\ tile grid flags
TILE_GRID_FLAGS_OPAQUE = &80 \ set if the tile is opaque.  E.g. a wall, closed door, active elevator, or is occupied by k9 or an enemy
TILE_GRID_FLAGS_K9 = &40     \ set if the tile is occupied by k9
TILE_GRID_FLAGS_ENEMY = &20  \ set if the tile is occupied by an enemy

\ tile type flags (copied from level editor)
TILE_TYPE_FLAG_OPAQUE = &80 \ matches tile grid opaque flag (see above)

\ tile types (copied from level editor)
TILE_TYPE_SPACE = 1
TILE_TYPE_WALL = (TILE_TYPE_FLAG_OPAQUE + 0)
TILE_TYPE_FLOOR = (TILE_TYPE_FLAG_OPAQUE + 1)
TILE_TYPE_KEY = (TILE_TYPE_FLAG_OPAQUE + 2)
TILE_TYPE_JEWEL = (TILE_TYPE_FLAG_OPAQUE + 3)
TILE_TYPE_DOOR = (TILE_TYPE_FLAG_OPAQUE + 4)
TILE_TYPE_ELEVATOR = (TILE_TYPE_FLAG_OPAQUE + 5)
TILE_TYPE_TELEPORT = (TILE_TYPE_FLAG_OPAQUE + 6)
TILE_TYPE_DESTRUCTIBLE_WALL = (TILE_TYPE_FLAG_OPAQUE + 7)
TILE_TYPE_SWITCH_OFF = (TILE_TYPE_FLAG_OPAQUE + 8)
TILE_TYPE_SWITCH_ON = (TILE_TYPE_FLAG_OPAQUE + 9)
TILE_TYPE_EXIT = (TILE_TYPE_FLAG_OPAQUE + 10)

\ common object state flags (objectState high nibble)
OBJECT_STATE_FLAGS_MASK = &F0
OBJECT_STATE_FLAGS_REDRAW = &80 \ negative
OBJECT_STATE_FLAGS_DESCENDING = &40
OBJECT_STATE_FLAGS_ASCENDING = &20
OBJECT_STATE_FLAGS_DISABLED = &10 \ applies to elevators, teleports, and doors
OBJECT_STATE_FLAGS_LASERED = &10  \ applies to k9 and enemies

\ door state flags (objectState low nibble)
DOOR_STATE_FLAGS_DOOR_OPEN = &08 \ set if door is open
DOOR_STATE_FLAGS_DOOR_UNLOCKED = &04 \ set if door is unlocked

\ elevator state passenger mask (objectState low nibble)
ELEVATOR_STATE_PASSENGER_MASK = &0F \ used to get index of passenger

\ enemy state flags and mask (objectState low nibble)
ENEMY_STATE_HEALTH_MASK = &07   \ enemy health (bits 0..2)
ENEMY_STATE_FLAGS_IMMOBILE = &08  \ set if enemy is firing weapon or a weeping angel is frozen (bit 3)

\ enemy constants
ENEMY_LOOK_RANGE = 12 \ range enemies can see (in tiles) 
ENEMY_WEAPON_RANGE = 3 \ range of enemy weapons (in tiles)
ENEMY_WEAPON_THRESHOLD = 2 \ enemy health required to use weapon
ENEMY_SPRINT_THRESHOLD = 4 \ enemy health required to move quickly
ENEMY_END_PURSUIT_COUNTER = 32 \ number of frames (x16) before enemies give up pursuit (10 seconds)

\ K9 damage counters
K9_DAMAGE_ON_COUNTER = 8 \ when to start inflicting damage on K9
K9_DAMAGE_OFF_COUNTER = 4 \ when to stop inflicting damage on K9, and pause

\ lasered tile constants
LASERED_TILE_STRENGTH = 20 \ strength of lasered tile (destructible wall or off-switch)

\ sprite indices (index into spriteAddrTbl)
SPRITE_COUNT = 35
SPRITE_INDEX_ENEMY_LEFT = 0  \ 0..3
SPRITE_INDEX_ENEMY_RIGHT = 4 \ 4..7
SPRITE_INDEX_ENEMY_TURN = 8  \ 8..10
SPRITE_INDEX_DOOR = 11       \ 11..14
SPRITE_INDEX_ELEVATOR = 15   \ 15..18
SPRITE_INDEX_TELEPORT = 19   \ 19..22
SPRITE_INDEX_K9_LEFT = 23    \ 23..26
SPRITE_INDEX_K9_RIGHT = 27   \ 27..30
SPRITE_INDEX_K9_TURN = 31    \ 31..33
SPRITE_INDEX_GAMEBAR = 34    \ 34

\ tile count
TILE_COUNT = 28

\ maximum number of game objects (k9 + enemies + elevators + doors)
MAX_OBJECT_COUNT = 48

\ sprite sizes (fixed)
ENEMY_SPRITE_WIDTH = 24
ENEMY_SPRITE_HEIGHT = 32
ENEMY_SPRITE_SIZE = ENEMY_SPRITE_WIDTH * ENEMY_SPRITE_HEIGHT / 4

K9_SPRITE_WIDTH = 24
K9_SPRITE_HEIGHT = 16 
K9_SPRITE_SIZE = K9_SPRITE_WIDTH * K9_SPRITE_HEIGHT / 4

ELEVATOR_SPRITE_WIDTH = 32
ELEVATOR_SPRITE_HEIGHT = 3
ELEVATOR_SPRITE_SIZE = ELEVATOR_SPRITE_WIDTH * ELEVATOR_SPRITE_HEIGHT / 4

DOOR_SPRITE_WIDTH = 4
DOOR_SPRITE_HEIGHT = 32
DOOR_SPRITE_SIZE = DOOR_SPRITE_WIDTH * DOOR_SPRITE_HEIGHT / 4

GAMEBAR_SPRITE_WIDTH = 112
GAMEBAR_SPRITE_HEIGHT = 8
GAMEBAR_SPRITE_SIZE = GAMEBAR_SPRITE_WIDTH * GAMEBAR_SPRITE_HEIGHT / 4

\ k9 health
MAX_HEALTH_HI = 16 \ (hi-byte)
LASER_HEALTH_THRESHOLD_HI = 4 \ (hi-byte)

\ maximum key count
MAX_KEY_COUNT = 9

\ IRQ vector address
IRQ1V = &0204

\ 39 character rows per frame
\ 8 scanlines per character row
\ each scanline is 64 micro seconds
\ v-sync normally occurs at character row 35 
\ v-sync interrupt occurs two scanlines later
\ delay to first scanline is:
VSYNC_DELAY = ((39 - 35) * 8 * 64) - (2 * 64)

\ delay to bottom of visible screen is:
VSYNC_SIGNAL_DELAY = VSYNC_DELAY + 32 * 8 * 64

\ sound effects
SOUND_EFFECT_PAIN = 0
SOUND_EFFECT_LASER_ON = 4
SOUND_EFFECT_LASER_OFF = 8
SOUND_EFFECT_HEART_BEAT = 12
SOUND_EFFECT_DIED = 16
SOUND_EFFECT_LEVEL_COMPLETE = 20
SOUND_EFFECT_ACHIEVEMENT = 24
SOUND_EFFECT_BLOCKED = 28
SOUND_EFFECT_MOVE = 32
SOUND_EFFECT_PURSUIT_ON = 36
SOUND_EFFECT_PURSUIT_OFF = 40

\ samples
SAMPLE_DALEK_EXTERMINATE = 0
SAMPLE_DALEK_GROAN = 1
SAMPLE_DALEK_WEAPON = 2
SAMPLE_K9_AFFIRMATIVE = 3
SAMPLE_K9_INSUFFICIENT_DATA = 4
SAMPLE_TARDIS_DOOR = 5

\ frame counter used to repeat exterminate sample
SAMPLE_EXTERMINATE_FRAME_COUNT = 100

\ frame counter used to inhibit move sound effects
INHIBIT_MOVE_SOUND_EFFECT_FRAME_COUNT = 30

\ data structure sizes (bytes)
LEVEL_TILE_GRID_SIZE = 2048         \ tile grid size
SOUND_EFFECTS_SIZE = 44             \ sound effects size
SWITCH_PAIRINGS_SIZE = 48           \ switch pairings size
DRAW_OBJECT_JUMP_TABLE_SIZE = 10    \ draw object jump tables size
ENEMY_HEALTH_BAR_TABLE_SIZE = 12    \ health bar table size
ENEMY_HEALTH_BAR_ATLAS_SIZE = 30    \ health bar atlas size
PCM_DATA_LOAD_BUFFER_SIZE = &C9A    \ PCM data load buffer size

\ crop transition flags
TRANSITION_VOID = 0
TRANSITION_RUNNING = 1
TRANSITION_COMPLETE = -1

\ MOS routines
osbyte = &FFF4
oswrch = &FFEE
osasci = &FFE3
oscli = &FFF7
osword = &FFF1
osfile = &FFDD

\ sprite atlas locations
enemyAtlas1 = &100
enemyAtlas2 = &300
enemyAtlas3 = &610
enemyAtlas4 = &900
enemyAtlas5 = &E00
doorAtlas1 = &3C0
doorAtlas2 = &CC0
doorAtlas3 = &F80
elevatorAtlas = &2F90
teleportAtlas = &2FF0
k9Atlas1 = &790
k9Atlas2 = &FA0
k9Atlas3 = &2C30
gamebarAtlas = &3050
gamebarAtlas_sidewaysRAM = &BF20        \ location when 16K sideways RAM is detected
healthBarAtlas = &0D02                  \ 30 byte atlas (repurposes NMI workspace)

\ black palette location
blackPalette = &07F0

\ sound effects location
soundEffects = &1090                    \ 44 byte sound effect data (repurposes DFS &1090-&10BF workspace)

\ tile and sprite address table locations
tileAddrTblLo = &0880                   \ 28 byte tile address table (low-bytes) (repurposes MOS printer buffer)
tileAddrTblHi = &0D20                   \ 28 byte tile address table (high-bytes) (repurposes NMI workspace)
spriteAddrTblLo = &089C                 \ 35 byte sprite address table (low-bytes) (repurposes MOS printer buffer)
spriteAddrTblHi = &0D3C                 \ 35 byte sprite address table (high-bytes) (repurposes NMI workspace)
spriteHealthBarTbl = &10E0              \ 12 byte sprite health bar table (repurposes DFS &10E0-&10FF workspace)

\ level data locations
levelLoadAddr = &3130                   \ address where level data is loaded
levelPalette = &3130                    \ 16 byte level palette
levelTiles = &3140                      \ 27 x 64 byte tiles.  Each tile contain two character rows of texel quads. Tiles are indexed from 1. Tile 0 is implicitly filled with zeros.
levelTileGrid = &3800                   \ 2K of tile values (flags/indicies)
levelTileTypes = &03E0                  \ 28 x 1-byte tile types (repurposes MOS keyboard buffer)

\ level load locations (data loaded into screen memory and relocated)
levelHorzTileCountLoaded = &4000        \ level extents
levelVertTileCountLoaded = &4001        
levelTileTypesLoaded = &4002            \ level tile types (relocated to levelTileTypes)
levelEnemyWeaponStrengthLoaded = &401E  \ level enemy weapon strength (relocated to enemyWeaponStrengthLo/Hi)
levelLaserStrengthLoaded = &401F        \ level laser strength (relocated to laserStrength)
levelLaserHealthDrainLoaded = &4020     \ level laser health drain (relocated to laserHealthDrain)
levelJewelHealthGainHiLoaded = &4021    \ level jewel health gain (relocated to jewelHealthGainHi)
levelSampleSoundsEnabledLoaded = &4022  \ level sound samples enabled flag (used in setting primarySamplesEnabled and secondarySamplesEnabled)
levelObjectsLoaded = &4023              \ level object descriptors (used to populate game objects)
levelSwitchPairingsLoaded = &40E3       \ level switch pairings

\ drawObject head and tail jump offset tables
drawObject_headJumpTbl = &10EC          \ 10 byte head jump offset table (repurposes DFS &10E0-&10FF workspace)
drawObject_tailJumpTbl = &10F6          \ 10 byte tail jump offset table (repurposes DFS &10E0-&10FF workspace)

\ dfs page backup (used to store page &17 that DFS modifies)
dfsPageBackup = &7B00

\ PCM data load address (located below page backup)
pcmDataLoadBuffer = &7B00 - PCM_DATA_LOAD_BUFFER_SIZE

\ zero page MOS location
zeroPageMOS = &90

\ 
\ Zero page variables...
\ 
ORG 0

\ persistent data (values persist across frames)
.zeroMemory32               SKIP 32 \ 32-byte zero memory (located here to catch errant writes)
.mosIRQ1V                   SKIP 2  \ MOS IRQ vector
.pcmDataAddr                SKIP 2  \ PCM data address
.scrnAddr                   SKIP 2  \ top left screen address
.godMode                    SKIP 1  \ see comment at top of file
.level                      SKIP 1  \ 1..LEVEL_COUNT
.objectCount                SKIP 1  \ number of game objects (<= MAX_OBJECT_COUNT)
.enemyCount                 SKIP 1  \ number of enemy game objects
.elevatorCount              SKIP 1  \ number of elevator game objects
.doorCount                  SKIP 1  \ number of door objects
.vsync                      SKIP 1  \ set on vsync
.frameCount                 SKIP 1  \ incremented every frame
.scrnLeftLo                 SKIP 1  \ left position of screen (low/high bytes)
.scrnLeftHi                 SKIP 1  
.scrnLeftHiMaxMinusOne      SKIP 1  \ maximum value of above variable, minue one
.scrnTopLo                  SKIP 1  \ top position of screen (low/high bytes)
.scrnTopHi                  SKIP 1
.scrnTopHiMaxMinusOne       SKIP 1  \ maximum value of above variable, minue one
.scrollCounter              SKIP 1  \ number of half-tiles to scroll, in the direction specified by scrollDirection
.scrollDirection            SKIP 1  \ scroll direction (DIRECTION_UP..DIRECTION_RIGHT)
.keyCount                   SKIP 1  \ current number of keys (0..9)
.healthLo                   SKIP 1  \ k9's health (low/high bytes) value range: 0..MAX_HEALTH_HI:&FF
.healthHi                   SKIP 1  
.laserInhibited             SKIP 1  \ set if laser is inhibited (occurs when enemy is destroyed)
.laserFrameCount            SKIP 1  \ 0..2 (2 = turn on, 1 = turn off, 0 = off)
.laserAddr                  SKIP 2  \ start address of drawn laser beam (used to undraw laser beam)
.laserDirection             SKIP 1  \ direction in which laser beam was drawn (used to undraw laser beam)
.laserLength                SKIP 1  \ length of drawn laser beam (used to undraw laser beam)
.laserLastPixels            SKIP 1  \ last pixels of drawn laser (used to undraw laser beam)
.enemyHealthLo              SKIP 1  \ low health byte of enemy. Used to decrement ememy health
.k9DamageCounter            SKIP 1  \ set to K9_DAMAGE_ON_COUNTER when enemy fires weapon
.endPursuitCounter          SKIP 1  \ set to ENEMY_END_PURSUIT_COUNTER when k9 is in sight
.pursuitSoundEffectCounter  SKIP 1  \ sound effect counter. Used to ignore duplicate requests and repeat sample
.laserSoundEffectOn         SKIP 1  \ sound effect flag. Used to ignore duplicate requests
.blockedSoundEffectOn       SKIP 1  \ sound effect flag. Used to ignore duplicate requests
.inhibitMoveSoundEffect     SKIP 1  \ sound effect flag. Used to inhibit move sound effects.
.groanInhibited             SKIP 1  \ sound effect flag. Used to inhibit groan sample.
.enemyHitTestLastFound      SKIP 1  \ cached hit test result (hit-test optimization)
.doorScrollRedrawCount      SKIP 1  \ used to redraw all doors after scrolling
.enemyWeaponStrengthLo      SKIP 1  \ enemy weapon strength
.enemyWeaponStrengthHi      SKIP 1
.laserStrength              SKIP 1  \ laser strength
.laserHealthDrain           SKIP 1  \ laser health drain
.jewelHealthGainHi          SKIP 1  \ jewel health gain (high byte)
.weepingAngels              SKIP 1  \ weeping angels flag (if set, enemies are immobilized when face-to-face with K9)
.playingSample              SKIP 1  \ playing sample flag (set when a sample is being played)
.primarySamplesEnabled      SKIP 1  \ primary samples enabled flag
.primarySamplesROMSEL       SKIP 1  \ primary samples ROM selector (zero denotes no sideways RAM)
.secondarySamplesEnabled    SKIP 1  \ secondary samples enabled flag
.secondarySamplesROMSEL     SKIP 1  \ secondary samples ROM selector (zero denotes no additional sideways RAM)
.transitionVariables                \ transition variables (transitionUpperTimer..transitionState should not be moved or reordered)
.transitionUpperTimer       SKIP 2  \ timer for controlling position of upper palette change
.transitionLowerTimer       SKIP 2  \ timer for controlling position of lower palette change
.transitionUpperTimerDelta  SKIP 1  \ delta time for adjusting upper position timer
.transitionLowerTimerDelta  SKIP 1  \ delta time for adjusting lower position timer
.transitionCounter          SKIP 1  \ transition counter
.transitionState            SKIP 1  \ transition state: TRANSITION_VOID, TRANSITION_RUNNING, TRANSITION_COMPLETE
.transitionPreviousIRQ1V    SKIP 2  \ IRQ1V prior to invoking transition
.transitionCompleteCallback SKIP 2  \ transition callback, invoked when crop open transition completes
.laseredTileLeft            SKIP 1  \ lasered tile position
.laseredTileTop             SKIP 1
.laseredTileStrength        SKIP 1  \ lasered tile strength
.laseredTileRedraw          SKIP 1  \ lasered tile redraw flag
.switchOnTileGridValue      SKIP 1  \ switch-on tile grid value

\ transient data (values do not persist across frames)
.deltaXLo                   SKIP 1
.deltaXHi                   SKIP 1
.deltaYLo                   SKIP 1
.deltaYHi                   SKIP 1
.tileGridAddr               SKIP 2  
.srcAddr                    SKIP 2 
.dstAddr                    SKIP 2
.srcBaseAddr                SKIP 2
.dstBaseAddr                SKIP 2
.leftLo                     SKIP 1
.leftHi                     SKIP 1
.topLo                      SKIP 1
.topHi                      SKIP 1
.rightLo                    SKIP 1
.rightHi                    SKIP 1
.bottomLo                   SKIP 1
.bottomHi                   SKIP 1
.offsetX                    SKIP 1
.offsetY                    SKIP 1
.index                      SKIP 1
.outerIndex                 SKIP 1
.stride                     SKIP 1
.direction                  SKIP 1
.temp                       SKIP 1
.count                      SKIP 1
.outerCount                 SKIP 1
.innerCount                 SKIP 1
.headCount                  SKIP 1
.offset                     SKIP 1
.eraseAbove                 SKIP 1
.eraseBelow                 SKIP 1
.flags                      SKIP 1
.width                      SKIP 1
.height                     SKIP 1
.widthMinusOne              SKIP 1
.heightMinusOne             SKIP 1
.lastZeroPageAddr

\ guard addresses
FOR addr, &90, &3FF
    GUARD addr
NEXT

\
\ game objects (properties are held across correlated arrays)
\
ORG &400
.objectType                 SKIP MAX_OBJECT_COUNT \ object type (bits 0,1), animation (bits 2..4), enemy action (bits 5..7)
.objectState                SKIP MAX_OBJECT_COUNT \ high nibble holds common flags, bottom nibble holds object specific information
.objectXLo                  SKIP MAX_OBJECT_COUNT \ object's top left position
.objectXHi                  SKIP MAX_OBJECT_COUNT
.objectYLo                  SKIP MAX_OBJECT_COUNT
.objectYHi                  SKIP MAX_OBJECT_COUNT
.objectSpriteIndex          SKIP MAX_OBJECT_COUNT \ sprite index, or -1 (draw blank)
.objectFrameCounter         SKIP MAX_OBJECT_COUNT \ frame counter used to time animation durations
.objectFrameCallbackLo      SKIP MAX_OBJECT_COUNT \ frame callback, called every frame
.objectFrameCallbackHi      SKIP MAX_OBJECT_COUNT 

\ array holding object indices, in draw order (top to bottom)
.objectDrawOrder            SKIP MAX_OBJECT_COUNT   

\
\ entry point
\
ORG &1100
.start
{
    LDX #&FF : TXS \ reset stack
    JSR titles
    .gameLoop
        JSR waitForVSync
        INC frameCount
        JSR completeTransition
        JSR inflictK9Damage
        JSR scrollScreen
        JSR drawObjects
        JSR drawLaser
        JSR refreshGameBar
        IF DEBUG_TILE_GRID_FLAGS != 0
            JSR debugTileGridFlags
        ENDIF
        JSR refreshObjectDrawOrder
        JSR keyboardInputHandlers
        JSR enemyAI
        JSR updateObjects
        JSR updateSoundEffects
        JMP gameLoop
}

\
\ includes...
\

INCLUDE "sound.6502"
INCLUDE "scroll.6502"
INCLUDE "draw.6502"
INCLUDE "k9.6502"
INCLUDE "enemy.6502"
INCLUDE "elevator.6502"
INCLUDE "teleport.6502"
INCLUDE "door.6502"
INCLUDE "tilegrid.6502"
INCLUDE "transition.6502"
INCLUDE "switch.6502"
INCLUDE "utils.6502"

\
\ in-game interrupt request routine
\
.ingame_irq
{
    \ save accumalator
    LDA &FC : PHA

    .^irq_try_vsync \ entry point from ingame_sample_irq

    \ System-VIA vsync irq?
    LDA &FE4D
    AND #2
    BEQ try_timer1
        \ mark vsync interrupt as handled
        STA &FE4D
    
        \ initiate Timer1. We signal v-sync and have MOS process sounds at
        \ the bottom of the visible screen
        LDA #LO(VSYNC_SIGNAL_DELAY) : STA &FE44
        LDA #HI(VSYNC_SIGNAL_DELAY) : STA &FE45

         \ restore accumulator, updating &FC
        PLA : STA &FC

        \ just return (we don't want MOS to process SYSTEM-VIA v-sync irqs)
        RTI
    
    .try_timer1

    \ System-VIA timer 1 irq?
    LDA &FE4D
    AND #&40
    BEQ try_mos
        \ signal vsync. We do this at the bottom of the visible screen to give 
        \ the game loop a head start
        INC vsync

        \ pass irq to MOS, which processes sounds using this timer

    .try_mos

    \ restore accumulator, updating &FC
    PLA : STA &FC

    JMP (mosIRQ1V) \ implicit RTI
}

\
\ showLevel
\
\ show level
\
.showLevel
{
    \ draw tile background
    JSR drawTileBackground

    \ start crop open transition
    LDA #LO(callback)
    LDY #HI(callback)
    JMP startCropOpenTransition \ implicit RTS

.callback
    \ set level palette
    JSR setLevelPalette

    \ invoke sound effect
    JMP (secondarySoundVector_startLevel) \ implicit RTS
}

\
\ keyboard input handlers
\
.keyboardInputHandlers
{
    \ scan keys populating top bits in keyTbl
    JSR scanKeys

    \ set god mode?
    LDA keyTbl + KEY_G
    AND keyTbl + KEY_O
    AND keyTbl + KEY_D
    BPL skip
        STA godMode \ set god mode
    .skip

    \ space key...
    LDA keyTbl + KEY_SPACE
    BPL nopress_space
        \ laser inhibited?
        LDA laserInhibited : BNE stopLaserSoundEffect

        \ reset laser frame count?
        LDA laserFrameCount : BNE skip_space
        LDA #LASER_FRAME_COUNT : STA laserFrameCount
        BNE skip_space

    .nopress_space       
        \ clear inhibited flags
        LDA #0
        STA laserInhibited
        STA groanInhibited

        \ laser sound effect off
        .stopLaserSoundEffect
        JSR silenceLaserSoundEffect
    .skip_space

    \ 'W' or ':' key...
    LDA keyTbl + KEY_W
    ORA keyTbl + KEY_COLON
    BPL nopress_w
        LDA #LO(DIRECTION_UP)
        JSR k9MoveVertically
    .nopress_w

    \ 'S' or '/' key...
    LDA keyTbl + KEY_S
    ORA keyTbl + KEY_DIVIDE
    BPL nopress_s
        LDA #LO(DIRECTION_DOWN)
        JSR k9MoveVertically
    .nopress_s

    \ 'T' key...
    LDA keyTbl + KEY_T
    BPL nopress_t
        JSR moveSoundToggle
         
        \ wait for key release
        .loop
            LDA #&23
            JSR scanKey
            BMI loop
    .nopress_t

    \ 'A' or 'Z' key...
    LDA keyTbl + KEY_A
    ORA keyTbl + KEY_Z
    BPL nopress_a
        JMP k9MoveLeft \ implicit RTS
    .nopress_a

    \ 'D' or 'X' key...
    LDA keyTbl + KEY_D
    ORA keyTbl + KEY_X
    BPL nopress_d
        JMP k9MoveRight \ implicit RTS
    .nopress_d

    \ 'R' key...
    LDA keyTbl + KEY_R
    BPL nopress_r
        JMP loadLevel \ implicit RTS
    .nopress_r

    \ god mode?
    LDA godMode : BEQ rts_10

    \ replenish health and keys
IF DEBUG_GODMODE_NO_REPLENISH = 0
    LDA #MAX_HEALTH_HI : STA healthHi
    LDA #&FF : STA healthLo
    LDA #MAX_KEY_COUNT : STA keyCount
ENDIF

    \ check reload level keys (1..LEVEL_COUNT)
    LDX #LEVEL_COUNT
    .loop1
        LDA keyTbl + KEY_1 - 1, X
        BPL nopress1
            STX level
            JMP loadLevel \ implicit RTS
        .nopress1
        DEX
        BNE loop1

    \ don't process arrow keys if scroll counter is odd
    LDA scrollCounter : AND #1 : BNE rts_10

    \ arrow keys
    LDX #3
    .loop2
        LDA keyTbl + KEY_UP, X
        BPL nopress2
            LDA directionTbl, X : STA scrollDirection
            LDA #2 : STA scrollCounter
            RTS
        .nopress2
        DEX
        BPL loop2

    RTS    

.directionTbl EQUB LO(DIRECTION_UP), LO(DIRECTION_DOWN), LO(DIRECTION_LEFT), LO(DIRECTION_RIGHT)

IF DEBUG_GODMODE_NO_REPLENISH != 0
    SKIP 12 \ report same number of unsued code/data bytes
ENDIF
}

\
\ draw game objects
\
.drawObjects
{
    \ draw objects, in draw order (except descending objects)
    LDA #0 : STA outerIndex
    .loop
        LDY outerIndex
        LDX objectDrawOrder, Y
        LDA objectState, X : BPL skipDraw \ redraw flag clear?

            \ to avoid rendering artifacts we draw descending elevators and 
            \ their passengers in reverse order
            AND #OBJECT_STATE_FLAGS_DESCENDING : BEQ notDescending

                \ is the object an elevator?
                LDA objectType, X
                AND #OBJECT_TYPE_MASK
                CMP #OBJECT_TYPE_ELEVATOR : BNE skipDraw

                \ get elevator's passenger index
                LDA objectState, X
                AND #ELEVATOR_STATE_PASSENGER_MASK
                PHA \ --> passenger index

                \ draw elevator
                JSR clearRedrawFlag
                JSR drawObject

                \ draw elevator's passenger
                PLA \ <-- passenger index
                TAX
            .notDescending

            \ draw object
            JSR clearRedrawFlag
            JSR drawObject

            \ render enemy health bar
            LDA objectType, X
            AND #OBJECT_TYPE_MASK
            CMP #OBJECT_TYPE_ENEMY : BNE skipDraw
                JSR drawEnemyHealthBar

        .skipDraw

        INC outerIndex 
        LDA outerIndex
        CMP objectCount
        BNE loop

    \ fall through to RTS
}

\
\ common RTS
\
.rts_10
{
    RTS
}

\
\ draw k9's laser
\
.drawLaser
{
    \ if (laserFrameCount == 0) return
    LDA laserFrameCount : BEQ rts_10

    \ decrement laserFrameCount
    DEC laserFrameCount

    \ draw laser on or off
    CMP #LASER_FRAME_COUNT : BNE else
        JMP drawLaserOn \ implicit RTS
    .else
        JMP drawLaserOff \ implicit RTS
}

\
\ update game objects
\
.updateObjects
{
    LDA #0 : STA outerIndex
    .loop
        LDX outerIndex

        \ cache extents
        JSR cacheObjectExtents

        \ JSR (objectFrameCallback, X)
        LDA objectFrameCallbackLo, X : STA jsr_inst+1
        LDA objectFrameCallbackHi, X : STA jsr_inst+2
        .jsr_inst JSR &0000

        INC outerIndex
        LDA outerIndex
        CMP objectCount
        BNE loop

    RTS
}

\
\ getObjectDirection(X register)
\
\ params:
\   X register   Object index
\
\ returns:
\  accumulator   -1 (left), 0 (none), 1 (right)
\  Y register    0 (ANIMATE_LOOK_LEFT) .. 5 (ANIMATE_TURN_RIGHT_TO_LEFT)
\
.getObjectDirection
{
    LDA objectType, X

.^getObjectDirectionInternal \ invoked from getK9Direction (k9.6502)
    AND #ANIMATE_MASK
    LSR A : LSR A
    TAY
    LDA objectDirectionTbl, Y
    RTS

.objectDirectionTbl
    EQUB LO(-1), 1
    EQUB LO(-1), 1
    EQUB 0, 0
}

\
\ cacheObjectExtents(X register)
\
\ cache object's width, widthMinusOne, height, and heightMinusOne
\
\ params:
\   X register   Object index
\
.cacheObjectExtents
{
    LDA objectType, X
    AND #OBJECT_TYPE_MASK
    TAY

    LDA objectTypeWidths, Y
    STA width
    SEC 
    SBC #1
    STA widthMinusOne

    LDA objectTypeHeights, Y
    STA height
    SBC #1
    STA heightMinusOne

    RTS

.objectTypeWidths
    EQUB K9_SPRITE_WIDTH, ENEMY_SPRITE_WIDTH, ELEVATOR_SPRITE_WIDTH, DOOR_SPRITE_WIDTH

.objectTypeHeights
    EQUB K9_SPRITE_HEIGHT, ENEMY_SPRITE_HEIGHT, ELEVATOR_SPRITE_HEIGHT, DOOR_SPRITE_HEIGHT

}

\
\ refreshObjectDrawOrder()
\
\ resort the objectDrawOrder array every 32 frames, using a bubble sort
\
.refreshObjectDrawOrder
{
    \ update every 32 frames, offset by 8, but not if a sample is being played
    LDA frameCount
    AND #&1F
    EOR #8
    ORA playingSample
    BNE rts_10

    \ fall through to sortObjectDrawOrder
}

\
\ sortObjectDrawOrder()
\
\ Sorts the objectDrawOrder array using a bubble sort
\
.sortObjectDrawOrder
{
    \ outerCount = objectCount
    LDA objectCount : STA outerCount

    .outerLoop
        \ innerCount, count = 1
        LDA #1
        STA count
        STA innerCount

        .innerLoop

            \ X, Y = adjacent object indices
            LDY innerCount
            LDX objectDrawOrder-1, Y
            LDA objectDrawOrder, Y  
            TAY

            \ if (objectY[X] > object[Y]) swap
            LDA objectYLo, Y
            CMP objectYLo, X
            LDA objectYHi, Y
            SBC objectYHi, X
            BCS noswap

                \ swap adjacent indices
                TYA
                LDY innerCount
                STA objectDrawOrder-1, Y
                TXA
                STA objectDrawOrder, Y

                \ count = innerCount
                STY count

            .noswap

            \ innerCount++
            INC innerCount

            \ loop while innerCount < outerCount
            LDA innerCount
            CMP outerCount
            BNE innerLoop

        \ outerCount = count
        LDA count : STA outerCount

        \ loop while outerCount != 1
        CMP #1
        BNE outerLoop

    RTS
}

\
\ inflictK9Damage()
\
\ inflict damange on K9
\
\ k9DamageCounter is used to create two black flashes, followed by a one second pause
\
.inflictK9Damage
{
    \ process every 16 frames, offset by 6
    LDA frameCount
    AND #&F
    CMP #6
    BNE rts_0

    \ if (damageCounter == 0) return
    LDY k9DamageCounter
    BEQ rts_0

    \ decrement damage counter
    DEC k9DamageCounter

    \ if (damageCounter <= K9_DAMAGE_OFF_COUNTER) return
    CPY #(K9_DAMAGE_OFF_COUNTER + 1)
    BCC rts_0

    \ if the pursuit sound effect counter is zero (because no enemies are in pursuit), just restore the palette
    LDA pursuitSoundEffectCounter : BEQ restorePalette

    \ sound exterminate in the pause, and not before
    LDA #18 : STA pursuitSoundEffectCounter

    \ inflict damage on K9
    LDA healthLo
    SBC enemyWeaponStrengthLo \ carry flag set above
    STA healthLo
    LDA healthHi
    SBC enemyWeaponStrengthHi
    STA healthHi

    \ if (health <= 0) invoke level incomplete experience
    BEQ levelIncomplete \ implicit RTS
    BCC levelIncomplete \ implicit RTS

    \ toggle palettes and play sound effect
    TYA \ <-- k9DamageCounter (before decrement)
    AND #1
    BNE restorePalette
        JSR setBlackPalette
        JMP (primarySoundVector_weaponFired) \ implicit RTS
    .restorePalette
        JMP setLevelPalette \ implicit RTS
}

\
\ frameCallback_IntermittentRedraw(X register)
\
\ frame callback that sets the redraw flag every 8 frames, offset by the object index
\
\ the redraw flags is not set for disabled elevators, teleports, and doors
\
\ returns:
\   none-zero if no further processing should occur
\
\ params:
\   X register   Object index
\
.frameCallback_IntermittentRedraw
{
    TXA
    CLC
    ADC frameCount
    AND #7
    BNE rts_0

    \ don't set the redraw flag for disabled elevators, teleports, and doors
    CPX enemyCount : BCC endif : BEQ endif 
        LDA objectState, X
        AND #OBJECT_STATE_FLAGS_DISABLED
        BNE rts_0
    .endif

    \ fall through to set redraw flag, returning zero
}

\
\ setRedrawFlag(X register)
\
\ always returns zero, denoting success
\
\ params:
\   X register   Object index 
\
.setRedrawFlag
{
    LDA objectState, X
    ORA #OBJECT_STATE_FLAGS_REDRAW
    STA objectState, X

    LDA #0 \ return success

    \ fall through to RTS
}

\
\ common RTS
\
.rts_0
{
    RTS
}

\
\ clearRedrawFlag(X register)
\
\ params:
\   X register   Object index 
\
.clearRedrawFlag
{
    LDA objectState, X
    AND #LO(NOT(OBJECT_STATE_FLAGS_REDRAW))
    STA objectState, X
    RTS
}

\
\ frameCallback_MoveHorz(A,Y)
\
\ set keyframe, set redraw, continue animation? (carry set), and accumulator = objectXLo[X] AND &F
\
\ params:
\   Accumulator SPRITE_INDEX_K9_LEFT, SPRITE_INDEX_K9_RIGHT, SPRITE_INDEX_ENEMY_LEFT or SPRITE_INDEX_ENEMY_RIGHT
\   X register  Object index
\
\ modifies:
\   temp, Y
\
.frameCallback_MoveHorz
{
    STA temp

    \ set keyframe
    LDA objectXLo, X
    TAY \ --> objectXLo, X
    AND #3
    CLC
    ADC temp \ SPRITE_INDEX_K9_LEFT ...
    STA objectSpriteIndex, X

    \ set redraw flag
    JSR setRedrawFlag

    \ continue animation?
    TYA \ <-- objectXLo, X
    AND #3
    BNE failure

    \ accumulator = objectXLo[X] & 0xF
    TYA \ <-- objectXLo, X
    AND #&F
    RTS

    .failure
    SEC
    RTS
}

\
\ roundFourObjectPosition(X register, flags)
\
\ round an object's horizontal position to the nearst multiple of four, clearing
\ the right tile's flags if it was vacated. Code assumes the object is 24 pixels wide.
\
\ params:
\   X register   Object index 
\   flags        Tile grid flags to clear vacated tile flags
\
.roundFourObjectPosition
{
    \ round object's X coord to nearest multiple of four, remembering previous value
    LDA objectXLo, X
    STA temp
    AND #&FC
    STA objectXLo, X

    \ clear vacated tile flags (if position was the 9th, 10th, or 11th pixel in a tile)
    LDA temp
    AND #&F
    CMP #9 : BCC rts_0
    CMP #12 : BCS rts_0
    JMP clearObjectRightTileFlags \ implicit RTS
}

\
\ levelEndPreamble()
\ 
.levelEndPreamble
{
    \ silence sound effects
    JSR silenceSoundEffects

    \ crop close transition
    JSR cropCloseTransition

    \ wait for v-sync
    JSR waitForVSync

    \ set palette black
    JMP setBlackPalette \ implicit RTS
}

\
\ levelIncomplete()
\
.levelIncomplete
{
    \ common preamble
    JSR levelEndPreamble

    \ reload current level
    JSR loadCurrentLevelFile

    \ show 'battery flat' experience
    JMP showBatteryFlatScreen  \ implicit RTS
}

\
\ levelComplete()
\
.levelComplete
{
    \ common preamble
    JSR levelEndPreamble

    \ game completed?
    LDA level
    EOR #LEVEL_COUNT
    BEQ gameComplete

    \ load next level
    INC level
    JSR loadCurrentLevelFile

    \ show level complete experience
    JMP showLevelCompletedScreen \ implicit RTS
}

\
\ loadLevel()
\
\ loads the current level
\
.loadLevel
{
    \ return if a crop transition is in progress
    LDA transitionState : BNE rts_0

    \ common preamble
    JSR levelEndPreamble

    \ load current level file
    JSR loadCurrentLevelFile

    \ initialize level
    JMP initializeLevel \ implicit RTS
}

\
\ game completed
\
.gameComplete
{
    \ load finale experience (A = 0)
    JSR loadLevelFile

    \ invoke final experience
    JMP finale \ implicit RTS    
}

\
\ loadCurrentLevelFile()
\
\ Loads a the current level file
\
.loadCurrentLevelFile
{
    \ update filename level number
    LDA level

    \ fall through to loadLevelFile
}

\
\ loadLevelFile(level)
\
\ params:
\   accumalator     1..9, or 0 = finale experience
\
ASSERT (HI(P%) > &1C) \ ensure loadLevelFile is assembled after page &17 and &1C

.loadLevelFile
{
    \ patch level number in file name
    CLC
    ADC #'0'
    STA cmdLoadLevel+10

    \ switch to DFS
    JSR selectDFS

    \ execute command
    LDX #LO(cmdLoadLevel)
    LDY #HI(cmdLoadLevel)
    JSR oscli

    \ release DFS
    JMP releaseDFS

.cmdLoadLevel
    EQUS "LOAD levelX", 13
}

\
\ selectDFS
\
\ select DFS file-system
\
ASSERT (HI(P%) > &1C) \ ensure selectDFS is assembled after page &17 and &1C

.selectDFS
{
    \ backup and clear page &17 or &1C, which DFS uses
    LDX #0
    .loop
        .^selectDFS_lda_inst
        LDA &FF00, X \ address patched in initializeDFSRoutines routine (titles.6502)
        STA dfsPageBackup, X
        LDA #0
        .^selectDFS_sta_inst
        STA &FF00, X \ address patched in initializeDFSRoutines routine (titles.6502)
        INX
        BNE loop

    \ select DFS file system
    LDX #LO(cmdDISK)
    LDY #HI(cmdDISK)
    JMP oscli \ implicit RTS

.cmdDISK
    EQUS "DISK", 13
}

\
\ releaseDFS
\
\ release DFS file-system
\
ASSERT (HI(P%) > &1C) \ ensure selectDFS is assembled after page &17 and &1C

.releaseDFS
{
    \ restore page &17 or &1C, which DFS uses
    LDX #0
    .loop
        LDA dfsPageBackup, X
        .^releaseDFS_sta_inst
        STA &FF00, X \ address patched in initializeDFSRoutines routine (titles.6502)
        INX
        BNE loop
    RTS
}

.lastCodeAddr \ last code address

\
\ reserve space for level data (populated during level initialization)
\
ORG k9Atlas3
SKIP (levelLoadAddr - k9Atlas3)

\
\ load sample.6502 where the gamebar atlas normally resides. On machines with 
\ sideways RAM (16K or 32K) this is used to play samples, and the gamebar
\ atlas is instead located at gamebarAtlas_sidewaysRAM
\
CLEAR gamebarAtlas, gamebarAtlas + GAMEBAR_SPRITE_SIZE

ORG gamebarAtlas
INCLUDE "sample.6502"

\
\ embed 'level1' in binary (replaced on level load/reload)
\
ORG levelLoadAddr
INCBIN "data\level1.dat" \ level data (palette, tile types, tiles, tile grid etc)

.levelSpriteDataLoaded
INCBIN "data\level1.atl" \ level atlas sprite data (enemies, elevators, doors)

.levelCode
INCLUDE "level.6502" \ packaged level code

\
\ common mode 7 code (used by titles.6502, interstitial6502, and finale.6502)
\
.modeSevenCode
INCLUDE "mode7.6502" \ packaged mode 7 code

\
\ code executed during startup
\
INCLUDE "titles.6502"
INCLUDE "music.6502"

\ guard PCM data load buffer through &7FFF
FOR addr, pcmDataLoadBuffer, &7FFF
    GUARD addr
NEXT

.end

\
\ program --> SSD
\
SAVE "program", start, end

\
\ finale --> SSD
\

\INCLUDE "mode7.6502"   \ packaged Mode 7 code (INCLUDE statement unnecessary)
CLEAR titles, titlesEnd
ORG titles
INCLUDE "finale.6502"   \ replace titles code with finale code
\INCLUDE "music.6502"   \ packaged music code and data (INCLUDE statement unnecessary)

SAVE "level0", modeSevenCode, end

\
\ primary pcm data --> SSD 
\
ORG &8000
INCBIN "data\pcm_primary.dat"

SAVE "pcmP1", &8000 + (0 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (1 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmP2", &8000 + (1 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (2 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmP3", &8000 + (2 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (3 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmP4", &8000 + (3 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (4 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmP5", &8000 + (4 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (5 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer

\
\ secondary pcm data --> SSD 
\
CLEAR &8000, &CF00
ORG &8000
INCBIN "data\pcm_secondary.dat"

SAVE "pcmS1", &8000 + (0 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (1 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmS2", &8000 + (1 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (2 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmS3", &8000 + (2 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (3 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmS4", &8000 + (3 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (4 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer
SAVE "pcmS5", &8000 + (4 * PCM_DATA_LOAD_BUFFER_SIZE), &8000 + (5 * PCM_DATA_LOAD_BUFFER_SIZE), pcmDataLoadBuffer, pcmDataLoadBuffer

\
\ Level 1..N
\
CLEAR titles, titlesEnd
ORG titles
INCLUDE "interstitial.6502"     \ replace titles code with interstitial code
.levelEnd

\
\ level 1 --> SSD
\
CLEAR levelLoadAddr, levelCode

ORG levelLoadAddr
INCBIN "data\level1.dat"       \ level data (palette, tile grid, tiles etc)
INCBIN "data\level1.atl"       \ level atlas sprite data (enemies, elevators, doors etc)
\INCLUDE "level.6502"           \ packaged level code (INCLUDE statement unnecessary)
\INCLUDE "mode7.6502"           \ packaged mode 7 code (INCLUDE statement unnecessary)
\INCLUDE "interstitial.6502"    \ packaged interstitial experiences (INCLUDE statement unnecessary)

SAVE "level1", levelLoadAddr, levelEnd

\
\ level 2 --> SSD
\
CLEAR levelLoadAddr, levelCode

ORG levelLoadAddr
INCBIN "data\level2.dat"       \ level data (palette, tile grid, tiles etc)
INCBIN "data\level2.atl"       \ level atlas sprite data (enemies, elevators, doors etc)
\INCLUDE "level.6502"           \ packaged level code (INCLUDE statement unnecessary)
\INCLUDE "mode7.6502"           \ packaged mode 7 code (INCLUDE statement unnecessary)
\INCLUDE "interstitial.6502"    \ packaged interstitial experiences (INCLUDE statement unnecessary)

SAVE "level2", levelLoadAddr, levelEnd

\
\ level 3 --> SSD
\
CLEAR levelLoadAddr, levelCode

ORG levelLoadAddr
INCBIN "data\level3.dat"       \ level data (palette, tile grid, tiles etc)
INCBIN "data\level3.atl"       \ level atlas sprite data (enemies, elevators, doors etc)
\INCLUDE "level.6502"           \ packaged level code (INCLUDE statement unnecessary)
\INCLUDE "mode7.6502"           \ packaged mode 7 code (INCLUDE statement unnecessary)
\INCLUDE "interstitial.6502"    \ packaged interstitial experiences (INCLUDE statement unnecessary)

SAVE "level3", levelLoadAddr, levelEnd

\
\ level 4 --> SSD
\
CLEAR levelLoadAddr, levelCode

ORG levelLoadAddr
INCBIN "data\level4.dat"       \ level data (palette, tile grid, tiles etc)
INCBIN "data\level4.atl"       \ level atlas sprite data (enemies, elevators, doors etc)
\INCLUDE "level.6502"           \ packaged level code (INCLUDE statement unnecessary)
\INCLUDE "mode7.6502"           \ packaged mode 7 code (INCLUDE statement unnecessary)
\INCLUDE "interstitial.6502"    \ packaged interstitial experiences (INCLUDE statement unnecessary)

SAVE "level4", levelLoadAddr, levelEnd

\
\ level 5 --> SSD
\
CLEAR levelLoadAddr, levelCode

ORG levelLoadAddr
INCBIN "data\level5.dat"       \ level data (palette, tile grid, tiles etc)
INCBIN "data\level5.atl"       \ level atlas sprite data (enemies, elevators, doors etc)
\INCLUDE "level.6502"           \ packaged level code (INCLUDE statement unnecessary)
\INCLUDE "mode7.6502"           \ packaged mode 7 code (INCLUDE statement unnecessary)
\INCLUDE "interstitial.6502"    \ packaged interstitial experiences (INCLUDE statement unnecessary)

SAVE "level5", levelLoadAddr, levelEnd

\
\ level 6 --> SSD
\
CLEAR levelLoadAddr, levelCode

ORG levelLoadAddr
INCBIN "data\level6.dat"       \ level data (palette, tile grid, tiles etc)
INCBIN "data\level6.atl"       \ level atlas sprite data (enemies, elevators, doors etc)
\INCLUDE "level.6502"           \ packaged level code (INCLUDE statement unnecessary)
\INCLUDE "mode7.6502"           \ packaged mode 7 code (INCLUDE statement unnecessary)
\INCLUDE "interstitial.6502"    \ packaged interstitial experiences (INCLUDE statement unnecessary)

SAVE "level6", levelLoadAddr, levelEnd

\
