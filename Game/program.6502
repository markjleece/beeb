SPRITE_INDEX_K9_LEFT = 19    \ 19..22
SPRITE_INDEX_K9_RIGHT = 23   \ 23..26
SPRITE_INDEX_K9_TURN = 27    \ 27..29
SPRITE_INDEX_GAMEBAR = 30    \ 30

