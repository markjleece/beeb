\
\ draw routines
\ 

\
\ debugTileGridFlags()
\
\ modifies:
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.debugTileGridFlags
{
IF DEBUG_TILE_GRID_FLAGS = 0
    RTS
ELSE
    \ calc screen address and tileGridAddr of top-left fully visible tile
    LDA #15 : STA topLo : STA leftLo
    JSR getTileScreenAddr
    JSR getScreenTileGridAddr

    LDA #0 : STA outerIndex
    .outerLoop

        LDA #0 : STA index

        .innerLoop
            \ render flags
            LDY index
            LDA (tileGridAddr), Y
            STA temp
            LDX #3
            LDY #0
            .loop
                ASL temp
                LDA #&FF
                BCC flagNotSet
                    LDA #&99
                .flagNotSet
                STA (dstAddr), Y
                INY
                DEX
                BNE loop

            \ dstAddr += 32
            LDA #32
            JSR dstAddr_add

            \ index += 1
            INC index

            \ loop?
            LDA index
            CMP #16
            BNE innerLoop

        \ dstAddr += 512
        JSR dstAddr_add_512 

        \ tileGridAddr += horzTileCount
        JSR tileGridAddr_add_horzTileCount

        \ count += 1
        INC outerIndex

        \ loop?
        LDA outerIndex
        CMP #16
        BNE outerLoop

    RTS

    SKIP 147 \ report same number of unsued code/data bytes
ENDIF
}

\
\ drawGameBar()
\
.drawGameBar    
{
IF DEBUG_TILE_GRID_FLAGS != 1
    RTS
ELSE
    \ dstAddr = scrnAddr + 384
    LDX #LO(384)
    LDY #HI(384)
    JSR calcScreenDstAddrOffset

    \ srcBaseAddr, srcAddr = spriteAddrTbl[SPRITE_INDEX_GAMEBAR]
    LDA spriteAddrTblLo + SPRITE_INDEX_GAMEBAR
    STA srcBaseAddr
    STA srcAddr
    STA inst_LDA+1 \ set LDA instruction operand (low-byte) in drawDigit
    
    LDA spriteAddrTblHi + SPRITE_INDEX_GAMEBAR
    STA srcBaseAddr+1
    STA srcAddr+1
    STA inst_LDA+2 \ set LDA instruction operand (high-byte) in drawDigit

    \ draw level icon
    LDA #16
    JSR copyBytes

    \
    \ draw level number
    \
    LDA level
    JSR drawDigit

    \ draw heart icon
    LDA #16
    JSR copyBytes

    LDA #8
    JSR copyBytes

    \
    \ draw health bar
    \

    \ 'XOR mask' (flags) = (keyColor == foreground) ? &FF : 0
    LDY #59
    LDA (srcBaseAddr), Y \ peek key color
    ASL A
    LDX #0
    BCC skip2
        DEX \ X = &FF
    .skip2
    STX flags \ <-- XOR mask

    \ 'OR mask' (temp) = (heathHi < 5) ? (&F ^ XOR mask) : 0
    LDA healthHi
    CMP #5
    LDA #0
    BCS skip1
        LDA #&0F
        EOR flags
    .skip1
    STA temp \ <-- OR mask

    \ offset, count = 4
    LDA #4
    STA offset
    STA count

    .healthBarLoop
        LDY #0

        \ render header
        LDA (srcBaseAddr), Y
        STA (dstAddr), Y : INY
        STA (dstAddr), Y : INY

        \ render bar (in foreground/background colors)
        LDA offset \ if (offset - healthHi <= 0)
        SEC
        SBC healthHi : BEQ then : BPL else
        .then
            LDA #0 \ background
            BEQ endif
        .else
            CMP #4 : BPL else2 \ if (offset - healthHi < 4)
            LDA healthHi
            AND #3
            TAX
            LDA lineTbl, X \ foreground/background
            BNE endif
        .else2
            LDA #&FF \ foreground
        .endif

        ORA temp  \ apply OR mask
        EOR flags \ apply XOR mask

        LDX #4
        .innerLoop
            STA (dstAddr), Y : INY
            DEX
            BNE innerLoop

        \ render footer
        INY
        LDA (srcBaseAddr), Y
        DEY
        STA (dstAddr), Y : INY
        STA (dstAddr), Y

        \ dstAddr += 8 (with wraparound)
        JSR dstAddr_add_8

        \ offset += 4
        LDA offset
        CLC
        ADC #4
        STA offset

        \ loop?
        DEC count
        LDA count
        BNE healthBarLoop

    \ draw key icon
    LDA #8
    JSR copyBytes

    LDA #16
    JSR copyBytes

    \ draw key count
    LDA keyCount

    \ fall through to drawDigit

.drawDigit
    ASL A : ASL A : ASL A : ASL A \ MUL 16
    CLC
    ADC #(64+15)
    TAX
    LDY #15
    .digitLoop
        .inst_LDA LDA &FFFF, X : DEX
        STA (dstAddr), Y : DEY
        BPL digitLoop

    LDA #16    
    JMP dstAddr_add \ implicit RTS

.copyBytes
    TAX : TAY

    \ copy bytes
    DEY
    .loop
        LDA (srcAddr), Y : STA (dstAddr), Y : DEY
        BPL loop

    \ srcAddr += X
    TXA
    CLC
    ADC srcAddr
    STA srcAddr
    BCC noCarry
        INC srcAddr+1
    .noCarry

    \ dstAddr += X (with wraparound)
    TXA
    JMP dstAddr_add \ implicit RTS

.lineTbl EQUB %11111111, %01110111, %00110011, %00010001

ENDIF
}

\
\ drawTileBackground()
\
\ draw tile background (reusing scrolling code)
\
.drawTileBackground
{
    .loop

        \ scrnLeft -= 8, scrnAddr -= 16 
        JSR scrollLeftUpdateVariables

        \ draw vertical tile strip
        LDA #LO(DIRECTION_LEFT) : STA scrollDirection
        JSR drawVertTileScrollStrip
        
        LDA scrnLeftLo
        BNE loop

    \ update hardware
    JSR waitForVSync
    JMP updateScreenPosition \ implicit RTS
}

\
\ getTileSrcAddr(tileGridAddr, offset)
\
\ get tile source address
\
\ returns:
\   srcAddr         Tile data source address
\   Accumulator     Zero if blank tile rendered, otherwise non-zero
\
\ params:
\   tileGridAddr    Tile grid address
\   offset          Source offset
\
.getTileSrcAddr
{
    \ 'tileIndex' = *tileGridAddr & TILE_GRID_INDEX_MASK
    LDY #0
    LDA (tileGridAddr), Y
    AND #TILE_GRID_INDEX_MASK
    BEQ blankTile
        \ srcAddr = tiles - 64 + (64 * 'tileIndex') + offset
        TAY
        LDA tileAddrTblLo, Y
        CLC
        ADC offset
        STA srcAddr

        LDA tileAddrTblHi, Y
        BNE skip
    .blankTile
        \ srcAddr = zeroMemory32
        ASSERT(LO(zeroMemory32) == 0 AND HI(zeroMemory32) == 0)
        STA srcAddr
    .skip
    STA srcAddr+1

    RTS
}

\
\ drawHorzTileScrollStrip(scrollDirection)
\
\ draws a horizontal tile strip across either the top or bottom edges of the screen
\
\ params:
\   scrollDirection   DIRECTION_DOWN | DIRECTION_UP
\
\ modifies: 
\   dstAddr, srcAddr, offset, temp
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.drawHorzTileScrollStrip
{
    \ leftLo = 0
    \ topLo = scroll-down ? 248 : 0
    \ X/Y = LO/HI(scroll-down ? 31*512 : 0)
    LDA #0 : STA leftLo
    TAX : TAY
    BIT scrollDirection : BMI skip
        LDA #248
        LDY #HI(31*512)
    .skip
    STA topLo

    \ offset = 0 | 32
    CLC
    ADC scrnTopLo
    AND #8
    ASL A : ASL A
    STA offset
     
    \ dstAddr = scrnAddr + X/Y
    JSR calcScreenDstAddrOffset

    \ get tile grid address at [leftLo, topLo]
    JSR getScreenTileGridAddr

    LDX #16
    .loop
        \ shift rendering to below gamebar (one character below)
        CPX #4 : BNE skip1
        BIT scrollDirection : BPL skip1
            LDA offset : BEQ else_1
                \ tileGridAddr += horzTileCount
                JSR tileGridAddr_add_horzTileCount

                \ offset = 0
                LDA #0
                BEQ endif_1
            .else_1
                \ offset = 32
                LDA #32
            .endif_1
            STA offset

            \ dstAddr += 512
            JSR dstAddr_add_512 
        .skip1  

        \ get tile source address (srcAddr)
        JSR getTileSrcAddr

        \ draw tile character row
        LDY #31
        .innerLoop1
            LDA (srcAddr),Y : STA (dstAddr),Y: DEY
            BPL innerLoop1
             
        \ dstAddr += 32
        LDA #32
        JSR dstAddr_add

        \ tileGridAddr++
        INC tileGridAddr
        BNE nocarry3
            INC tileGridAddr+1
        .nocarry3
        
        \ loop?
        DEX
        BNE loop
        
    RTS
}

\
\ calcVertTileStripStart
\
\ calculates the tile tile source address and offset, and the screen destination address
\ 
\ params:
\   leftLo, topLo       Screen coords
\   X/Y registers       Screen address offset (hi/lo bytes) 
\
.calcVertTileStripStart
{
    \ offset = 0 | 16
    LDA leftLo
    CLC
    ADC scrnLeftLo
    AND #8
    ASL A
    STA offset

    \ dstAddr = scrnAddr + X/Y
    JSR calcScreenDstAddrOffset

    \ get grid tile address at [leftLo, topLo]
    JMP getScreenTileGridAddr \ implicit RTS
}

\
\ drawVertTileScrollStrip(scrollDirection)
\
\ draws a vertical tile strip down either the left or right edges of the screen
\
\ params:
\   scrollDirection  DIRECTION_RIGHT | DIRECTION_LEFT
\
\ modifies: 
\   self: dstAddr, srcAddr, outerCount, offset
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.drawVertTileScrollStrip
{
    \ topLo = 0
    \ leftLo = scroll-right ? 248 : 0
    \ X/Y = LO/HI(scroll-right ? 512-16 : 0)
    LDA #0 : STA topLo
    TAX : TAY
    BIT scrollDirection : BMI skip1
        LDA #248
        LDX #LO(512-16)
        LDY #HI(512-16)
    .skip1
    STA leftLo
    
    \ calc srcAddr, dstAddr, and offset
    JSR calcVertTileStripStart

    LDA #16 : STA outerCount
    .loop
        \ get tile source address (srcAddr)
        JSR getTileSrcAddr

        \ stride = 0 or 32
        BEQ skip2
            LDA #32
        .skip2
        STA stride 

        \ draw tile character column
        LDX #2

        \ skip first character if scrolling right
        LDA outerCount : CMP #16 : BNE skip3
            BIT scrollDirection : BPL skipFirstCharacter
        .skip3

        \ draw two tile characters, one above the other
        .innerLoop1
            LDY #15
            .innermostLoop1
                LDA (srcAddr),Y : STA (dstAddr),Y: DEY
                BPL innermostLoop1

            .skipFirstCharacter

            \ dstAddr += 512
            JSR dstAddr_add_512 

            \ srcAddr += stide
            LDA srcAddr
            ADC stride
            STA srcAddr

            \ loop ?
            DEX
            BNE innerLoop1

        \ tileGridAddr += horzTileCount
        JSR tileGridAddr_add_horzTileCount

        \ loop ?
        DEC outerCount
        BNE loop

    RTS
}

\
\ drawTileLeftOfGamebar()
\
\ draws the tile character positioned left of the gamebar
\
\ modifies: 
\   self: dstAddr, srcAddr, outerCount, count, offset
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.drawTileLeftOfGamebar
{
    \ X/Y = LO/HI(512-9*16)
    LDX #LO(512-9*16)
    LDY #HI(512-9*16)

    \ leftLo = 256-9*8, topLo = 0
    LDA #0 : STA topLo
    LDA #LO(256-9*8) : STA leftLo

    \ calc srcAddr, dstAddr, and offset
    JSR calcVertTileStripStart

    \ get tile source address (srcAddr, offset)
    JSR getTileSrcAddr

    \ draw tile character column
    LDY #15
    .loop
        LDA (srcAddr),Y : STA (dstAddr),Y: DEY
        BPL loop

    RTS
}

\
\ getTileScreenAddr(leftLo, topLo)
\
\ get the screen address (dstAddr) of a tile at screen location [leftLo, topLo]. The
\ coordinates must lie within the visible screen but can lie anywhere within the tile.
\
\ params:
\   leftLo      Screen X coordinate (0..255)
\   topLo       Screen Y coordinate (0..255)
\
\ modifies: 
\   dstAddr
\
.getTileScreenAddr
{
    \ dstAddr = scrnAddr + (ROUND16(scrnTopLo + topLo) - scrnTopLo) / 8 * 512
    LDA scrnTopLo
    CLC
    ADC topLo
    AND #&F0 \ ROUND16
    SEC
    SBC scrnTopLo
    AND #&F8 \ / 8 * 512
    LSR A : LSR A
    CLC
    ADC scrnAddr+1
    STA dstAddr+1

    \ dstAddr += (ROUND16(scrnLeftLo + leftLo) - scrnLeftLo) / 4 * 8
    LDA scrnLeftLo
    CLC
    ADC leftLo
    AND #&F0 \ ROUND16
    SEC
    SBC scrnLeftLo
    AND #&FC \ / 4 * 8
    ASL A
    BCC nocarry3
        INC dstAddr+1
    .nocarry3

    CLC
    ADC scrnAddr
    STA dstAddr
    BCC nocarry4
        INC dstAddr+1
    .nocarry4

    \ if (dstAddr > 0x8000) dstAddr -= 0x4000
    LDA dstAddr+1
    BPL nowrap1
        SEC
        SBC #&40
        STA dstAddr+1
    .nowrap1

    RTS
}

\
\ drawTile(Accumulator, leftLo, topLo)
\
\ draws a tile at screen location [leftLo, topLo]. The coordinates must lie
\ within the visible screen but can lie anywhere within the tile.
\
\ params:
\   leftLo      Screen X coordinate (0..255)
\   topLo       Screen Y coordinate (0..255)
\
\ modifies: 
\   dstAddr, srcAddr, leftLo, topLo, stride
\
.drawTile
{
    STA index \ --> lasered

    \ get tile grid address at leftLo, topLo
    JSR getScreenTileGridAddr

    \ get screen address of tile
    JSR getTileScreenAddr

    \ get tile src address
    LDA #0 : STA offset
    JSR getTileSrcAddr
    
    \ stride = 0 or 32
    BEQ skip1
        LDA #32
    .skip1
    STA stride 

    \ update code to render regular or lasered
    LDA #LO(innerLoop_regular)
    BIT index : BPL skip2
        LDA #LO(innerLoop_lasered)
    .skip2
    STA innerLoop+1

    LDA #HI(innerLoop_regular)
    BIT index : BPL skip3
        LDA #HI(innerLoop_lasered)
    .skip3
    STA innerLoop+2

    \ draw upper character row
    LDX #2
    .outerLoop

        \ draw character row
        LDY #31
        .innerLoop JSR &FFFF

        \ terminate loop?
        DEX
        BEQ return

        \ srcAddr += stride
        LDA srcAddr
        CLC
        ADC stride
        STA srcAddr
        BCC nocarry
            INC srcAddr+1
        .nocarry

        \ dstAddr += 512
        JSR dstAddr_add_512

        BNE outerLoop

    .return
    RTS

.innerLoop_regular
    .innerLoop1
        LDA (srcAddr), Y
        STA (dstAddr), Y
        DEY
        BPL innerLoop1
    RTS

.innerLoop_lasered
    .innerLoop2
        LDA (srcAddr), Y
        STA flags
        LSR A : LSR A : LSR A : LSR A
        AND flags
        STA (dstAddr), Y
        DEY
        BPL innerLoop2
    RTS
}

\
\ laserHitTest(leftLo, topLo)
\
\ params:
\   leftLo, topLo   Screen coordinates
\
.laserHitTest
{
    \ get tile grid index and flags at: leftLo, topLo
    JSR getScreenTileGridAddr
    LDY #0
    LDA (tileGridAddr), Y
    TAY \ --> index & flags 

    \ hit enemy?
    AND #TILE_GRID_FLAGS_ENEMY : BEQ skip1
        JMP enemyLaserHitTest \ implicit RTS
    .skip1

    \ get tile type
    TYA \ <-- index & flags 
    AND #TILE_GRID_INDEX_MASK
    TAY
    LDA levelTileTypes, Y

    \ hit destructible wall?
    LDY #0
    CMP #TILE_TYPE_DESTRUCTIBLE_WALL : BEQ laseredTileHit

    \ hit off-switch?
    LDY switchOnTileIndex
    CMP #TILE_TYPE_SWITCH_OFF : BEQ laseredTileHit

    RTS
}

\
\ laseredTileHit(leftLo, topLo, tileGridAddr, Y register)
\
\ params:
\   leftLo, topLo   Screen coordinates
\   tileGridAddr    Tile grid address
\   Y register      New tile index
\
.laseredTileHit
{
    STY index

    \ draw lasered tile
    LDA #LO(-1)
    JSR drawTile

    \ mark for redraw
    INC laseredTileRedraw
   
    \ if (laseredTileTop/Left == top/left) ..
    LDA leftLo : CMP laseredTileLeft : BNE else
    LDA topLo : CMP laseredTileTop : BNE else

        \ if (--laseredTileStrength == 0)
        DEC laseredTileStrength : BNE endif

            \ replace lasered tile with new tile index
            LDA index
            LDY #0
            STA (tileGridAddr), Y

            \ stop laser
            INC laserInhibited
            RTS
    .else
        \ remember tile's position
        LDA leftLo : STA laseredTileLeft
        LDA topLo : STA laseredTileTop

        \ reset tile's strength
        LDA #LASERED_TILE_STRENGTH : STA laseredTileStrength
    .endif

    RTS
}

\
\ switches...
\
.switchOnTileIndex          SKIP 1
.switchOffTileIndex         SKIP 1

\
\ findSwitchIndex(tileGridAddr)
\
\ the switch index is resulted in the X register
\
\ params:
\   tileGridAddr    Tile grid address of switch
\
\ modifies:
\   tileGridAddr
\
.findSwitchIndex
{
    LDX #0
    LDY #0

    .loop
        \ srcAddr--
        LDA tileGridAddr
        BNE skip1
            DEC tileGridAddr+1
        .skip1
        DEC tileGridAddr

        \ if (*tileGridAddr == switchOffTileIndex) 
        LDA (tileGridAddr), Y
        AND #TILE_GRID_INDEX_MASK
        CMP switchOffTileIndex
        BNE skip2
            INX \ found!
        .skip2

        \ loop while tileGridAddr > levelTileGrid
        LDA tileGridAddr+1
        CMP HI(levelTileGrid - 1)
        BNE loop
    .loopEnd

    RTS
}

\
\ activateSwitch(X register)
\
\ activates a switch
\
\ params:
\   X register  Switch index
\
\ modifies:
\
.switchPairings SKIP 32

.activateSwitch
{
    \ skip to switch X
    LDY #0
    BEQ loop1End
    .loop1
        TYA
        ADC switchPairings, Y
        TAY
        INY

        DEX
        BNE loop1
    .loop1End

    INY \ skip over switch byte count

    \ for each paired object
    LDA switchPairings, Y
    INY
    TAX : BEQ loop2End
    .loop2
        \ object Id
        LDA switchPairings, Y
        STA index
        INY

        \ activate object
        JSR activateObject

        DEX
        BNE loop2
    .loop2End

    \ for each paired tile...
    LDA switchPairings, Y
    INY
    TAX : BEQ loopEnd3
    .loop3
        \ tile X
        LDA switchPairings, Y
        STA leftLo
        INY

        \ tile Y
        LDA switchPairings, Y
        STA topLo
        INY

        \ activate tile
        JSR activateTile

        DEX
        BNE loop3
    .loopEnd3

    RTS
}

\
\ activateObject(index)
\
\ params:
\   index     Object index
.activateObject
{
    \ preserve X
    TXA : PHA
    
    LDX index
    LDA objectType, X
    TAY
    AND #OBJECT_TYPE_MASK
    CMP #OBJECT_TYPE_ENEMY : BNE else
        \ if (action == PURSUE_LEFT, PURSUE_RIGHT ...) break
        TYA
        BMI endif

        \ enemy action = 'PACE'
        AND #LO(NOT(ANIMATE_MASK))
        ORA #(ACTION_PACE)
        STA objectType, X

        BNE endif
    .else
        \ clear disabled flag
        LDA objectState, X
        AND #LO(NOT(OBJECT_STATE_FLAGS_DISABLED))
        STA objectState, X
    .endif

    \ restore X
    PLA : TAX
    RTS
}

\
\ activateTile(leftLo, topLo)
\
\ params:
\   leftLo      Tile X position (tile coords)
\   topLo       Tile Y position (tile coords)
\
.activateTile
{
    \ preserve X & Y
    TXA : PHA : TYA : PHA

    \ convert tile coords to level coords
    LDA #0 : STA leftHi : STA topHi
    LDY #4
    .loop
        ASL leftLo : ROL leftHi
        ASL topLo : ROL topHi
        DEY
        BNE loop

    \ convert tile to a space
    JSR getTileGridAddr
    LDA #0
    STA (tileGridAddr), Y

    \ convert coords to screen space
    LDA leftLo
    SEC
    SBC scrnLeftLo
    STA leftLo
    LDA leftHi
    SBC scrnLeftHi
    BNE clipped \ fully clipped

    \ top -= scrnTop
    LDA topLo
    SEC
    SBC scrnTopLo
    STA topLo
    LDA topHi
    SBC scrnTopHi
    BNE clipped \ fully clipped

    \ draw tile
    JSR drawTile

    .clipped

    \ restore X & Y
    PLA : TAY : PLA : TAX
    RTS
}

\
\ drawLaserOn()
\
\ draw laser beem fropm K9's muzzle
\
\ modifies:
\   laserAddr       scrn address of muzzle byte
\   laserMaxLength  max length of laser
\   laserDirection  positive (left to right), negative (right to left)
\   dstAddr         updated across scanlines
\   leftLo          muzzle x screen position
\   topLo           muzzle y screen position
\   temp            leftLo MOD 4
\
.drawLaserOn
{
    \ enough health to use laser?
    LDA healthHi
    CMP #LASER_HEALTH_THRESHOLD_HI
    BCS skip1
        .unableToLaser
        LDA #0 : STA laserFrameCount
        INC laserInhibited
        RTS
    .skip1

    \ laserDirection = -1 (left), 0 (none), 1 (right)
    LDX #0 
    JSR getObjectDirection \ Y = 0 (ANIMATE_LOOK_LEFT) .. 5 (ANIMATE_TURN_RIGHT_TO_LEFT)
    BEQ unableToLaser
    STA laserDirection

    \ calculate K9's muzzle screen position (leftLo, topLo)
    LDA objectYLo
    CLC 
    ADC #6
    SEC
    SBC scrnTopLo
    STA topLo

    AND #7
    STA temp \ --> topLo MOD 8

    LDA objectXLo
    CLC 
    ADC laserOffsetTbl, Y
    SEC
    SBC scrnLeftLo

    \ ensure last two bits of xPos are either clear or set, so (leftLo, poxY) correctly intersests an enemy
    AND #&FC \ clear bits is looking left
    BIT laserDirection : BMI skip2
        ORA #3 \ set bits is looking right
    .skip2
    STA leftLo

    \ laserLength = (leftLo or (&FF - leftLo)) / 4
    BIT laserDirection : BMI skip3
        LDA #&FF
        SEC
        SBC leftLo
    .skip3
    LSR A : LSR A
    STA laserLength

    \ calc screen dstAddr 
    JSR calcScreenDstAddr

    \ dstAddr += topLo MOD 8
    LDA dstAddr
    CLC
    ADC temp
    STA dstAddr

    \ laserAddr = dstAddr
    STA laserAddr
    LDA dstAddr+1 : STA laserAddr+1

    \ drain health
    LDA healthLo
    SEC
    SBC laserHealthDrain
    STA healthLo
    BCS noborrow
        DEC healthHi
    .noborrow

    \ laser sound effect
    JSR laserSoundEffect

    \ populate JSR address with laserUpdateVariablesLeftToRight or laserUpdateVariablesRightToLeft
    LDA #LO(laserUpdateVariablesLeftToRight)
    BIT laserDirection : BPL skip4
        LDA #LO(laserUpdateVariablesRightToLeft)
    .skip4
    STA jsr_inst+1

    LDA #HI(laserUpdateVariablesLeftToRight)
    BIT laserDirection : BPL skip5
        LDA #HI(laserUpdateVariablesRightToLeft)
    .skip5
    STA jsr_inst+2

    \ draw first few pixels
    LDY #0
    LDA (dstAddr), Y
    JSR drawEnd

    \ draw line body...
    LDX #0
    .loop
        \ dstAddr +=/-= 8, leftLo +=/-= 4
        .jsr_inst JSR &FFFF

        \ background color?
        LDA (dstAddr), Y
        STA laserLastPixels
        BEQ skip
            \ draw last few pixels
            STX laserLength
            JSR drawEnd

            \ hit test
            JMP laserHitTest \ implicit RTS
        .skip

        \ draw 4 red pixels
        LDA #&0F
        STA (dstAddr), Y

        INX
        CPX laserLength
        BNE loop

    DEC laserLength
    RTS

.drawEnd
    EOR #&FF
    STA temp
    LSR A : LSR A : LSR A : LSR A
    AND temp
    ORA (dstAddr), Y
    STA (dstAddr), Y
    RTS

.laserOffsetTbl
    EQUB 0, 20 \ look
    EQUB 0, 20 \ move
}

\
\ drawLaserOff()
\
\ modifies:
\   dstAddr, temp
\
.drawLaserOff
{
    \ dstAddr = laserAddr
    LDA laserAddr : STA dstAddr
    LDA laserAddr+1 : STA dstAddr+1

    \ populate JSR address with dstAddr_add_8 or dstAddr_sub_8
    LDA #LO(dstAddr_add_8)
    BIT laserDirection : BPL skip1
        LDA #LO(dstAddr_sub_8)
    .skip1
    STA jsr_inst+1

    LDA #HI(dstAddr_add_8)
    BIT laserDirection : BPL skip2
        LDA #HI(dstAddr_sub_8)
    .skip2
    STA jsr_inst+2

    LDY #0
    LDX #&FF \ clear first few pixels twice

    .first
        \ clear first few pixels (we do this twice because K9 may have moved)
        LDA (dstAddr), Y
        EOR #&F0
        STA temp
        LSR A : LSR A : LSR A : LSR A
        AND temp
        EOR #&FF
        AND (dstAddr), Y
        STA (dstAddr), Y

    .loop
        \ dstAddr +=/-= 8
        .jsr_inst JSR &FFFF

        \ clear first few pixels again?
        DEX
        BPL skip3
            LDX laserLength
            BNE first
        .skip3

        \ restore last few pixels
        BEQ drawEnd

        \ draw 4 white pixels
        TYA
        STA (dstAddr), Y

        BEQ loop

    RTS

.drawEnd
    LDA laseredTileRedraw : BEQ else
        \ redraw lasered tile, clearing redraw flag
        LDA laseredTileLeft : STA leftLo
        LDA laseredTileTop : STA topLo
        LDA #0 : STA laseredTileRedraw
        JMP drawTile \ implicit
    .else
        \ restore last pixels
        LDA laserLastPixels
        STA (dstAddr), Y
    RTS
}

\
\ convertToScreenSpace(left, top, width, height)
\
\ converts level coords to screen coords, performing broad clipping
\
\ returns non-zero if object is fully clipped, otherwise zero
\
\ params:
\   leftLo/Hi       left coordinate (level coords)
\   topLo/Hi        top coordinate (level coords)
\   width           width in pixels
\   height          height in pixels
\   scrnLeftLo/Hi   screen left position (level coords)
\   scrnTopLo/Hi    screen left position (level coords)
\
\ returns:
\   leftLo/Hi       left coordinate (screen coords)
\   topLo/Hi        top coordinate (screen coords)
\   rightLo/Hi      right coordinate (screen coords)
\   bottomLo/Hi     bottom coordinate (screen coords)
\
.convertToScreenSpace
{
    \ left -= scrnLeft
    LDA leftLo
    SEC 
    SBC scrnLeftLo
    STA leftLo
    LDA leftHi
    SBC scrnLeftHi
    BEQ skip_1
    BPL fullyClipped \ if (left > 255)
    .skip_1
    STA leftHi

    \ top -= scrnTop
    LDA topLo
    SEC 
    SBC scrnTopLo
    STA topLo
    LDA topHi
    SBC scrnTopHi
    BEQ skip_2
    BPL fullyClipped \ if (top > 255)
    .skip_2
    STA topHi

    \ right = left + width - 1
    LDA leftLo
    CLC 
    ADC widthMinusOne
    STA rightLo

    LDA leftHi
    ADC #0
    BMI fullyClipped \ if (right < 0)
    STA rightHi

    \ bottom = top + height - 1
    LDA topLo
    CLC
    ADC heightMinusOne
    STA bottomLo

    LDA topHi
    ADC #0
    BMI fullyClipped \ if (bottom < 0)
    STA bottomHi

    \ success!
    LDA #0
    RTS

    .fullyClipped
    LDA #1
    RTS
}

\
\ calcScreenDstAddrOffset(offset)
\
\ dstAddr = scrnAddr + offset
\
\ params:
\   X register  offset (low-byte)
\   Y register  offset (hi-byte)
\
.calcScreenDstAddrOffset
{
    CLC
    TXA \ <-- offset (low-byte)
    ADC scrnAddr
    STA dstAddr
    TYA \ <-- offset (high-byte)
    ADC scrnAddr+1
    BPL nowrap  \ dstAddr >= &8000 ?
        SEC     \ dstAddr -= -&4000
        SBC #&40       
    .nowrap
    STA dstAddr+1
    RTS
}

\
\ calcScreenDstAddr(leftLo, topLo)
\
\ calculate screen address of leftLo, topLo
\
\ params:
\   leftLo   left coordinate (screen coords)
\   topLo    top coordinate (screen coords)
\
\ modifies:
\   dstAddr
\
.calcScreenDstAddr
{
    \ dstAddr = scrnAddr + (top / 8) * 512
    LDA topLo
    AND #&F8
    LSR A : LSR A
    CLC
    ADC scrnAddr+1
    STA dstAddr+1

    \ dstAddr += (left / 4) * 8
    LDA leftLo
    AND #&FC
    ASL A
    BCC nocarry3
        INC dstAddr+1
    .nocarry3

    CLC
    ADC scrnAddr
    STA dstAddr
    BCC nocarry4
        INC dstAddr+1
    .nocarry4

    \ if (dstAddr > 0x8000) dstAddr -= 0x4000
    LDA dstAddr+1
    BPL nowrap1
        SEC
        SBC #&40
        STA dstAddr+1
    .nowrap1

    \ fall through TO RTS
}

\
\ common RTS
\
.rts_5
{
    RTS
}

\
\ drawObject(X register)
\ 
\ draws an object to the screen (clipped if needed).  The routine draws the object column by column. The 
\ scanlines above and below can optionally be erased.
\
\ params:
\   X register      Object index
\
\ modifies:
\   index           sprite index (0..31, -1 = blank)
\   leftLo/Hi       left position (0,3,7,11...)
\   topLo/Hi        top position (0+)
\   rightLo/Hi      right position
\   bottomLo/Hi     bottom position
\   width           sprite width (4,8,12,16...)
\   height          sprite height (1+)
\   stride          stride across sprite data (original height)
\   eraseAbove      erase scanline above (false|true)
\   eraseBelow      erase scanline below (false|true)
\   srcBaseAddr     base address of sprite data (advanced every column)
\   dstBaseAddr     base address of screen (advanced every column)
\   srcAddr         address of sprite data (advanced drawing column)
\   dstAddr         address of screen (advanced drawing column)
\   outerCount      number of columns to draw
\   headCount       number of head loop iterations
\   temp            number of tail iterations
\   count           number of head loop iterations
\   innerCount      number of inner head loop iterations
\   offset          holds topLo MOD 8
\

.drawObject
{
    \ leftLo/Hi = objectXLo/Hi[0] & 0xFFFC
    LDA objectXLo, X : AND #&FC : STA leftLo
    LDA objectXHi, X : STA leftHi

    \ topLo/Hi = objectYLo/Hi[0]
    LDA objectYLo, X : STA topLo
    LDA objectYHi, X : STA topHi

    \ cache extents (width, height, widthMinusOne, heightMinusOne)
    JSR cacheObjectExtents

    \ stride = height
    LDA height : STA stride

    \ expand extents if object is ascending or descending, setting
    \ flags to erase above or below
    LDA objectState, X
    AND #OBJECT_STATE_FLAGS_DESCENDING : BEQ skipExpandAbove
        LDA topLo
        BNE skip_1
            DEC topHi
        .skip_1
        DEC topLo
        INC height
        LDA #1
    .skipExpandAbove
    STA eraseAbove
    
    LDA objectState, X
    AND #OBJECT_STATE_FLAGS_ASCENDING : BEQ skipExpandBelow
        INC height
        LDA #1
    .skipExpandBelow
    STA eraseBelow

    \
    \ convert to screen space (with broard clipping)
    \
    
    JSR convertToScreenSpace
    BNE rts_5

    \
    \ at this point we know we are going to render something
    \

    TXA : PHA \ save X register

    \ srcBaseAddr = spriteAddrTbl[index]
    LDY objectSpriteIndex, X
    STY index \ --> sprite index
    LDA spriteAddrTblLo, Y : STA srcBaseAddr
    LDA spriteAddrTblHi, Y : STA srcBaseAddr+1
    
    LDY #0 \ --> zero

    \ clip left edge?
    LDA leftHi : BPL endif_6
        \ 'clipped width' = 0 - left
        TYA \ <-- zero
        SEC
        SBC leftLo
        STA temp

        \ srcBaseAddr += 'clipped width' / 4 * stride
        LSR A : LSR A
        TAY
        LDA srcBaseAddr
        CLC
        .loop2
            ADC stride
            BCC nocarry5
                INC srcBaseAddr+1
                CLC
            .nocarry5
            DEY
            BNE loop2
        STA srcBaseAddr

        \ width -= 'clipped width'
        LDA width
        SEC
        SBC temp
        STA width

        \ left = 0
        STY leftLo
    .endif_6

    \ clip left edge?
    LDA rightHi : BEQ endif_7

        \ width -= right - 256
        LDA width
        SEC
        SBC rightLo
        SEC
        SBC #1
        STA width
    .endif_7

    \ clip top edge?
    LDA topHi : BPL endif_8
        
        \ 'clipped height' = 0 - top
        TYA \ <-- zero
        SEC
        SBC topLo
        STA temp

        \ srcBaseAddr += ('clipped height' - eraseAbove)
        SEC
        SBC eraseAbove
        CLC
        ADC srcBaseAddr 
        STA srcBaseAddr
        BCC nocarry6
            INC srcBaseAddr+1
        .nocarry6

        \ height -= 'clipped height'
        LDA height
        SEC
        SBC temp
        STA height

        \ top = 0
        STY topLo

        \ eraseAbove = false
        STY eraseAbove
    .endif_8

    \ clip bottom edge?
    LDA bottomHi : BEQ endif_9

        \ height -= bottom - 256
        LDA height
        SEC
        SBC bottomLo
        SEC
        SBC #1
        STA height

        \ eraseBelow = false
        STY eraseBelow
    .endif_9

    \
    \ adjust source base address
    \ 

    \ offset = top % 8 
    LDA topLo
    AND #7
    STA offset

    \ srcBaseAddr -= (top % 8)
    LDA srcBaseAddr
    SEC
    SBC offset \ (top % 8)
    BCS noborrow1
        DEC srcBaseAddr+1
    .noborrow1

    \ srcBaseAddr -= eraseAbove
    SEC
    SBC eraseAbove
    BCS noborrow2
        DEC srcBaseAddr+1
    .noborrow2
    STA srcBaseAddr

    \ calc screen dstAddr
    JSR calcScreenDstAddr

    \ dstBaseAddr = dstAddr
    LDA dstAddr : STA dstBaseAddr
    LDA dstAddr+1 : STA dstBaseAddr+1

    \ outerCount = (left % 4 + width) / 4
    LDA leftLo
    AND #3
    CLC
    ADC width
    LSR A: LSR A
    STA outerCount

    \ is enemy lasered flag set? (save state in carry)
    CPX enemyCount : BEQ then10 : BCS endif10
    .then10
        SEC
        LDA objectState, X
        AND #OBJECT_STATE_FLAGS_LASERED
        BEQ endif10

        \ clear lasered flag and set redraw
        LDA objectState, X
        AND #LO(NOT(OBJECT_STATE_FLAGS_LASERED))
        ORA #OBJECT_STATE_FLAGS_REDRAW
        STA objectState, X
        CLC
    .endif10

    \ handle lasered and blank effects
    LDA index : BMI else11 : BCS endif11
        \ draw lasered sprite
        JMP drawLaseredObject \ implicit RTS
    .else11
        \ draw blank sprite
        ASSERT(LO(zeroMemory32) == 0 AND HI(zeroMemory32) == 0)
        STY srcBaseAddr
        STY srcBaseAddr+1
        STY stride
        STY offset
    .endif11
    
    \
    \ calculate head loop count/jump offset, and tail jump offet
    \
    LDA offset \ (top % 8)
    CLC
    ADC height
    CMP #9 : BCC else_10 \ sprite spans multiple character rows?

        \ head loop count = ((top % 8) + height - eraseBelow) / 8
        SEC
        SBC eraseBelow
        TAX
        LSR A: LSR A: LSR A \ / 8
        STA headCount

        \ calculate and patch head jump instruction
        LDA offset \ (top % 8)
        CLC
        ADC eraseAbove
        TAY
        LDA drawObject_headJumpTbl, Y
        STA head_jump_inst+1

        \ calculate and patch tail jump instruction
        TXA
        AND #7
        TAY
        LDA drawObject_tailJumpTbl, Y
        STA tail_jump_inst+1

        BCC endif_10

    .else_10 \ sprite fits within a single character row

        \ head loop count = zero
        STY headCount

        \ calculate and patch tail jump instruction
        LDA height
        SEC
        SBC eraseAbove
        SBC eraseBelow
        TAY
        LDA drawObject_tailJumpTbl,Y
        STA tail_jump_inst+1
    .endif_10

    \ finally, render the sprite
    .outerLoop

        \ update srcBaseAddr, srcAddr, dstBaseAddr, and dstAddrs, and erase above
        JSR drawObjectUpdateSrcDstAddrsAndEraseAbove

        \ while (headCount > 0)...
        LDX headCount : BEQ skipHeadLoop

        .head_jump_inst
        BCC head_jump_inst \ branch to head0..head8 (instruction patched above)
   
        .headLoop

            \ draw half character
            .*head0 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head1 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head2 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head3 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head4 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head5 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head6 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head7 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .*head8

            \ dstAddr += 512
            LDA #2
            ADC dstAddr+1
            BPL nowrap3 \ if (dstAddr => &8000) dstAddr -= -&4000
                SEC
                SBC #&40
                CLC
            .nowrap3
            STA dstAddr+1

            \ srcAddr += 8
            LDA #8
            ADC srcAddr
            BCC nocarry11
                INC srcAddr+1
                CLC
            .nocarry11
            STA srcAddr

            \ reset indexer    
            LDY #0

            \ loop while (--headCount > 0)\
            DEX
            BNE headLoop

        .skipHeadLoop

        .tail_jump_inst
        BCC tail_jump_inst \ branch to tail0..tail8 (instruction patched above)

        \ draw half character
        .*tail8 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail7 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail6 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail5 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail4 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail3 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail2 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail1 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .*tail0

        \ erase below?
        LDA eraseBelow : BEQ skipEraseBelow
            LDA #0 : STA (dstAddr),Y
        .skipEraseBelow

        \ outer loop?
        DEC outerCount
        BEQ return
        JMP outerLoop

.return
    PLA : TAX \ restore X register
    RTS
}

\
\ drawLaseredObject
\
\ params:
\   Y register = zero
\
.drawLaseredObject
{
    \
    \ calculate head loop count/jump offset, and tail jump offet
    \
    LDA offset \ (top % 8)
    CLC
    ADC height
    CMP #9 : BCC else_10 \ sprite spans multiple character rows?

        \ head loop count = ((top % 8) + height - eraseBelow) / 8
        SEC
        SBC eraseBelow
        TAX
        LSR A: LSR A: LSR A \ / 8
        STA headCount

        \ head innermost count = 8 - (top % 8) - eraseAbove
        LDA #8
        SEC
        SBC offset \ (top % 8)
        SBC eraseAbove
        STA innerCount

        \ tail loop count = (height - eraseBelow) % 8 
        TXA
        AND #7
        STA temp \ --> tail count

        CLC
        BCC endif_10

    .else_10 \ sprite fits within a single character row

        \ head loop count = zero
        STY headCount

        \ tail loop count = height - eraseAbove - eraseBelow
        LDA height
        SEC
        SBC eraseAbove
        SBC eraseBelow
        STA temp \ --> tail count
    .endif_10

    \ finally, render the sprite
    .outerLoop
        \ update srcBaseAddr, srcAddr, dstBaseAddr, and dstAddrs, and erase above
        JSR drawObjectUpdateSrcDstAddrsAndEraseAbove

        \ while (headCount > 0)...
        LDA headCount : STA count
        BEQ skipHeadLoop

        .headLoop
            
            \ draw half character
            LDX innerCount
            BEQ skipHeadInnerLoop

            .headInnerLoop
                LDA (srcAddr), Y
                STA flags
                LSR A : LSR A : LSR A : LSR A
                AND flags
                STA (dstAddr), Y
                INY
                DEX
                BNE headInnerLoop

            .skipHeadInnerLoop

            \ dstAddr += 512
            LDA #2
            CLC
            ADC dstAddr+1
            BPL nowrap3 \ if (dstAddr => &8000) dstAddr -= -&4000
                SEC
                SBC #&40
                CLC
            .nowrap3
            STA dstAddr+1

            \ srcAddr += 8
            LDA #8
            ADC srcAddr
            BCC nocarry11
                INC srcAddr+1
                CLC
            .nocarry11
            STA srcAddr

            \ reset indexer
            LDY #0

            \ reset inner loop counter
            LDX #8

            \ loop while (--headCount > 0)\
            DEC count
            BNE headInnerLoop

        .skipHeadLoop

        \ draw tail half character
        LDX temp \ <-- tail count
        BEQ skipTailLoop 
        .tailLoop
            LDA (srcAddr), Y
            STA flags
            LSR A : LSR A : LSR A : LSR A
            AND flags
            STA (dstAddr), Y
            INY
            DEX
            BNE tailLoop
        .skipTailLoop

        \ erase below?
        LDA eraseBelow : BEQ skipEraseBelow
            LDA #0 : STA (dstAddr),Y
        .skipEraseBelow

        \ outer loop?
        DEC outerCount
        BEQ return
        JMP outerLoop

.return
    PLA : TAX \ restore X register

    \ fall through to RTS
}

\
\ common RTS
\
.rts_6
{
    RTS
}

\
\ drawEnemyHealthBar(X register)
\
\ draws the enemy health bar within the appropriate sprite
\
\ params:
\   X register      Enemy index
\
.drawEnemyHealthBar
{
    \ check if health is not full or empty
    LDA objectState, X
    AND #ENEMY_STATE_HEALTH_MASK : BEQ rts_6
    CMP #7 : BEQ rts_6
    STA temp \ --> health

    \ left = objectX & &FFFC
    LDA objectXHi, X : STA leftHi
    LDA objectXLo, X : AND #&FC : STA leftLo

    \ top = objectY
    LDA objectYHi, X : STA topHi
    LDA objectYLo, X : STA topLo
    AND #7
    STA offset \ --> topLo MOD 8

    \ look up sprite health bar position and offset
    LDY objectSpriteIndex, X
    LDA spriteHealthBarTbl, Y
    TAX \ --> health bar position & offset 
    ASL A \ top bit denotes offset
    BCC skip1
        \ left += 16
        LDA leftLo
        ADC #15
        STA leftLo
        BCC nocarry
            INC leftHi
        .nocarry
    .skip1

    \ width, height, widthMinusOne, heightMinusOne (used by convertToScreenSpace)
    LDY #8 : STY width
    DEY : STY widthMinusOne
    LDY #1 : STY height
    DEY : STY heightMinusOne

    \ convert to screen space, performing broard clipping
    JSR convertToScreenSpace
    BNE rts_6

    \ lookup left and right pixels, which we store in srcAddr and srcAddr+1
    LDA temp \ <-- health
    SEC
    SBC #1
    AND #&FE \ DIV 2 MUL 2
    STA temp \ --> (health - 1) DIV 2 MUL 2

    TXA \ <-- health bar position & offset
    AND #&7F \ mask out offset
    CLC
    ADC temp
    TAY
    LDA healthBarAtlas, Y
    STA srcAddr \ --> left pixels
    LDA healthBarAtlas+1, Y
    STA srcAddr+1 \ --> right pixels

    \ clip right edge
    LDY #&FF
    LDA rightHi : BEQ endif_6
        STY srcAddr+1 \ mark right pixels clipped
    .endif_6

    \ clip left edge
    LDA leftHi : BPL endif_7
        STY srcAddr \ mark left pixels clipped
        INY
        STY leftLo \ left = 0
    .endif_7

    \ calculate destination screen addr
    JSR calcScreenDstAddr

    \ dstAddr += (topLo MOD 8)
    LDA dstAddr
    CLC
    ADC offset
    STA dstAddr

    \
    \ finally, render the left and right pixels
    \

    \ write left pixels, if not clipped
    LDY #0
    LDA srcAddr \ <-- left pixels
    CMP #&FF : BEQ skip2
        STA (dstAddr), Y
    .skip2

    \ dstAddr += 8, if neither left or right pixels are clipped
    ORA srcAddr+1 \ <-- right pixels
    CMP #&FF : BEQ skip3
        JSR dstAddr_add_8
    .skip3

    \ write right pixels, if not clipped
    LDA srcAddr+1 \ <-- right pixels
    CMP #&FF : BEQ skip5
        STA (dstAddr), Y
    .skip5

.return
    RTS
}

\
\ drawObjectUpdateSrcDstAddrsAndEraseAbove
\
\ common outer loop code
\
.drawObjectUpdateSrcDstAddrsAndEraseAbove
{
    \ srcAddr = srcBaseAddr, srcBaseAddr += stride
    LDA srcBaseAddr+1 : STA srcAddr+1
    LDA srcBaseAddr : STA srcAddr
    CLC
    ADC stride
    STA srcBaseAddr
    BCC nocarry1
        INC srcBaseAddr+1
        CLC
    .nocarry1

    \ dstAddr = dstBaseAddr, dstBaseAddr += 8
    LDA dstBaseAddr+1 : STA dstAddr+1
    LDA dstBaseAddr : STA dstAddr
    ADC #8
    STA dstBaseAddr
    BCC nocarry2
        INC dstBaseAddr+1
        BPL nowrap \ if (dstBaseAddr >= &8000) dstBaseAddr -= &4000
            LDA dstBaseAddr+1
            SBC #&40
            STA dstBaseAddr+1
        .nowrap
        CLC
    .nocarry2

    \ initialize indexer
    LDY offset \ (top % 8)

    \ erase above?
    LDA eraseAbove : BEQ skip
        LDA #0
        STA (dstAddr), Y
        INY
    .skip

    RTS
}

\
\ dstAddr_add_512()
\
\ dstAddr += 512
\ if (dstAddr >= &8000) dstAddr -= &4000
\
.dstAddr_add_512
{
    LDA #2
    CLC
    ADC dstAddr+1
    BPL nowrap  \ dstAddr >= &8000?
        SEC
        SBC #&40
        CLC
    .nowrap
    STA dstAddr+1
    RTS
}

\
\ laserUpdateVariablesLeftToRight
\ 
.laserUpdateVariablesLeftToRight
{
    \ leftLo += 4
    LDA leftLo
    CLC
    ADC #4
    STA leftLo

    \ fall through to dstAddr_add_8
}

\
\ dstAddr_add_8
\
\ dstAddr += 8
\ if (dstAddr >= &8000) dstAddr -= &4000
\
.dstAddr_add_8
{
    LDA #8
    \ fall through to dstAddr_add
}

\
\ dstAddr_add(A)
\
\ dstAddr += Accumulator
\ if (dstAddr >= &8000) dstAddr -= &4000
\
.dstAddr_add
{
    CLC
    ADC dstAddr
    STA dstAddr
    BCC nocarry
        INC dstAddr+1
        BPL nowrap \ if (dstAddr >= &8000) dstAddr -= &4000 
            LDA dstAddr+1
            SBC #&40  
            STA dstAddr+1
        .nowrap
    .nocarry
    RTS
}

\
\ laserUpdateVariablesRightToLeft
\ 
.laserUpdateVariablesRightToLeft
{
    \ leftLo += 4
    LDA leftLo
    SEC
    SBC #4
    STA leftLo

    \ fall through to dstAddr_sub_8
}

\
\ dstAddr_sub_8()
\
\ dstAddr -= 8
\ if (dstAddr < &4000) dstAddr += &4000
\
.dstAddr_sub_8
{
    LDA dstAddr
    SEC
    SBC #8
    STA dstAddr
    BCS noborrow
        DEC dstAddr+1
        LDA dstAddr+1
        CMP #HI(&4000) : BCS nowrap \ if (dstAddr < &4000) dstAddr += &4000
            ADC #&40
            STA dstAddr+1
        .nowrap
    .noborrow
    RTS
}

\ end file
