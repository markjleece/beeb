\
\ draw routines
\ 

\
\ refreshGameBar()
\
.refreshGameBar
{
    \ update game bar every 8 frames, offset by 2
    LDA frameCount
    AND #7
    CMP #2
    BEQ drawGameBar
    RTS
}

\
\ drawGameBar()
\
.drawGameBar    
{
IF DEBUG_TILE_GRID_FLAGS != 0
    RTS

    .^ora_inst
    SKIP 160 \ report same number of unused code/data bytes
ELSE
    \ dstAddr = scrnAddr + 384
    LDX #LO(384)
    LDY #HI(384)
    JSR calcScreenDstAddrOffset

    \ srcBaseAddr, srcAddr = spriteAddrTbl[SPRITE_INDEX_GAMEBAR]
    LDA spriteAddrTblLo + SPRITE_INDEX_GAMEBAR
    STA srcBaseAddr
    STA srcAddr
    STA inst_LDA+1 \ set LDA instruction operand (low-byte) in drawDigit
    
    LDA spriteAddrTblHi + SPRITE_INDEX_GAMEBAR
    STA srcBaseAddr+1
    STA srcAddr+1
    STA inst_LDA+2 \ set LDA instruction operand (high-byte) in drawDigit

    \ draw level icon
    JSR copyBytesToScreen_16

    \ draw level number
    LDA level
    JSR drawDigit

    LDA #16    
    JSR dstAddr_add

    \ draw heart icon
    JSR copyBytesToScreen_16

    LDA #8
    JSR copyBytesToScreen

    \
    \ draw health bar
    \

    \ 'XOR mask' (flags) = (keyColor == foreground) ? &FF : 0
    LDY #59
    LDA (srcBaseAddr), Y \ peek key color
    ASL A
    LDX #0
    BCC skip1
        DEX \ X = &FF
    .skip1
    STX flags \ <-- XOR mask

    \ 'OR mask' (temp) = (heathHi < 5) ? (&F ^ XOR mask) : 0
    LDA healthHi
    CMP #5
    LDA #0
    BCS skip2
        LDA #&0F
        EOR flags
    .skip2
    STA temp \ <-- OR mask

    \ offset, count = 4
    LDA #4
    STA offset
    STA count

    .healthBarLoop
        LDY #0

        \ render header
        LDA (srcBaseAddr), Y
        STA (dstAddr), Y : INY
        STA (dstAddr), Y : INY

        \ render bar (in foreground/background colors)
        LDA offset \ if (offset - healthHi <= 0)
        SEC
        SBC healthHi : BEQ then : BPL else
        .then
            LDA #0 \ background
            BEQ endif
        .else
            CMP #4 : BPL else2 \ if (offset - healthHi < 4)
            LDA healthHi
            AND #3
            TAX
            LDA lineTbl, X \ foreground/background
            BNE endif
        .else2
            LDA #&FF \ foreground
        .endif

        ORA temp  \ apply OR mask
        EOR flags \ apply XOR mask

        LDX #4
        .innerLoop
            STA (dstAddr), Y : INY
            DEX
            BNE innerLoop

        \ render footer
        INY
        LDA (srcBaseAddr), Y
        DEY
        STA (dstAddr), Y : INY
        STA (dstAddr), Y

        \ dstAddr += 8 (with wraparound)
        JSR dstAddr_add_8

        \ offset += 4
        LDA offset
        CLC
        ADC #4
        STA offset

        \ loop?
        DEC count
        BNE healthBarLoop

    \ draw key icon
    LDA #8
    JSR copyBytesToScreen

    JSR copyBytesToScreen_16

    \ draw key count
    LDA keyCount
    JSR drawDigit

    \ god mode?
    LDA godMode : BMI skip3
        \ render top-right screen pixel black
        LDY #8
        LDA (dstAddr), Y
        AND #&EE
        .^ora_inst ORA #&11 \ operand patched in initializeLevelVariables (level.6502)
        STA (dstAddr), Y
    .skip3
    RTS

.drawDigit
    ASL A : ASL A : ASL A : ASL A \ MUL 16
    CLC
    ADC #(64+15)
    TAX
    LDY #15
    .digitLoop
        .inst_LDA LDA &FFFF, X : DEX
        STA (dstAddr), Y : DEY
        BPL digitLoop

    RTS

.copyBytesToScreen_16
    LDA #16

.copyBytesToScreen
    TAX : TAY

    \ copy bytes
    DEY
    .loop
        LDA (srcAddr), Y : STA (dstAddr), Y : DEY
        BPL loop

    \ srcAddr += X
    TXA
    CLC
    ADC srcAddr
    STA srcAddr
    BCC noCarry
        INC srcAddr+1
    .noCarry

    \ dstAddr += X (with wraparound)
    TXA
    JMP dstAddr_add \ implicit RTS

.lineTbl EQUB %11111111, %01110111, %00110011, %00010001

ENDIF
}

\
\ debugTileGridFlags()
\
\ modifies:
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.debugTileGridFlags
{
IF DEBUG_TILE_GRID_FLAGS == 0
    RTS
ELSE
    \ calc screen address and tileGridAddr of top-left fully visible tile
    LDA #15 : STA topLo : STA leftLo
    JSR getTileScreenAddr
    JSR getScreenTileGridAddr

    LDA #0 : STA outerIndex
    .outerLoop

        LDA #0 : STA index

        .innerLoop
            \ render flags
            LDY index
            LDA (tileGridAddr), Y
            STA temp
            LDX #3
            LDY #0
            .loop
                ASL temp
                LDA #&FF
                BCC flagNotSet
                    LDA #&99
                .flagNotSet
                STA (dstAddr), Y
                INY
                DEX
                BNE loop

            \ dstAddr += 32
            LDA #32
            JSR dstAddr_add

            \ index += 1
            INC index

            \ loop?
            LDA index
            CMP #16
            BNE innerLoop

        \ dstAddr += 512
        JSR dstAddr_add_512 

        \ tileGridAddr += horzTileCount
        JSR tileGridAddr_add_horzTileCount

        \ count += 1
        INC outerIndex

        \ loop?
        LDA outerIndex
        CMP #16
        BNE outerLoop

    RTS

ENDIF
}

\
\ drawTileBackground()
\
\ draw tile background (reusing scrolling code)
\
.drawTileBackground
{
    .loop

        \ scrnLeft -= 8, scrnAddr -= 16 
        JSR scrollLeftUpdateVariables

        \ draw vertical tile strip
        LDA #LO(DIRECTION_LEFT) : STA scrollDirection
        JSR drawVertTileScrollStrip
        
        LDA scrnLeftLo
        BNE loop

    \ update hardware after next v-sync
    JSR waitForNextVSync
    JMP updateScreenPosition \ implicit RTS
}

\
\ getTileSrcAddr(tileGridAddr, offset)
\
\ get tile source address
\
\ returns:
\   srcAddr         Tile data source address
\   Accumulator     Zero if blank tile rendered, otherwise non-zero
\
\ params:
\   tileGridAddr    Tile grid address
\   offset          Source offset
\
.getTileSrcAddr
{
    \ 'tileIndex' = *tileGridAddr & TILE_GRID_INDEX_MASK
    LDY #0
    LDA (tileGridAddr), Y
    AND #TILE_GRID_INDEX_MASK
    BEQ blankTile
        \ srcAddr = tiles - 64 + (64 * 'tileIndex') + offset
        TAY
        LDA tileAddrTblLo, Y
        CLC
        ADC offset
        STA srcAddr

        LDA tileAddrTblHi, Y
        BNE skip
    .blankTile
        \ srcAddr = zeroMemory32
        ASSERT(LO(zeroMemory32) == 0 AND HI(zeroMemory32) == 0)
        STA srcAddr
    .skip
    STA srcAddr+1

    RTS
}

\
\ drawHorzTileScrollStrip(scrollDirection)
\
\ draws a horizontal tile strip across either the top or bottom edges of the screen
\
\ params:
\   scrollDirection   DIRECTION_DOWN | DIRECTION_UP
\
\ modifies: 
\   dstAddr, srcAddr, offset, temp
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.drawHorzTileScrollStrip
{
    \ leftLo = 0
    \ topLo = scroll-down ? 248 : 0
    \ X/Y = LO/HI(scroll-down ? 31*512 : 0)
    LDA #0 : STA leftLo
    TAX : TAY
    BIT scrollDirection : BMI skip1
        LDA #248
        LDY #HI(31*512)
    .skip1
    STA topLo

    \ offset = 0 | 32
    CLC
    ADC scrnTopLo
    AND #8
    ASL A : ASL A
    STA offset
     
    \ dstAddr = scrnAddr + X/Y
    JSR calcScreenDstAddrOffset

    \ get tile grid address at [leftLo, topLo]
    JSR getScreenTileGridAddr

    LDX #16
    .loop
        \ shift rendering to below game bar (one character below)
        CPX #4 : BNE skip2
        BIT scrollDirection : BPL skip2
            LDA offset : BEQ skip3
                \ tileGridAddr += horzTileCount
                JSR tileGridAddr_add_horzTileCount
            .skip3

            \ offset = 0 -> 32 or 32 -> 0
            LDA #32
            EOR offset
            STA offset

            \ dstAddr += 512
            JSR dstAddr_add_512 
        .skip2

        \ get tile source address (srcAddr)
        JSR getTileSrcAddr

        \ draw tile character row
        LDY #31
        .innerLoop1
            LDA (srcAddr),Y : STA (dstAddr),Y: DEY
            BPL innerLoop1
             
        \ dstAddr += 32
        LDA #32
        JSR dstAddr_add

        \ tileGridAddr++
        INC tileGridAddr
        BNE nocarry3
            INC tileGridAddr+1
        .nocarry3
        
        \ loop?
        DEX
        BNE loop
        
    RTS
}

\
\ calcVertTileStripStart
\
\ calculates the tile source address and offset, and the screen destination address
\ 
\ params:
\   leftLo, topLo       Screen coords
\   X/Y registers       Screen address offset (hi/lo bytes)
\
\ modifies:
\   offset, tileGridAddr, dstAddr, temp
\
.calcVertTileStripStart
{
    \ offset = 0 | 16
    LDA leftLo
    CLC
    ADC scrnLeftLo
    AND #8
    ASL A
    STA offset

    \ dstAddr = scrnAddr + X/Y
    JSR calcScreenDstAddrOffset

    \ get grid tile address at [leftLo, topLo]
    JMP getScreenTileGridAddr \ implicit RTS
}

\
\ drawVertTileScrollStrip(scrollDirection)
\
\ draws a vertical tile strip down either the left or right edges of the screen
\
\ params:
\   scrollDirection  DIRECTION_RIGHT | DIRECTION_LEFT
\
\ modifies: 
\   self: dstAddr, srcAddr, outerCount, offset
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.drawVertTileScrollStrip
{
    \ topLo = 0
    \ leftLo = scroll-right ? 248 : 0
    \ X/Y = LO/HI(scroll-right ? 512-16 : 0)
    LDA #0 : STA topLo
    TAX : TAY
    BIT scrollDirection : BMI skip1
        LDA #248
        LDX #LO(512-16)
        LDY #HI(512-16)
    .skip1
    STA leftLo
    
    \ calc dstAddr, tileGridAddr, and offset
    JSR calcVertTileStripStart

    LDA #16 : STA outerCount
    .loop
        \ get tile source address (srcAddr)
        JSR getTileSrcAddr

        \ stride = 0 or 32
        BEQ skip2
            LDA #32
        .skip2
        STA stride 

        \ draw tile character column
        LDX #2

        \ skip first character if scrolling right
        LDA outerCount : CMP #16 : BNE skip3
            BIT scrollDirection : BPL skipFirstCharacter
        .skip3

        \ draw two tile characters, one above the other
        .innerLoop1
            LDY #15
            .innermostLoop1
                LDA (srcAddr),Y : STA (dstAddr),Y: DEY
                BPL innermostLoop1

            .skipFirstCharacter

            \ dstAddr += 512
            JSR dstAddr_add_512 

            \ srcAddr += stride
            LDA srcAddr
            ADC stride
            STA srcAddr

            \ loop ?
            DEX
            BNE innerLoop1

        \ tileGridAddr += horzTileCount
        JSR tileGridAddr_add_horzTileCount

        \ loop ?
        DEC outerCount
        BNE loop

    RTS
}

\
\ drawTileLeftOfGamebar()
\
\ draws the tile character positioned left of the game bar
\
\ modifies: 
\   self: dstAddr, srcAddr, outerCount, count, offset
\   getScreenTileGridAddr: tileGridAddr, temp, Y
\
.drawTileLeftOfGamebar
{
    \ X/Y = LO/HI(512-9*16)
    LDX #LO(512-9*16)
    LDY #HI(512-9*16)

    \ leftLo = 256-9*8, topLo = 0
    LDA #0 : STA topLo
    LDA #LO(256-9*8) : STA leftLo

    \ calc dstAddr, tileGridAddr, and offset
    JSR calcVertTileStripStart

    \ get tile source address (srcAddr, offset)
    JSR getTileSrcAddr

    \ draw tile character column
    LDY #15
    .loop
        LDA (srcAddr),Y : STA (dstAddr),Y: DEY
        BPL loop

    RTS
}

\
\ getTileScreenAddr(leftLo, topLo)
\
\ get the screen address (dstAddr) of a tile at screen location [leftLo, topLo]. The
\ coordinates must lie within the visible screen but can lie anywhere within the tile.
\
\ params:
\   leftLo      Screen X coordinate (0..255)
\   topLo       Screen Y coordinate (0..255)
\
\ modifies: 
\   dstAddr
\
.getTileScreenAddr
{
    \ dstAddr = scrnAddr + (ROUND16(scrnTopLo + topLo) - scrnTopLo) / 8 * 512
    LDA scrnTopLo
    CLC
    ADC topLo
    AND #&F0 \ ROUND16
    SEC
    SBC scrnTopLo
    AND #&F8 \ / 8 * 512
    LSR A : LSR A
    CLC
    ADC scrnAddr+1
    STA dstAddr+1

    \ dstAddr += (ROUND16(scrnLeftLo + leftLo) - scrnLeftLo) / 4 * 8
    LDA scrnLeftLo
    CLC
    ADC leftLo
    AND #&F0 \ ROUND16
    SEC
    SBC scrnLeftLo
    AND #&FC \ / 4 * 8
    ASL A
    BCC nocarry3
        INC dstAddr+1
    .nocarry3

    CLC
    ADC scrnAddr
    STA dstAddr
    BCC nocarry4
        INC dstAddr+1
    .nocarry4

    \ if (dstAddr > 0x8000) dstAddr -= 0x4000
    LDA dstAddr+1
    BPL nowrap1
        SEC
        SBC #&40
        STA dstAddr+1
    .nowrap1

    RTS
}

\
\ laserHitTest(leftLo, topLo)
\
\ params:
\   leftLo, topLo   Screen coordinates
\
.laserHitTest
{
    \ get tile grid index and flags at: leftLo, topLo
    JSR getScreenTileGridAddr
    LDY #0
    LDA (tileGridAddr), Y
    TAY \ --> index & flags 

    \ hit enemy?
    AND #TILE_GRID_FLAGS_ENEMY : BEQ skip1
        JMP enemyLaserHitTest \ implicit RTS
    .skip1

    \ get tile type
    TYA \ <-- index & flags
    AND #TILE_GRID_INDEX_MASK
    TAY
    LDA levelTileTypes, Y

    \ hit destructible wall?
    LDY #0 \ replace wall with space
    CMP #TILE_TYPE_DESTRUCTIBLE_WALL : BEQ laseredTileHit \ implicit RTS

    \ hit off-switch?
    LDY switchOnTileGridValue \ replace off-switch with on-switch
    CMP #TILE_TYPE_SWITCH_OFF : BEQ laseredTileHit \ implicit RTS

    RTS
}

\
\ laseredTileHit(leftLo, topLo, tileGridAddr, Y register)
\
\ params:
\   leftLo, topLo   Screen coordinates
\   tileGridAddr    Tile grid address
\   Y register      Replacement tile index
\
.laseredTileHit
{
    STY outerIndex \ --> replacement tile

    \ draw lasered tile
    LDA #LO(-1)
    JSR drawTile

    \ redraw tile when laser beam is erased
    INC laseredTileRedraw
   
    \ if (laseredTileStrength != 0 && laseredTileTop/Left == top/left) ..
    LDA laseredTileStrength : BEQ else
    LDA leftLo : CMP laseredTileLeft : BNE else
    LDA topLo : CMP laseredTileTop : BNE else

        \ if (--laseredTileStrength == 0)
        DEC laseredTileStrength : BNE endif

            \ stop laser
            INC laserInhibited

            \ replace lasered tile with new one
            LDY #0
            LDA outerIndex \ <-- replacement tile
            STA (tileGridAddr), Y

            \ is switch?
            BEQ endif
                
                \ sound effect
                JSR achievementSoundEffect

                \ activate switch
                JMP activateSwitch \ implicit RTS
    .else
        \ remember tile's position
        LDA leftLo : STA laseredTileLeft
        LDA topLo : STA laseredTileTop

        \ reset tile's strength
        LDA #LASERED_TILE_STRENGTH : STA laseredTileStrength
    .endif

    RTS
}

\
\ drawLaserOn()
\
\ draw laser beam from K9's muzzle
\
\ modifies:
\   laserAddr       screen address of muzzle byte
\   laserMaxLength  max length of laser
\   laserDirection  positive (left to right), negative (right to left)
\   dstAddr         updated across scan-line
\   leftLo          muzzle x screen position
\   topLo           muzzle y screen position
\   temp            leftLo MOD 4
\
.drawLaserOn
{
    \ laserDirection = -1 (left), 0 (none), 1 (right)
    JSR getK9Direction \ Y = 0 (ANIMATE_LOOK_LEFT) .. 5 (ANIMATE_TURN_RIGHT_TO_LEFT)
    STA laserDirection

    \ stop laser if K9 is turning
    BNE skip1
        STA laserFrameCount
        INC laserInhibited
        RTS
    .skip1

    \ calculate K9's muzzle screen position (leftLo, topLo)
    LDA objectYLo
    CLC 
    ADC #6
    SEC
    SBC scrnTopLo
    STA topLo

    AND #7
    STA temp \ --> topLo MOD 8

    LDA objectXLo
    CLC 
    ADC laserOffsetTbl, Y
    SEC
    SBC scrnLeftLo

    \ ensure last two bits of xPos are either clear or set, so (leftLo, poxY) correctly intersects an enemy
    AND #&FC \ clear bits is looking left
    BIT laserDirection : BMI skip2
        ORA #3 \ set bits is looking right
    .skip2
    STA leftLo

    \ laserLength = (leftLo or (&FF - leftLo)) / 4
    BIT laserDirection : BMI skip3
        LDA #&FF
        SEC
        SBC leftLo
    .skip3
    LSR A : LSR A
    STA laserLength

    \ calc screen dstAddr 
    JSR calcScreenDstAddr

    \ dstAddr += topLo MOD 8
    LDA dstAddr
    CLC
    ADC temp
    STA dstAddr

    \ laserAddr = dstAddr
    STA laserAddr
    LDA dstAddr+1 : STA laserAddr+1

    \ drain health
    LDA healthLo
    SEC
    SBC laserHealthDrain
    STA healthLo
    LDA healthHi
    SBC #0
    STA healthHi

    \ if (health <= 0) invoke level incomplete experience
    BEQ levelIncomplete_local
    BCC levelIncomplete_local

    \ laser sound effect
    JSR laserSoundEffect

    \ populate JSR address with laserUpdateVariablesLeftToRight or laserUpdateVariablesRightToLeft
    LDA #LO(laserUpdateVariablesLeftToRight)
    LDY #HI(laserUpdateVariablesLeftToRight)
    BIT laserDirection : BPL skip4
        LDA #LO(laserUpdateVariablesRightToLeft)
        LDY #HI(laserUpdateVariablesRightToLeft)
    .skip4
    STA jsr_inst+1
    STY jsr_inst+2

    \ draw first few pixels
    LDY #0
    LDA (dstAddr), Y
    JSR drawEnd

    \ draw line body...
    LDX #0
    .loop
        \ dstAddr +=/-= 8, leftLo +=/-= 4
        .jsr_inst JSR &FFFF

        \ background color?
        LDA (dstAddr), Y
        STA laserLastPixels
        BEQ skip5
            \ draw last few pixels
            STX laserLength
            JSR drawEnd

            \ hit test
            JMP laserHitTest \ implicit RTS
        .skip5

        \ draw 4 laser pixels
        LDA #&0F
        STA (dstAddr), Y

        INX
        CPX laserLength
        BNE loop

    DEC laserLength
    RTS

.levelIncomplete_local
    JMP levelIncomplete \ implicit RTS

.drawEnd
    EOR #&FF
    STA temp
    LSR A : LSR A : LSR A : LSR A
    AND temp
    ORA (dstAddr), Y
    STA (dstAddr), Y
    RTS

.laserOffsetTbl
    EQUB 0, 20 \ look
    EQUB 0, 20 \ move
}

\
\ drawLaserOff()
\
\ modifies:
\   dstAddr, temp
\
.drawLaserOff
{
    \ dstAddr = laserAddr
    LDA laserAddr : STA dstAddr
    LDA laserAddr+1 : STA dstAddr+1

    \ populate JSR address with dstAddr_add_8 or dstAddr_sub_8
    LDA #LO(dstAddr_add_8)
    LDY #HI(dstAddr_add_8)
    BIT laserDirection : BPL skip1
        LDA #LO(dstAddr_sub_8)
        LDY #HI(dstAddr_sub_8)
    .skip1
    STA jsr_inst+1
    STY jsr_inst+2

    LDY #0
    LDX #&FF \ clear first few pixels twice

    .first
        \ clear first few pixels (we do this twice because K9 may have moved)
        LDA (dstAddr), Y
        EOR #&F0
        STA temp
        LSR A : LSR A : LSR A : LSR A
        AND temp
        EOR #&FF
        AND (dstAddr), Y
        STA (dstAddr), Y

    .loop
        \ dstAddr +=/-= 8
        .jsr_inst JSR &FFFF

        \ clear first few pixels again?
        DEX
        BPL skip2
            LDX laserLength
            BNE first
        .skip2

        \ restore last few pixels
        BEQ drawEnd

        \ draw 4 white pixels
        TYA
        STA (dstAddr), Y

        BEQ loop

    RTS

.drawEnd
    LDA laseredTileRedraw : BEQ else
        \ redraw lasered tile, clearing redraw flag
        LDA laseredTileLeft : STA leftLo
        LDA laseredTileTop : STA topLo
        LDA #0 : STA laseredTileRedraw
        BEQ drawTile \ implicit RTS
    .else
        \ restore last pixels
        LDA laserLastPixels
        STA (dstAddr), Y
    RTS
}

\
\ drawTile(Accumulator, leftLo, topLo)
\
\ draws a tile at screen location [leftLo, topLo]. The coordinates must lie
\ within the visible screen but can lie anywhere within the tile.
\
\ params:
\   accumulator     0 = draw normal, -1 = draw with lasered effect
\   leftLo          Screen X coordinate (0..255)
\   topLo           Screen Y coordinate (0..255)
\
\ modifies: 
\   X, Y, index, dstAddr, srcAddr, leftLo, topLo, stride
\
.drawTile
{
    STA index \ --> lasered

    \ get tile grid address at leftLo, topLo
    JSR getScreenTileGridAddr

    \ get screen address of tile
    JSR getTileScreenAddr

    \ get tile source address
    LDA #0 : STA offset
    JSR getTileSrcAddr
    
    \ stride = 0 or 32
    BEQ skip1
        LDA #32
    .skip1
    STA stride 

    \ update code to render regular or lasered
    LDA #LO(innerLoop_regular)
    LDY #HI(innerLoop_regular)
    BIT index : BPL skip2
        LDA #LO(innerLoop_lasered)
        LDY #HI(innerLoop_lasered)
    .skip2
    STA innerLoop+1
    STY innerLoop+2

    \ render the tile
    LDX #2
    .outerLoop

        \ draw character row
        LDY #31
        .innerLoop JSR &FFFF

        \ terminate loop?
        DEX
        BEQ return

        \ srcAddr += stride
        LDA srcAddr
        CLC
        ADC stride
        STA srcAddr
        BCC nocarry
            INC srcAddr+1
        .nocarry

        \ dstAddr += 512
        JSR dstAddr_add_512

        BNE outerLoop

    .return
    RTS

.innerLoop_regular
    .innerLoop1
        LDA (srcAddr), Y
        STA (dstAddr), Y
        DEY
        BPL innerLoop1
    RTS

.innerLoop_lasered
    .innerLoop2
        LDA (srcAddr), Y
        STA flags
        LSR A : LSR A : LSR A : LSR A
        AND flags
        STA (dstAddr), Y
        DEY
        BPL innerLoop2
    RTS
}

\
\ convertToScreenSpace(left, top, width, height)
\
\ converts level coords to screen coords, performing broad clipping
\
\ returns non-zero if object is fully clipped, otherwise zero
\
\ params:
\   leftLo/Hi       left coordinate (level coords)
\   topLo/Hi        top coordinate (level coords)
\   width           the width in pixels
\   height          the height in pixels
\   scrnLeftLo/Hi   screen left position (level coords)
\   scrnTopLo/Hi    screen left position (level coords)
\
\ returns:
\   leftLo/Hi       left coordinate (screen coords)
\   topLo/Hi        top coordinate (screen coords)
\   rightLo/Hi      right coordinate (screen coords)
\   bottomLo/Hi     bottom coordinate (screen coords)
\
.convertToScreenSpace
{
    \ left -= scrnLeft
    LDA leftLo
    SEC 
    SBC scrnLeftLo
    STA leftLo
    LDA leftHi
    SBC scrnLeftHi
    BEQ skip_1
    BPL return \ fully clipped (left > 255)
    .skip_1
    STA leftHi

    \ top -= scrnTop
    LDA topLo
    SEC 
    SBC scrnTopLo
    STA topLo
    LDA topHi
    SBC scrnTopHi
    BEQ skip_2
    BPL return \ fully clipped (top > 255)
    .skip_2
    STA topHi

    \ right = left + width - 1
    LDA leftLo
    CLC 
    ADC widthMinusOne
    STA rightLo

    LDA leftHi
    ADC #0
    BMI return \ fully clipped (right < 0)
    STA rightHi

    \ bottom = top + height - 1
    LDA topLo
    CLC
    ADC heightMinusOne
    STA bottomLo

    LDA topHi
    ADC #0
    BMI return \ fully clipped (bottom < 0)
    STA bottomHi

    \ mark as visible
    LDA #0

    .return
    RTS
}

\
\ calcScreenDstAddrOffset(offset)
\
\ dstAddr = scrnAddr + offset
\
\ params:
\   X register  offset (low-byte)
\   Y register  offset (hi-byte)
\
.calcScreenDstAddrOffset
{
    TXA \ <-- offset (low-byte)
    CLC
    ADC scrnAddr
    STA dstAddr
    TYA \ <-- offset (high-byte)
    ADC scrnAddr+1
    BPL nowrap \ if (dstAddr >= &8000) dstAddr -= &4000
        SEC
        SBC #&40       
    .nowrap
    STA dstAddr+1
    RTS
}

\
\ calcScreenDstAddr(leftLo, topLo)
\
\ calculate screen address of leftLo, topLo
\
\ params:
\   leftLo   left coordinate (screen coords)
\   topLo    top coordinate (screen coords)
\
\ modifies:
\   dstAddr
\
.calcScreenDstAddr
{
    \ dstAddr = scrnAddr + (top / 8) * 512
    LDA topLo
    AND #&F8
    LSR A : LSR A
    CLC
    ADC scrnAddr+1
    STA dstAddr+1

    \ dstAddr += (left / 4) * 8
    LDA leftLo
    AND #&FC
    ASL A
    BCC nocarry3
        INC dstAddr+1
    .nocarry3

    CLC
    ADC scrnAddr
    STA dstAddr
    BCC nocarry4
        INC dstAddr+1
    .nocarry4

    \ if (dstAddr > 0x8000) dstAddr -= 0x4000
    LDA dstAddr+1
    BPL nowrap1
        SEC
        SBC #&40
        STA dstAddr+1
    .nowrap1

    \ fall through to RTS
}

\
\ common RTS
\
.rts_5
{
    RTS
}

\
\ drawEnemyHealthBar(X register)
\
\ draws the enemy health bar within the appropriate sprite
\
\ params:
\   X register      Enemy index
\
.drawEnemyHealthBar
{
    \ use srcAddr to store the left and right pixel quads
    leftPixelQuad = srcAddr
    rightPixelQuad = srcAddr+1

    \ check if health is not full or empty
    LDA objectState, X
    AND #ENEMY_STATE_HEALTH_MASK : BEQ rts_5
    CMP #7 : BEQ rts_5
    STA temp \ --> health

    \ left = objectX & &FFFC
    LDA objectXHi, X : STA leftHi
    LDA objectXLo, X : AND #&FC : STA leftLo

    \ top = objectY
    LDA objectYHi, X : STA topHi
    LDA objectYLo, X : STA topLo

    \ offset = top MOD 8
    AND #7
    STA offset

    \ look up sprite health bar position and offset
    LDY objectSpriteIndex, X
    LDA spriteHealthBarTbl, Y
    TAX \ --> health bar position & offset 
    ASL A \ top bit denotes offset
    BCC skip1
        \ left += 16
        LDA leftLo
        ADC #15
        STA leftLo
        BCC nocarry
            INC leftHi
        .nocarry
    .skip1

    \ width, height, widthMinusOne, heightMinusOne (used by convertToScreenSpace)
    LDY #8 : STY width
    DEY : STY widthMinusOne
    LDY #1 : STY height
    DEY : STY heightMinusOne

    \ convert to screen space, performing broad clipping
    JSR convertToScreenSpace
    BNE rts_5 \ fully clipped

    \ lookup left and right pixels, which we store in leftPixelQuad and rightPixelQuad
    LDA temp \ <-- health
    SEC
    SBC #1
    AND #&FE \ DIV 2 MUL 2
    STA temp \ --> (health - 1) DIV 2 MUL 2

    TXA \ <-- health bar position & offset
    AND #&7F \ mask out offset
    CLC
    ADC temp
    TAY
    LDA healthBarAtlas, Y
    STA leftPixelQuad
    LDA healthBarAtlas+1, Y
    STA rightPixelQuad

    \ clip right edge
    LDY #&FF
    LDA rightHi : BEQ endif_6
        STY rightPixelQuad \ mark right pixels clipped
    .endif_6

    \ clip left edge
    LDA leftHi : BPL endif_7
        STY leftPixelQuad \ mark left pixels clipped
        INY
        STY leftLo \ left = 0
    .endif_7

    \ calculate destination screen address
    JSR calcScreenDstAddr

    \ dstAddr += (topLo MOD 8)
    LDA dstAddr
    CLC
    ADC offset
    STA dstAddr

    \
    \ finally, render the left and right pixels
    \

    \ write left pixels, if not clipped
    LDY #0
    LDA leftPixelQuad
    CMP #&FF : BEQ skip2
        STA (dstAddr), Y
    .skip2

    \ dstAddr += 8, if neither left or right pixels are clipped
    ORA rightPixelQuad
    CMP #&FF : BEQ skip3
        JSR dstAddr_add_8
    .skip3

    \ write right pixels, if not clipped
    LDA rightPixelQuad
    CMP #&FF : BEQ skip5
        STA (dstAddr), Y
    .skip5

    \ fall through to rts_6
}

.rts_6
{
    RTS
}

\
\ drawObject(X register)
\ 
\ draws an object to the screen (clipped if needed).  The routine draws the object column by column. The 
\ scan-lines above and below can optionally be erased.
\
\ params:
\   X register      Object index
\
\ modifies:
\   index           sprite index (0..31, -1 = blank)
\   leftLo/Hi       left position (0,3,7,11...)
\   topLo/Hi        top position (0+)
\   rightLo/Hi      right position
\   bottomLo/Hi     bottom position
\   width           sprite width (4,8,12,16...)
\   height          sprite height (1+)
\   stride          the stride across sprite data (original height)
\   eraseAbove      erase scan-line above (false|true)
\   eraseBelow      erase scan-line below (false|true)
\   srcBaseAddr     base address of sprite data (advanced every column)
\   dstBaseAddr     base address of screen (advanced every column)
\   srcAddr         address of sprite data (advanced drawing column)
\   dstAddr         address of screen (advanced drawing column)
\   outerCount      number of columns to draw (decremented every column)
\   headCount       number of head loop iterations
\   temp            holds various values
\   offset          holds top MOD 8
\
.drawObject
{
    \ leftLo/Hi = objectXLo/Hi[X] & 0xFFFC
    LDA objectXLo, X : AND #&FC : STA leftLo
    LDA objectXHi, X : STA leftHi

    \ topLo/Hi = objectYLo/Hi[X]
    LDA objectYLo, X : STA topLo
    LDA objectYHi, X : STA topHi

    \ cache extents (width, height, widthMinusOne, heightMinusOne)
    JSR cacheObjectExtents

    \ stride = height
    LDA height : STA stride

    \ expand extents if object is ascending or descending, setting
    \ flags to erase above or below
    LDA objectState, X
    AND #(OBJECT_STATE_FLAGS_ASCENDING OR OBJECT_STATE_FLAGS_DESCENDING) : BEQ else_1
        \ expand extents
        INC height
        INC heightMinusOne

        \ if descending expand-above otherwise expand below
        AND #OBJECT_STATE_FLAGS_DESCENDING : BEQ skip
            \ top -= 1
            LDA topLo
            BNE skip_1
                DEC topHi
            .skip_1
            DEC topLo
            LDA #1 \ erase above
        .skip
        STA eraseAbove
        EOR #1
        STA eraseBelow
        BPL endif_1
    .else_1
        STA eraseAbove \ = 0
        STA eraseBelow \ = 0
    .endif_1

    \
    \ convert to screen space (with broad clipping)
    \
    
    JSR convertToScreenSpace
    BNE rts_6 \ fully clipped

    \
    \ at this point we know we are going to render something
    \

    TXA : PHA \ save X register

    \ srcBaseAddr = spriteAddrTbl[index]
    LDY objectSpriteIndex, X
    STY index \ --> sprite index
    LDA spriteAddrTblLo, Y : STA srcBaseAddr
    LDA spriteAddrTblHi, Y : STA srcBaseAddr+1
    
    LDY #0 \ --> zero

    \ clip left edge?
    LDA leftHi : BPL endif_6
        \ 'clipped width' = 0 - left
        TYA \ <-- zero
        SEC
        SBC leftLo
        STA temp

        \ srcBaseAddr += 'clipped width' / 4 * stride
        LSR A : LSR A
        TAY
        LDA srcBaseAddr
        CLC
        .loop2
            ADC stride
            BCC nocarry5
                INC srcBaseAddr+1
                CLC
            .nocarry5
            DEY
            BNE loop2
        STA srcBaseAddr

        \ width -= 'clipped width'
        LDA width
        SEC
        SBC temp
        STA width

        \ left = 0
        STY leftLo
    .endif_6

    \ clip right edge?
    LDA rightHi : BEQ endif_7

        \ width -= right - 256
        LDA width
        SEC
        SBC rightLo
        SEC
        SBC #1
        STA width
    .endif_7

    \ clip top edge?
    LDA topHi : BPL endif_8
        
        \ 'clipped height' = 0 - top
        TYA \ <-- zero
        SEC
        SBC topLo
        STA temp

        \ srcBaseAddr += ('clipped height' - eraseAbove)
        SEC
        SBC eraseAbove
        CLC
        ADC srcBaseAddr 
        STA srcBaseAddr
        BCC nocarry6
            INC srcBaseAddr+1
        .nocarry6

        \ height -= 'clipped height'
        LDA height
        SEC
        SBC temp
        STA height

        \ top = 0
        STY topLo

        \ eraseAbove = false
        STY eraseAbove
    .endif_8

    \ clip bottom edge?
    LDA bottomHi : BEQ endif_9

        \ height -= bottom - 256
        LDA height
        SEC
        SBC bottomLo
        SEC
        SBC #1
        STA height

        \ eraseBelow = false
        STY eraseBelow
    .endif_9

    \ outerCount = width / 4
    LDA width
    LSR A: LSR A
    STA outerCount

    \
    \ adjust source base address
    \ 

    \ if (index < 0) then
    LDA index : BPL else_10
    
        \ blank sprite
        ASSERT(LO(zeroMemory32) == 0 AND HI(zeroMemory32) == 0)
        STY srcBaseAddr
        STY srcBaseAddr+1
        STY stride
        STY offset
        BMI endif_10
    
    .else_10

        \ offset = top % 8 
        LDA topLo
        AND #7
        STA offset

        \ if (offset != 0 || eraseAbove != 0) ...
        ORA eraseAbove : BEQ endif_10

            \ srcBaseAddr -= (top % 8)
            LDA srcBaseAddr
            SEC
            SBC offset \ (top % 8)
            BCS noborrow1
                DEC srcBaseAddr+1
            .noborrow1

            \ srcBaseAddr -= eraseAbove
            SEC
            SBC eraseAbove
            BCS noborrow2
                DEC srcBaseAddr+1
            .noborrow2
            STA srcBaseAddr

    .endif_10

    \ calc screen dstAddr
    JSR calcScreenDstAddr

    \ dstBaseAddr = dstAddr
    LDA dstAddr : STA dstBaseAddr
    LDA dstAddr+1 : STA dstBaseAddr+1

    \ is lasered flag set?
    LDA objectState, X
    AND #OBJECT_STATE_FLAGS_LASERED : BEQ endif_11
        \ replace lasered flag with redraw flag, so sprite is rendered normally the next frame
        LDA objectState, X
        AND #LO(NOT(OBJECT_STATE_FLAGS_LASERED))
        ORA #OBJECT_STATE_FLAGS_REDRAW
        STA objectState, X
    .endif_11
    STA temp \ --> 'lasered'

    \
    \ calculate headCount, 'innerHeadCount' (X register), and 'tailCount' (Y register)
    \
    LDA offset \ (top % 8)
    CLC
    ADC height
    CMP #9 : BCC else_12 \ sprite spans multiple character rows?

        \ 'full-height' = (top % 8) + height - eraseBelow
        SEC
        SBC eraseBelow
        TAX \ --> 'full-height'

        \ headCount = 'full height' / 8
        LSR A: LSR A: LSR A
        STA headCount

        \ 'tailCount' (Y register) = 'full height' % 8
        TXA \ <-- 'full height'
        AND #7
        TAY \ -> 'tailCount'

        \ 'innerHeadCount' (X register) = 8 - (top % 8) - eraseAbove
        LDA #8
        SEC
        SBC offset \ (top % 8)
        SBC eraseAbove
        TAX \ --> 'headInnerCount'

        JMP endif_12

    .else_12 \ sprite fits within a single character row

        \ headCount = zero
        STY headCount

        \ 'tailCount' (Y register) = height - eraseAbove - eraseBelow
        LDA height
        SEC
        SBC eraseAbove
        SBC eraseBelow
        TAY \ -> 'tailCount'
    .endif_12

    \ draw lasered effect?
    LDA temp : BEQ endif_13
        JMP drawLaseredObject \ implicit RTS
    .endif_13

    \ set head jump instruction
    LDA drawObject_jumpTbl, X
    STA head_jump_inst+1

    \ set tail jump instruction
    LDA drawObject_jumpTbl, Y
    STA tail_jump_inst+1

    \ finally, render the sprite
    .outerLoop

        \ srcAddr = srcBaseAddr, srcBaseAddr += stride
        LDA srcBaseAddr+1 : STA srcAddr+1
        LDA srcBaseAddr : STA srcAddr
        CLC
        ADC stride
        STA srcBaseAddr
        BCC nocarry1
            INC srcBaseAddr+1
            CLC
        .nocarry1

        \ dstAddr = dstBaseAddr, dstBaseAddr += 8
        LDA dstBaseAddr+1 : STA dstAddr+1
        LDA dstBaseAddr : STA dstAddr
        ADC #8
        STA dstBaseAddr
        BCC nocarry2
            INC dstBaseAddr+1
            BPL nowrap3 \ if (dstBaseAddr >= &8000) dstBaseAddr -= &4000
                LDA dstBaseAddr+1
                SBC #&40
                STA dstBaseAddr+1
            .nowrap3
            CLC
        .nocarry2

        \ initialize indexer
        LDY offset \ (top % 8)

        \ erase above?
        LDA eraseAbove : BEQ skipEraseAbove
            LDA #0
            STA (dstAddr), Y
            INY
        .skipEraseAbove

        \ while (headCount > 0)...
        LDX headCount : BEQ skipHeadLoop

        .head_jump_inst
        BCC head_jump_inst \ branch to head0..head8 (instruction patched above)
   
        .headLoop

            \ draw half character
            .head8 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head7 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head6 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head5 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head4 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head3 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head2 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head1 LDA (srcAddr), Y : STA (dstAddr), Y: INY
            .head0

            \ dstAddr += 512
            LDA #2
            ADC dstAddr+1
            BPL nowrap4 \ if (dstAddr => &8000) dstAddr -= -&4000
                SEC
                SBC #&40
                CLC
            .nowrap4
            STA dstAddr+1

            \ srcAddr += 8
            LDA #8
            ADC srcAddr
            BCC nocarry11
                INC srcAddr+1
                CLC
            .nocarry11
            STA srcAddr

            \ reset indexer
            LDY #0

            \ loop while (--headCount > 0)
            DEX
            BNE headLoop

        .skipHeadLoop

        .tail_jump_inst
        BCC tail_jump_inst \ branch to tail0..tail8 (instruction patched above)

        \ draw half character
        .tail8 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail7 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail6 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail5 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail4 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail3 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail2 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail1 LDA (srcAddr), Y : STA (dstAddr), Y: INY
        .tail0

        \ erase below?
        LDA eraseBelow : BEQ skipEraseBelow
            LSR A \ A = 0
            STA (dstAddr), Y
        .skipEraseBelow

        \ outer loop?
        DEC outerCount
        BEQ return
        JMP outerLoop

.return
    PLA : TAX \ restore X register
    RTS
}

\
\ drawLaseredObject(...)
\
\ invoked by drawObject to draw the sprite with a laser effect applied
\
\ params:
\   X register      number of head inner loop iterations
\   Y register      number of tail loop iterations
\   stride          the stride across sprite data (original height)
\   eraseAbove      erase scan-line above (false|true)
\   eraseBelow      erase scan-line below (false|true)
\   srcBaseAddr     base address of sprite data (advanced every column)
\   dstBaseAddr     base address of screen (advanced every column)
\   outerCount      number of columns to draw (decremented every column)
\   headCount       number of head loop iterations
\   offset          holds top MOD 8
\
\ modifies:
\   innerCount      number of head inner loop iterations
\   temp            number of tail loop iterations
\   count           number of head loop iterations (decremented drawing column)
\   srcAddr         address of sprite data (advanced drawing column)
\   dstAddr         address of screen (advanced drawing column)
\
.drawLaseredObject
{
    STX innerCount \ <-- 'headInnerCount'
    STY temp \ <-- 'tailCount'

    .outerLoop

        \ srcAddr = srcBaseAddr, srcBaseAddr += stride
        LDA srcBaseAddr+1 : STA srcAddr+1
        LDA srcBaseAddr : STA srcAddr
        CLC
        ADC stride
        STA srcBaseAddr
        BCC nocarry1
            INC srcBaseAddr+1
            CLC
        .nocarry1

        \ dstAddr = dstBaseAddr, dstBaseAddr += 8
        LDA dstBaseAddr+1 : STA dstAddr+1
        LDA dstBaseAddr : STA dstAddr
        ADC #8
        STA dstBaseAddr
        BCC nocarry2
            INC dstBaseAddr+1
            BPL nowrap1 \ if (dstBaseAddr >= &8000) dstBaseAddr -= &4000
                LDA dstBaseAddr+1
                SBC #&40
                STA dstBaseAddr+1
            .nowrap1
        .nocarry2

        \ initialize indexer
        LDY offset \ (top % 8)

        \ erase above?
        LDA eraseAbove : BEQ skipEraseAbove
            LSR A \ A = 0
            STA (dstAddr), Y
            INY
        .skipEraseAbove

        \ while (headCount > 0)...
        LDA headCount : STA count
        BEQ skipHeadLoop

        LDX innerCount \ <-- 'headInnerCount
        .headLoop
            
            \ draw half character
            BEQ headInnerLoopEnd
            .headInnerLoop
                LDA (srcAddr), Y
                STA flags
                LSR A : LSR A : LSR A : LSR A
                AND flags
                STA (dstAddr), Y
                INY
                DEX
                BNE headInnerLoop
            .headInnerLoopEnd

            \ reset indexer
            LDY #0

            \ reset inner loop counter
            LDX #8

            \ srcAddr += 8
            TXA
            CLC
            ADC srcAddr
            BCC nocarry11
                INC srcAddr+1
                CLC
            .nocarry11
            STA srcAddr

            \ dstAddr += 512
            LDA #2
            ADC dstAddr+1
            BPL nowrap2 \ if (dstAddr >= &8000) dstAddr -= &4000
                SEC
                SBC #&40
            .nowrap2
            STA dstAddr+1

            \ loop while (--headCount > 0)
            DEC count
            BNE headLoop

        .skipHeadLoop

        \ draw tail half character
        LDX temp \ <-- 'tailCount'
        BEQ tailInnerLoopEnd
        .tailInnerLoop
            LDA (srcAddr), Y
            STA flags
            LSR A : LSR A : LSR A : LSR A
            AND flags
            STA (dstAddr), Y
            INY
            DEX
            BNE tailInnerLoop
        .tailInnerLoopEnd
    
        \ erase below?
        LDA eraseBelow : BEQ skipEraseBelow
            LSR A \ A = 0
            STA (dstAddr), Y
        .skipEraseBelow

        \ outer loop?
        DEC outerCount
        BEQ return
        JMP outerLoop

.return
    PLA : TAX \ restore X register
    RTS
}

\
\ dstAddr_add_512()
\
\ dstAddr += 512
\ if (dstAddr >= &8000) dstAddr -= &4000
\
.dstAddr_add_512
{
    LDA #2
    CLC
    ADC dstAddr+1
    BPL nowrap \ if (dstAddr >= &8000) dstAddr -= &4000
        SEC
        SBC #&40
        CLC
    .nowrap
    STA dstAddr+1
    RTS
}

\
\ laserUpdateVariablesLeftToRight
\ 
.laserUpdateVariablesLeftToRight
{
    \ leftLo += 4
    LDA leftLo
    CLC
    ADC #4
    STA leftLo

    \ fall through to dstAddr_add_8
}

\
\ dstAddr_add_8
\
\ dstAddr += 8
\ if (dstAddr >= &8000) dstAddr -= &4000
\
.dstAddr_add_8
{
    LDA #8
    \ fall through to dstAddr_add
}

\
\ dstAddr_add(A)
\
\ dstAddr += Accumulator
\ if (dstAddr >= &8000) dstAddr -= &4000
\
.dstAddr_add
{
    CLC
    ADC dstAddr
    STA dstAddr
    BCC nocarry
        INC dstAddr+1
        BPL nowrap \ if (dstAddr >= &8000) dstAddr -= &4000 
            LDA dstAddr+1
            SBC #&40  
            STA dstAddr+1
        .nowrap
    .nocarry
    RTS
}

\
\ laserUpdateVariablesRightToLeft
\ 
.laserUpdateVariablesRightToLeft
{
    \ leftLo += 4
    LDA leftLo
    SEC
    SBC #4
    STA leftLo

    \ fall through to dstAddr_sub_8
}

\
\ dstAddr_sub_8()
\
\ dstAddr -= 8
\ if (dstAddr < &4000) dstAddr += &4000
\
.dstAddr_sub_8
{
    LDA dstAddr
    SEC
    SBC #8
    STA dstAddr
    BCS noborrow
        DEC dstAddr+1
        LDA dstAddr+1
        CMP #HI(&4000) : BCS nowrap \ if (dstAddr < &4000) dstAddr += &4000
            ADC #&40
            STA dstAddr+1
        .nowrap
    .noborrow
    RTS
}

\ end file
