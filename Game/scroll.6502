\
\ Scrolling routines
\

\
\ scrollUp
\
.scrollUp
{
    \ if (scrnTop == 0) return
    LDA scrnTopLo
    ORA scrnTopHi
    BEQ rts_17

    \ scrnTop -= 8
    LDA scrnTopLo
    SEC
    SBC #8
    STA scrnTopLo
    BCS skip
        DEC scrnTopHi
    .skip
         
    \ scrnAddr -= 512
    DEC scrnAddr+1
    DEC scrnAddr+1

    \ update screen
    BNE scrollVertUpdateScreen \ implicit RTS
}

\
\ scrollDown
\
.scrollDown
{
    \ if (scrnTop >= scrnTopMax - 1) return
    LDA scrnTopHi : CMP scrnTopHiMaxMinusOne : BCS rts_17

    \ scrnTop += 8
    LDA scrnTopLo
    CLC
    ADC #8
    STA scrnTopLo
    BCC skip
        INC scrnTopHi
    .skip

    \ scrnAddr += 512
    INC scrnAddr+1
    INC scrnAddr+1

    \ fall through to update screen
}

\
\ vertical scroll update screen helper
\
.scrollVertUpdateScreen
{
    \ update hardware
    JSR updateScreenPosition

    \ draw game bar
    JSR drawGameBar

    \ draw tile strip
    JMP drawHorzTileScrollStrip \ implicit RTS
}

\
\ scrollScreen()
\
\ scroll screen entry point
\
.scrollScreen
{
    LDA scrollCounter : BEQ noscroll
        DEC scrollCounter

        BNE skip
            \ doorScrollRedrawCount = doorCount (used to redraw doors after scrolling)
            LDA doorCount : STA doorScrollRedrawCount
        .skip

        LDA scrollDirection

        CMP #LO(DIRECTION_LEFT)
        BEQ scrollLeft \ implicit RTS

        CMP #LO(DIRECTION_RIGHT)
        BEQ scrollRight \ implicit RTS

        CMP #LO(DIRECTION_UP)
        BEQ scrollUp \ implicit RTS
        
        CMP #LO(DIRECTION_DOWN)
        BEQ scrollDown \ implicit RTS

    .noscroll

    \ fall through to RTS
}

\
\ common RTS
\
.rts_17
{
    RTS
}

\
\ scrollLeftUpdateVariables
\
.scrollLeftUpdateVariables
{
    \ scrnLeft -= 8
    LDA scrnLeftLo
    SEC
    SBC #8
    STA scrnLeftLo
    BCS skip1
        DEC scrnLeftHi
    .skip1
         
    \ scrnAddr -= 16
    LDA scrnAddr
    SEC
    SBC #16
    STA scrnAddr
    BCS skip2
        DEC scrnAddr+1
    .skip2

    RTS
}

\
\ scrollLeft
\
.scrollLeft
{
    \ if (scrnLeft == 0) return
    LDA scrnLeftLo
    ORA scrnLeftHi
    BEQ rts_17

    \ scrnLeft -= 8, scrnAddr -= 16
    JSR scrollLeftUpdateVariables

    \ update screen
    JMP scrollHorzUpdateScreen \ implicit RTS
}

\
\ scrollRight
\
.scrollRight
{
    \ if (scrnLeft >= scrnLeftMax - 1) return
    LDA scrnLeftHi : CMP scrnLeftHiMaxMinusOne : BCS rts_17

    \ scrnLeft += 8
    LDA #8
    CLC
    ADC scrnLeftLo
    STA scrnLeftLo
    BCC skip1
        INC scrnLeftHi
    .skip1

    \ scrnAddr += 16
    LDA #16
    CLC
    ADC scrnAddr
    STA scrnAddr
    BCC skip2
        INC scrnAddr+1
    .skip2

    \ draw tile character left of the game bar
    JSR drawTileLeftOfGamebar

    \ fall through to update screen
}

\
\ horizontal scroll update screen
\
.scrollHorzUpdateScreen
{
    \ update hardware
    JSR updateScreenPosition

    \ draw game bar
    JSR drawGameBar

    \ draw tile strip
    JMP drawVertTileScrollStrip \ implicit RTS
}

\
\ updateScreenPosition(scrnAddr)
\
\ Modifies: scrnAddr, srcAddr
\
.updateScreenPosition
{
    \ ensure scrnAddr is a valid screen address
    LDA scrnAddr+1 : BPL elseif \ if (scrnAddr >= &8000)
        SEC     
        SBC #&40 \ scrnAddr -= &4000
        STA scrnAddr+1
        BNE endif
    .elseif
    CMP #HI(&4000) : BCS endif \ else if (scrnAddr < &4000)
        ADC #&40 \ scrnAddr += &4000
        STA scrnAddr+1
    .endif

    \ temp:accumulator = scrnAddr / 8
    STA temp
    LDA scrnAddr
    LSR temp : ROR A
    LSR temp : ROR A
    LSR temp : ROR A

    \ Set 6845 CRTC: R13 screen start address, low-byte
    LDY #13
    STY &FE00
    STA &FE01 \ <-- LO(scrnAddr / 8)

    \ Set 6845 CRTC: R12 with screen start address, high-byte
    DEY \ Y = 12
    STY &FE00
    LDA temp 
    STA &FE01 \ <-- HI(scrnAddr / 8)

    RTS
}

\ end file