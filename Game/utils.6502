\
\ Utility routines
\

\
\ scanKey(A)
\
\ params:
\   Accumulator     Key scan code
\
\ returns:
\   Accumulator contains key scan code, bit 7 set if key pressed
\
ASSERT (HI(P%) > &17) \ ensure scanKey is assembled after &17FF

.scanKey
{
    TAY \ --> key scan code

    SEI \ disable interrupts

    \ stop auto-scan
    LDA #%00000011
    STA &FE40

    \ set data direction
    LDA #%01111111
    STA &FE43

    \ scan keyboard
    STY &FE4F
    LDY &FE4F
    
    \ restart auto-scan
    LDA #%00001011
    STA &FE40

    CLI \ re-enable interrupts

    TYA \ <-- key scan code (bit 7 set if key is down)
    
    RTS
}

\
\ scanKeys
\
\ scans keys KEY_A..KEY_9 populating top bit of keyTbl
\
.scanKeys
{
    \ scan keys
    LDX #25
    .loop
        \ read scan code, masking out top bit
        LDA keyTbl, X
        AND #&7F

        \ scan key
        JSR scanKey

        \ write scan code back, with top bit set if key is down
        STA keyTbl, X

        DEX
        BPL loop
    RTS

\ key table containing key scan codes. The top bit is set if the key is down
.^keyTbl 
    EQUB &41 \ KEY_A
    EQUB &32 \ KEY_D
    EQUB &53 \ KEY_G
    EQUB &36 \ KEY_O
    EQUB &33 \ KEY_R
    EQUB &51 \ KEY_S
    EQUB &23 \ KEY_T
    EQUB &21 \ KEY_W
    EQUB &42 \ KEY_X
    EQUB &61 \ KEY_Z
    EQUB &30 \ KEY_1
    EQUB &31 \ KEY_2
    EQUB &11 \ KEY_3
    EQUB &12 \ KEY_4
    EQUB &13 \ KEY_5
    EQUB &34 \ KEY_6
    EQUB &24 \ KEY_7
    EQUB &15 \ KEY_8
    EQUB &26 \ KEY_9
    EQUB &48 \ KEY_COLON
    EQUB &68 \ KEY_DIVIDE
    EQUB &62 \ KEY_SPACE
    EQUB &39 \ KEY_UP
    EQUB &29 \ KEY_DOWN
    EQUB &19 \ KEY_LEFT
    EQUB &79 \ KEY_RIGHT
}

\
\ waitForNextVSync()
\
\ wait until the v-sync flag is set by a interrupt service routine, clearing it afterwards.
\
\ The routine clears the v-sync flag and then waits for it to be set.
\
.waitForNextVSync
{
    \ clear v-sync flag
    LDA #0
    STA vsync

    \ fall through to waitOnVSync
}

\
\ waitOnVSync()
\
\ wait on v-sync flag being set by a interrupt service routine, clearing it afterwards.
\
\ The routine does not wait if the v-sync flag is already set.
\
.waitOnVSync
{
    .loop
        LDA vsync
        BEQ loop

    LDA #0
    STA vsync
    RTS
}

\ end file
