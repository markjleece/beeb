\
\ Utility routines
\

\
\ scanKeys(keySet)
\
\ scans the passed key set populating the corresponding top bit in the 
\ key table(keyTbl)
\
\ param:
\  Y Register  The key set to scan (SCAN_KEYS_SPACE, SCAN_KEYS_CORE, SCAN_KEYS_ALL, SCAN_KEYS_GOD_MODE_ALL)
\
.scanKeys
{
    SEI \ disable interrupts

    \ stop auto-scan
    LDA #%00000011
    STA &FE40

    \ scan keys
    .loop
        \ read scan code, masking out top bit
        LDA keyTbl, Y
        AND #&7F

        \ scan key
        STA &FE4F
        LDA &FE4F

        \ write scan code back, with top bit set if key is down
        STA keyTbl, Y

        DEY
        BPL loop

    \ restart auto-scan
    LDA #%00001011
    STA &FE40

    CLI \ re-enable interrupts

    RTS

\ key table containing key scan codes. The top bit is set if the key is down
.^keyTbl
    \ primary keys
    EQUB &62 \ KEY_SPACE
    EQUB &21 \ KEY_W
    EQUB &41 \ KEY_A
    EQUB &51 \ KEY_S
    EQUB &32 \ KEY_D
    EQUB &61 \ KEY_Z
    EQUB &42 \ KEY_X
    EQUB &48 \ KEY_COLON
    EQUB &68 \ KEY_DIVIDE
    
    \ secondary keys
    EQUB &53 \ KEY_G
    EQUB &36 \ KEY_O
    EQUB &33 \ KEY_R
    EQUB &23 \ KEY_T

    \ god mode keys
    EQUB &30 \ KEY_1
    EQUB &31 \ KEY_2
    EQUB &11 \ KEY_3
    EQUB &12 \ KEY_4
    EQUB &13 \ KEY_5
    EQUB &34 \ KEY_6
    EQUB &24 \ KEY_7
    EQUB &15 \ KEY_8
    EQUB &26 \ KEY_9
    EQUB &39 \ KEY_UP
    EQUB &29 \ KEY_DOWN
    EQUB &19 \ KEY_LEFT
    EQUB &79 \ KEY_RIGHT
}

\
\ waitForNextVSync()
\
\ wait until the v-sync flag is set by a interrupt service routine, clearing it afterwards.
\
\ The routine clears the v-sync flag and then waits for it to be set.
\
.waitForNextVSync
{
    \ clear v-sync flag
    LDA #0
    STA vsync

    \ fall through to waitOnVSync
}

\
\ waitOnVSync()
\
\ wait on v-sync flag being set by a interrupt service routine, clearing it afterwards.
\
\ The routine does not wait if the v-sync flag is already set.
\
.waitOnVSync
{
    .loop
        LDA vsync
        BEQ loop

    LDA #0
    STA vsync
    RTS
}

\ end file
