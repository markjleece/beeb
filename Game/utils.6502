\
\ Utility routines & macros
\

\
\ Copy and clear a page of memory
\
MACRO COPY_CLEAR_PAGE toAddr, fromAddr 
{
    LDX #0
    .loop
        LDA fromAddr, X
        STA toAddr, X
        LDA #0
        STA fromAddr, X
        INX
        BNE loop
}
ENDMACRO

\
\ Copy a page of memory
\
MACRO COPY_PAGE toAddr, fromAddr 
{
    LDX #0
    .loop
        LDA fromAddr, X
        STA toAddr, X
        INX
        BNE loop
}
ENDMACRO

\
\ setBlackPalette()
\
.setBlackPalette
{
    LDY #15
    .loop
        LDA blackPalette, Y
        STA &FE21
        DEY
        BPL loop
    RTS
}

\
\ setLevelPalette()
\
.setLevelPalette
{
    LDY #15
    .loop
        LDA levelPalette, Y
        STA &FE21
        DEY
        BPL loop
    RTS
}

\
\ scanKey(A)
\
\ params:
\   Accumulator     Key scan code
\
\ returns:
\   Accumulator contains key scan code, bit 7 set if key pressed
\
ASSERT (HI(P%) > &17) \ ensure scanKey is assembled after &17FF

.scanKey
{
    TAY \ --> key scan code

    SEI \ disable interrupts

    \ stop autoscan
    LDA #%00000011
    STA &FE40

    \ set data direction
    LDA #%01111111
    STA &FE43

    \ scan keyboard
    STY &FE4F
    LDY &FE4F
    
    \ restart autoscan
    LDA #%00001011
    STA &FE40

    CLI \ reenable interrupts

    TYA \ <-- key scan code (bit 7 set if key is down)
    
    RTS
}

\
\ scanKeys
\
\ scans keys KEY_A..KEY_9 populating top bit of keyTbl
\
.scanKeys
{
    \ scan keys
    LDX #25
    .loop
        \ read scan code, masking out top bit
        LDA keyTbl, X
        AND #&7F

        \ scan key
        JSR scanKey

        \ write scan code back, with top bit set if key is down
        STA keyTbl, X

        DEX
        BPL loop
    RTS

\ key table containing key scan codes. The top bit is set if the key is down
.^keyTbl 
    EQUB &41, &32, &21, &51, &53, &36, &33
    EQUB &62, &39, &29, &19, &79, &30, &31
    EQUB &11, &12, &13, &34, &24, &15, &26
    EQUB &61, &42, &48, &68, &23
}

\
\ waitForVSync()
\
\ wait for v-sync signal from IRQ
\
.waitForVSync
{
    .loop
        LDA vsync
        BEQ loop

    LDA #0
    STA vsync
    RTS
}

\
\ waitTenths(A)
\
\ params:
\   A (accumulator)    Number of tenths of a second to pause
\
\ modifies X, Y, temp
\
IF DEBUG_WAIT_TENTHS = 1
.waitTenths
{
    STA temp

    .tenthsLoop
     
    LDX #155
    .outerLoop
    
    LDY #255
    .innerLoop

    DEY
    BNE innerLoop

    DEX
    BNE outerLoop

    DEC temp
    BNE tenthsLoop

    RTS
}
ENDIF

\ end file
