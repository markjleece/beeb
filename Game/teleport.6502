\
\ Teleports are a special type of elevator
\

\
\ rideTeleport()
\
\ entry point for K9 to teleport. The routine first checks whether k9
\ is on a teleport and that the destination is clear.
\
\ returns success (zero) if k9 is on a teleport, otherwise non-zero
\
.rideTeleport
{
    \ check if k9 is standing on a teleport (sets tileGridAddr)
    LDA #TILE_TYPE_TELEPORT
    JSR queryObjectOnTiles : BNE rts_11

    \ find teleport object (result index returned in X)
    JSR findObjectsElevator : TXA : BEQ rts_11

    \ check if teleport is disabled, or a transition or scroll is in progress
    LDA objectState, X
    AND #OBJECT_STATE_FLAGS_DISABLED
    ORA transitionState
    ORA scrollCounter
    BNE rts_11

    \ get destination teleport index (held in teleport's objectFrameCounter)
    LDY objectFrameCounter, X

    \ deltaXY = objectXY[dest teleport] - objectXY[teleport]
    LDA objectXLo, Y
    SEC
    SBC objectXLo, X
    STA deltaXLo
    LDA objectXHi, Y
    SBC objectXHi, X
    STA deltaXHi

    LDA objectYLo, Y
    SEC
    SBC objectYLo, X
    STA deltaYLo
    LDA objectYHi, Y
    SBC objectYHi, X
    STA deltaYHi

    \ get destination teleport's tile grid address
    TYA : TAX
    LDA #0 : STA offsetX : STA offsetY
    JSR getObjectTileGridAddr

    \ check if the destination location is occupied
    JSR querySetElevatorTileOccupied : BEQ skip1
        \ occupied, so invoke blocked sound effect and return success to inhibit auto-scrolling behavior
        JSR blockedSoundEffect
        JMP success
    .skip1

    \ sound achievement effect
    JSR achievementSoundEffect

    \ perform crop close transition
    JSR cropCloseTransition

    \ undraw K9 from the screen
    LDA objectSpriteIndex : PHA

    LDA #&FF : STA objectSpriteIndex
    LDX #0 \ <-- k9's index
    JSR drawObject

    PLA : STA objectSpriteIndex

    \ clear tile flags at existing location
    LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_K9) : STA flags
    JSR clearObjectInsideTileFlags

    \ K9 position += delta
    LDA objectXLo
    CLC
    ADC deltaXLo
    STA objectXLo
    LDA objectXHi
    ADC deltaXHi
    STA objectXHi

    LDA objectYLo
    CLC
    ADC deltaYLo
    STA objectYLo
    LDA objectYHi
    ADC deltaYHi
    STA objectYHi

    \ set tile flags at new position
    JSR setObjectInsideTileFlags

    \ scroll destination teleport into view
    LDX #LO(DIRECTION_LEFT)
    LDA #LO(DIRECTION_RIGHT)
    JSR scroll

    LDA deltaYLo : STA deltaXLo
    LDA deltaYHi : STA deltaXHi

    LDX #LO(DIRECTION_UP)
    LDA #LO(DIRECTION_DOWN)
    JSR scroll

    \ redraw K9
    LDX #0 \ <-- k9's index
    JSR setRedrawFlag

    \ start crop open transition, setting level palette on completion
    LDA #LO(setLevelPalette)
    LDY #HI(setLevelPalette)
    JSR startCropOpenTransition

    \ return success
.success
    LDA #0
    RTS

.scroll
    \ deltaX = ABS(deltaX)
    \ scrollDirection = (deltaXHi < 0) ? X register : Accumulator 
    BIT deltaXHi : BPL skip2
        LDA #0
        SEC
        SBC deltaXLo
        STA deltaXLo
        LDA #0
        SBC deltaXHi
        STA deltaXHi
        TXA
    .skip2
    STA scrollDirection

    \ scrollCounter = deltaX / 8
    LDA deltaXLo
    LSR deltaXHi : ROR A
    LSR deltaXHi : ROR A
    LSR deltaXHi : ROR A
    STA scrollCounter

    \ scroll while scrollCounter != 0
    .loop
        JSR scrollScreen
        LDA scrollCounter
        BNE loop
     RTS
}


\
\ teleportFrameCallback(X register) - animation frame callback
\
\ frame callback for a teleport
\
\ params:
\   X register   Elevator index
\
.teleportFrameCallback
{
    \ default behavior
    JSR frameCallback_IntermittentRedraw : BNE return

    \ next keyframe
    LDA objectSpriteIndex, X
    CLC
    ADC #1
    CMP #SPRITE_INDEX_TELEPORT + 4
    BNE skip
        LDA #SPRITE_INDEX_TELEPORT
    .skip
    STA objectSpriteIndex, X

.return
    RTS
}

\ end file