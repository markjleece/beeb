\
\ Enemy behavior depends on the current 'action' state, which can be: ACTION_LOOK, ACTION_PACE, 
\ or ACTION_PURSUE_LEFT/RIGHT/UP/DOWN.  The 'action' is stored in the top 3-bits of objectType[]
\
\ The action states are defined as follows:
\
\   ACTION_LOOK
\   - Enemy is motionless, looking in a direction.
\
\   ACTION_PACE
\   - Enemy paces slowly left and right, turning if it encounters a wall.
\
\   ACTION_PURSUE_LEFT, ACTION_PURSUE_RIGHT
\   - Enemies move quickly left or right.
\   - If enemy hits a wall, action changes to ACTION_PURSUE_UP or ACTION_PURSUE_DOWN.
\
\   ACTION_PURSUE_UP, ACTION_PURSUE_DOWN
\   - Enemies move quickly left or right, looking for an elevator to ride up or down.
\   - If enemy hits a wall, action toggles between ACTION_PURSUE_UP and ACTION_PURSUE_DOWN.
\   - Enemies wait if the elevator it wants to ascend or descend is not clear to move.
\   
\ Common enemy behaviors
\   - If enemy does not have sufficient health to move or use weapon, action is set to ACTION_LOOK
\   - Enemies slow down when their health is low.
\   - If k9 is in sight, or enemy is lasered, mode is promoted to PURSUE_LEFT or PURSUE_RIGHT.
\   - If enemy is lasered from behind, enemy turns.
\   - If enemy is obstructed by something (not a wall), it waits for the obstruction to clear, or turns after three seconds.
\   - If k9 is within weapons range, enemy fires weapon.  Enemies don't move when using weapon.
\   - If enemy sees k9 take an elevator up or down, action mode is changed to PURSUE_UP or PURSUE_DOWN.
\   - If enemy elevator stops, enemy looks for k9 and turns if not seen.  If K9 still not seen, will try to descend/ascend again.
\   - If k9 is not seen by any enemy for 10 seconds, all ACTION_PURSUE_... actions are demoted to ACTION_PACE.
\   - Weeping angels are immobilized if face-to-face with K9, unless they are lasered.
\

\
\ Enemy routines
\

\
\ enemyEndAllPursuit
\
\ evaluate whether to end all enemy pursuit
\
.enemyEndAllPursuit
{
    \ if (endPursuitCounter == 0) return
    LDA endPursuitCounter : BEQ rts_15

    \ if (--endPursuitCounter != 0) return
    DEC endPursuitCounter : BNE rts_15

    \ end all enemy pursuit
    LDX enemyCount
    .loop
        LDA objectType, X : BPL skip2
            AND #LO(NOT(ACTION_MASK))
            ORA #ACTION_PACE
            STA objectType, X 
        .skip2

        DEX
        BNE loop

    \ silence sound effect
    JMP silencePursuitSoundEffect \ implicit RTS
}

\
\ common RTS
\
.rts_15
{
    RTS
}

\
\ enemyAI
\
\ performs enemy AI logic
\
\ modifies:
\   temp, direction
\
.enemyAI
{
    \ evaluate whether to end all pursuit every sixteen frames
    LDA frameCount
    AND #&0F
    BEQ enemyEndAllPursuit

    \ evaluate what action an individual enemy should take every sixteen frames
    CMP enemyCount
    BEQ then
    BCS rts_15
    .then
    TAX \ -> enemy index

    \ is the enemy destroyed?
    LDA objectState, X
    AND #ENEMY_STATE_HEALTH_MASK : BEQ rts_15

    \ does enemy have enough health to pursue K9?
    CMP #(ENEMY_WEAPON_THRESHOLD + 1) : BCS skip1
        \ action = ACTION_LOOK
        JSR enemySetActionLook

        \ silence pursuit
        JSR silencePursuitSoundEffect
        JMP clearImmobileFlag \ implicit RTS
    .skip1
    
    \ is enemy ascending or descending?
    LDA objectState, X
    AND #(OBJECT_STATE_FLAGS_ASCENDING OR OBJECT_STATE_FLAGS_DESCENDING)
    BNE clearImmobileFlag \ implicit RTS

    \ determine if K9 is in sight
    JSR getObjectDirection \ A = -1 (left), 0 (none), 1 (right)
    BEQ clearImmobileFlag \ implicit RTS (enemy turning)

    STA direction
    JSR queryK9InSight
    BMI clearImmobileFlag \ implicit RTS (not in sight)

    \
    \ K9 is in sight!
    \

    STA temp \ --> distance

    \ set action to ACTION_PURSUE_...
    LDA objectState \ <-- K9 state
    AND #(OBJECT_STATE_FLAGS_ASCENDING OR OBJECT_STATE_FLAGS_DESCENDING) : BEQ else
        \ set enemy action to ACTION_PURSUE_UP or ACTION_PURSUE_DOWN
        ASSERT(ACTION_PURSUE_DOWN = ACTION_PURSUE_UP OR ACTION_PURSUE_DOWN)
        ASL A : ASL A \ carry set -> ACTION_PURSUE_DOWN, carry clear -> ACTION_PURSUE_UP
        LDA objectType, X
        AND #LO(NOT(ACTION_MASK))
        ORA #ACTION_PURSUE_UP 
        BCC skip2
            ORA #ACTION_PURSUE_DOWN
        .skip2
        STA objectType, X
        BNE endif
    .else
        \ set enemy action to ACTION_PURSUE_LEFT or ACTION_PURSUE_RIGHT
        JSR setPursueLeftOrRight
    .endif

    \ reset end pursuit counter (used to end all enemy pursuit of K9)
    LDA #ENEMY_END_PURSUIT_COUNTER
    STA endPursuitCounter

    \ sound effect
    JSR pursuitSoundEffect
    
    \ don't use weapon if K9 is on an elevator
    LDA objectState \ <-- K9 state
    AND #(OBJECT_STATE_FLAGS_ASCENDING OR OBJECT_STATE_FLAGS_DESCENDING)
    BNE clearImmobileFlag \ implicit RTS

    \ use weapon if K9 is in weapons range?
    LDA temp \ <-- distance
    .^cmp_inst
    CMP #&FF \ operand patched in initializeLevelVariables (level.6502)
    BCC useWeapon \ implcit RTS (in weapons range)

    \
    \ immobolize Weeping Angels if they are face-to-face with K9, and not being lasered
    \

    \ is a Weeping Angel?
    LDA enemyType
    CMP #ENEMY_TYPE_WEEPING_ANGEL
    BNE clearImmobileFlag \ implicit RTS

    \ k9 and Weeping Angel face-to-face?  A = zero if face-to-face 
    JSR getK9Direction
    EOR direction
    EOR #LO(-1 EOR 1) \ left xor right

    \ and lasered?
    ORA laserFrameCount

    BNE clearImmobileFlag \ implicit RTS (not face-to-face or lasered)
    BEQ setImmobileFlag \ implicit RTS (face-to-face and not lasered)

.useWeapon
    \ set K9 damage counter (processed in inflictK9Damage)
    LDA k9DamageCounter : BNE skip5
        LDA #K9_DAMAGE_ON_COUNTER
        STA k9DamageCounter
    .skip5

    \ fall through to setImmobileFlag as enemies can't move when using their weapon

.setImmobileFlag
    \ set 'immobile' flag
    LDA objectState, X
    ORA #ENEMY_STATE_FLAGS_IMMOBILE
    BNE saveAndExit

.clearImmobileFlag
    \ clear 'immobile' flag
    LDA objectState, X
    AND #LO(NOT(ENEMY_STATE_FLAGS_IMMOBILE))

.saveAndExit
    STA objectState, X

    \ fall through to RTS
}

\
\ common RTS
\
.rts_16
{
    RTS
}

\
\ enemyElevatorStop()
\ 
\ determine what action to take when elevator stops
\
\ params:
\   X register   Enemy index
\
.enemyElevatorStop
{
    \ look for K9
    JSR getObjectDirection
    BEQ rts_16 \ enemy turning so just return

    STA direction
    JSR queryK9InSight
    BMI skip1
        \ K9 is seen, pursue k9
        JSR setPursueLeftOrRight

        LDA #ANIMATE_MOVE_LEFT
        BIT direction : BMI skip2
            LDA #ANIMATE_MOVE_RIGHT
        .skip2
        JMP enemyAnimate \ implicit RTS
    .skip1

    \ look in the other direction
    LDA direction
    EOR #&FE
    STA direction

    JSR queryK9InSight
    BMI skip3
        \ K9 is seen, turn and pursue k9
        JSR setPursueLeftOrRight

        LDA #ANIMATE_TURN_RIGHT_TO_LEFT
        BIT direction : BMI skip4
            LDA #ANIMATE_TURN_LEFT_TO_RIGHT
        .skip4
        JMP enemyAnimate \ implicit RTS
    .skip3

    \ try to move vertically
    JMP enemyPursueUpOrDown \ implicit RTS
}

\
\ setPursueLeftOrRight(X, direction)
\
\ Set pursue flag to ACTION_PURSUE_LEFT or ACTION_PURSUE_RIGHT
\
\ params:
\   X register  Enemy index
\   direction   The direction to set (minus = set ACTION_PURSUE_LEFT, positive = set ACTION_PURSUE_RIGHT)
\
.setPursueLeftOrRight
{
    ASSERT(ACTION_PURSUE_RIGHT = ACTION_PURSUE_LEFT OR ACTION_PURSUE_RIGHT)
    
    LDA objectType, X
    AND #LO(NOT(ACTION_MASK))
    ORA #ACTION_PURSUE_LEFT
    BIT direction : BMI skip
        ORA #ACTION_PURSUE_RIGHT
    .skip
    STA objectType, X
    RTS
}

\
\ queryK9InSight(X register, direction)
\
\ Returns -1 if k9 is not seen, otherwise the number of tiles to K9
\
\ params:
\   X register   Enemy index
\   direction    -1 (left direction), 1 (right direction)
\
\ modifies:
\   getObjectTileGridAddr: tileGridAddr, temp, Y
\
.queryK9InSight
{
    \ get tile grid address
    LDA #0
    BIT direction : BMI skip
        LDA #(ENEMY_SPRITE_WIDTH-1)
    .skip
    STA offsetX

    LDA #(ENEMY_SPRITE_HEIGHT-1) : STA offsetY
    JSR getObjectTileGridAddr

    \ iterate of the tiles, until something is hit
    LDY #0
    LDA #ENEMY_LOOK_RANGE : STA count
    BIT direction : BPL lookRightLoop

    .lookLeftLoop
        \ tileGridAddr -= 1
        LDA tileGridAddr
        BNE noborrow
            DEC tileGridAddr+1
        .noborrow
        DEC tileGridAddr

        LDA (tileGridAddr), Y
        AND #(TILE_GRID_FLAGS_K9 OR TILE_GRID_FLAGS_OPAQUE)
        BNE seeSomething

        DEC count
        BNE lookLeftLoop

    BEQ seeNothing

    .lookRightLoop
        INY
        LDA (tileGridAddr), Y
        AND #(TILE_GRID_FLAGS_K9 OR TILE_GRID_FLAGS_OPAQUE)
        BNE seeSomething

        DEC count
        BNE lookRightLoop

.seeNothing
    LDA #LO(-1)
    RTS
    
.seeSomething
    AND #TILE_GRID_FLAGS_K9 \ see K9?
    BEQ seeNothing
    LDA #ENEMY_LOOK_RANGE
    SEC
    SBC count
    RTS
}

\
\ setPursueVerticalAction(X register)
\
\ params:
\   A = current action
\   X = enemy index 
\
.setPursueVerticalAction
{
    CMP #ACTION_PURSUE_UP : BNE else1
        \ up -> down
        LDA #ACTION_PURSUE_DOWN
        BNE updateAction
    .else1
    CMP #ACTION_PURSUE_DOWN : BNE else2
        \ down -> up
        LDA #ACTION_PURSUE_UP
        BNE updateAction
    .else2 \ ACTION_PURSUE_LEFT or ACTION_PURSUE_RIGHT
        \ if k9 is above enemy, pursue up, otherwise pursue down
        LDA objectYLo
        CMP objectYLo, X
        LDA objectYHi
        SBC objectYHi, X
        BCS else
            LDA #ACTION_PURSUE_UP
            BNE updateAction
        .else
            LDA #ACTION_PURSUE_DOWN
            \ fall through...

.updateAction
    STA temp
    LDA objectType, X
    AND #LO(NOT(ACTION_MASK))
    ORA temp
    STA objectType, X
    RTS
}

\
\ enemyFrameCallback_TurnLeftToRight(X register) - animation frame callback
\
\ params:
\   X = enemy index 
\
.enemyFrameCallback_TurnLeftToRight
{
    \ decrement frame counter 
    DEC objectFrameCounter, X
    BNE return

    \ reset frame counter
    LDA #FRAME_COUNT_ENEMY_TURN
    STA objectFrameCounter, X

    \ set redraw flag
    JSR setRedrawFlag

    \ advance keyframe
    LDA objectSpriteIndex, X
    CMP #(SPRITE_INDEX_ENEMY_LEFT + 1) : BNE else1
        LDA #(SPRITE_INDEX_ENEMY_TURN + 2): STA objectSpriteIndex, X
        RTS
    .else1
    CMP #SPRITE_INDEX_ENEMY_TURN : BCC endif
    CMP #(SPRITE_INDEX_ENEMY_TURN + 3) : BCS endif
        DEC objectSpriteIndex, X
        LDA objectSpriteIndex, X
        CMP #(SPRITE_INDEX_ENEMY_TURN - 1) : BNE return
            LDA #(SPRITE_INDEX_ENEMY_RIGHT + 1): STA objectSpriteIndex, X
        RTS
    .endif

    \ at end of animation...

    \ select next animation
    LDA objectType, X
    AND #ACTION_MASK : BEQ else2 \ if (action != ACTION_LOOK)
        BPL skip \ if (action == ACTION_PURSUE...)
            CMP #ACTION_PURSUE_RIGHT : BEQ skip \ if (action != ACTION_PURSE_RIGHT)
                JSR setPursueVerticalAction
        .skip
        LDA #ANIMATE_MOVE_RIGHT
        BNE endif2
    .else2
        LDA #ANIMATE_LOOK_RIGHT
    .endif2
    JMP enemyAnimate \ implicit RTS

.return
    RTS
}

\
\ enemyFrameCallback_TurnRightToLeft(X register) - animation frame callback
\
\ params:
\   X = enemy index
\
.enemyFrameCallback_TurnRightToLeft
{
    \ decrement frame counter
    DEC objectFrameCounter, X
    BNE return

    \ reset frame counter
    LDA #FRAME_COUNT_ENEMY_TURN
    STA objectFrameCounter, X

    \ set redraw flag
    JSR setRedrawFlag

    \ advance keyframe
    LDA objectSpriteIndex, X
    CMP #(SPRITE_INDEX_ENEMY_RIGHT + 1) : BNE else1
        LDA #SPRITE_INDEX_ENEMY_TURN: STA objectSpriteIndex, X
        RTS
    .else1
    CMP #SPRITE_INDEX_ENEMY_TURN : BCC endif
    CMP #(SPRITE_INDEX_ENEMY_TURN + 3) : BCS endif
        INC objectSpriteIndex, X
        LDA objectSpriteIndex, X
        CMP #(SPRITE_INDEX_ENEMY_TURN + 3) : BNE return
            LDA #(SPRITE_INDEX_ENEMY_LEFT + 1): STA objectSpriteIndex, X
        RTS
    .endif

    \ at end of animation...

    \ select next animation
    LDA objectType, X
    AND #ACTION_MASK : BEQ else2 \ if (action != ACTION_LOOK)
        BPL skip \ if (action == ACTION_PURSUE...)
            CMP #ACTION_PURSUE_LEFT : BEQ skip \ if (action != ACTION_PURSE_LEFT)
                JSR setPursueVerticalAction
        .skip
        LDA #ANIMATE_MOVE_LEFT
        BNE endif2
    .else2
        LDA #ANIMATE_LOOK_LEFT
    .endif2
    JMP enemyAnimate \ implicit RTS

.return
    RTS
}

\
\ canEnemyMove helper
\
\ params:
\   X = enemy index
\
.canEnemyMove
{
    LDA objectState, X
    AND #(ENEMY_STATE_FLAGS_IMMOBILE OR OBJECT_STATE_FLAGS_ASCENDING OR OBJECT_STATE_FLAGS_DESCENDING)
    RTS
}

\
\ enemyFrameCallback_LookLeft(X register) - animation frame callback
\
\ params:
\   X = enemy index
\
.enemyFrameCallback_LookLeft
{
    \ switch animation if action != ACTION_LOOK
    LDA objectType, X 
    AND #ACTION_MASK : BEQ endif

        \ can enemy move?
        JSR canEnemyMove
        BNE endif

        LDA objectXLo, X
        AND #&F
        CMP #4 : BNE else
            \ can we pursue K9 up or down, doing so if we can
            JSR enemyPursueUpOrDown
            BEQ endif
            BNE moveLeft
        .else
        CMP #0 : BNE moveLeft
            \ can we move to the left at a tile boundary, doing so if we can
            LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY) : STA flags
            JSR querySetObjectLeftTileGridFlags : BEQ moveLeft

            \ otherwise decrement frame counter, turning if this reaches zero
            DEC objectFrameCounter, X : BNE endif
                LDA #ANIMATE_TURN_LEFT_TO_RIGHT
                JMP enemyAnimate \ implicit RTS

        .moveLeft
            \ move left
            LDA #ANIMATE_MOVE_LEFT
            JMP enemyAnimate \ implicit RTS
    .endif

    \ set redraw flag intermittently
    JMP frameCallback_IntermittentRedraw \ implicit RTS
}

\
\ enemyFrameCallback_LookRight(X register) - animation frame callback
\
\ params:
\   X = enemy index
\
.enemyFrameCallback_LookRight
{
    \ switch animation if action != ACTION_LOOK
    LDA objectType, X 
    AND #ACTION_MASK : BEQ endif

        \ can enemy move?
        JSR canEnemyMove
        BNE endif

        LDA objectXLo, X
        AND #&F
        CMP #4 : BNE else
            \ can we pursue k9 up or down, doing so if we can
            JSR enemyPursueUpOrDown
            BEQ endif
            BNE moveRight
        .else
        CMP #8 : BNE moveRight
            \ can we move to the right at a tile boundary, doing so if we can
            LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY) : STA flags
            JSR querySetObjectRightTileGridFlags : BEQ moveRight

            \ otherwise decrement frame counter, turning if this reaches zero
            DEC objectFrameCounter, X : BNE endif
                LDA #ANIMATE_TURN_RIGHT_TO_LEFT
                JMP enemyAnimate \ implicit RTS

        .moveRight
            \ move right
            LDA #ANIMATE_MOVE_RIGHT
            JMP enemyAnimate \ implicit RTS
    .endif

    \ set redraw flag intermittently
    JMP frameCallback_IntermittentRedraw \ implicit RTS
}

\
\ moveForwardSlowly(X register)
\
\ params:
\   X = enemy index
\
\ Result:
\   accumulator zero (success), non-zero (failure)
\
.moveForwardSlowly
{
    \ move slowly if health < ENEMY_SPRINT_THRESHOLD
    LDA objectState, X
    AND #ENEMY_STATE_HEALTH_MASK
    CMP #ENEMY_SPRINT_THRESHOLD
    BCC moveSlowly

    \ move slowly if action != ACTION_PURSUE
    LDA objectType, X
    BPL moveSlowly

    \ return success
    LDA #0 
    RTS

.moveSlowly
    \ return true/false every other frame
    TXA
    CLC
    ADC frameCount
    AND #1

    \ fall through to RTS
}

\
\ common RTS
\
.rts_13
{
    RTS
}

\
\ clearResidualTileFlags(X)
\
\ if we were at the start of a move animation which set the
\ left or right tile flags, we need to clear these flags
\
\ params:
\   X register  Enemy index
\
\ modifies:
\   flags
\
.clearResidualTileFlags
{
    \ set flags
    LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY) : STA flags

    \ at start of animation?
    LDA objectFrameCounter, X : BNE rts_13

    \ Y register = object[X].XPos MOD 16
    LDA objectXLo, X
    AND #&F
    TAY

    \ if (animation == MOVE_LEFT)
    LDA objectType, X
    AND #ANIMATE_MASK
    CMP #ANIMATE_MOVE_LEFT : BNE else
        \ if (object[X].XPos MOD 16) == 0)
        TYA : BNE rts_13
            \ clear left tile flags
            JMP clearObjectLeftTileFlags \ implcit RTS
    .else
    \ if (animation == MOVE_RIGHT && (object[X].XPos MOD 16) == 8)
    CMP #ANIMATE_MOVE_RIGHT : BNE rts_13
        \ if (object[X].XPos MOD 16) == 8)
        TYA : CMP #8 : BNE rts_13
            \ clear right tile flags
            JMP clearObjectRightTileFlags \ implicit RTS
}

\
\ enemyPursueUpOrDown(X register)
\
\ params:
\   X = enemy index
\
\ Result:
\   accumulator zero (riding elevator), non-zero (not riding elevator)
\
.enemyPursueUpOrDown
{
    LDA objectType, X
    AND #ACTION_MASK 
    CMP #ACTION_PURSUE_UP : BNE else
        LDA #LO(DIRECTION_UP)
        BNE ride
    .else
    CMP #ACTION_PURSUE_DOWN : BNE endif
        LDA #LO(DIRECTION_DOWN)
        BNE ride
    .endif

    \ failure
    LDA #1
    RTS

.ride
    STA direction
    JSR rideElevator
    BNE skip1
        \ if the enemy is on an elevator which can't move we need to reset 
        \ the end pursuit counter to ensure that the pursuit continues
        LDA objectState, X
        AND #(OBJECT_STATE_FLAGS_ASCENDING OR OBJECT_STATE_FLAGS_DESCENDING)
        BNE skip2
            LDA #ENEMY_END_PURSUIT_COUNTER
            STA endPursuitCounter
        .skip2
        LDA #0 \ pass on success
    .skip1
    RTS
}

\
\ enemyFrameCallback_MoveLeft(X register) - animation frame callback
\
\ params:
\   X = enemy index
\
.enemyFrameCallback_MoveLeft
{
    \ move forward slowly?
    JSR moveForwardSlowly
    BNE return

    \ increment frame counter
    INC objectFrameCounter, X

    \ decrement enemyX
    LDA objectXLo, X
    BNE skip1
        DEC objectXHi, X
    .skip1
    DEC objectXLo, X

    \ set keyframe, set redraw, continue animation?, and accumulator = objectXLo[X] AND &F
    LDA #SPRITE_INDEX_ENEMY_LEFT
    JSR frameCallback_MoveHorz
    BCS return

    \ clear vacated tile flags
    CMP #8 : BNE skip2
        LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY) : STA flags
        JSR clearObjectRightTileFlags
    .skip2

    \ can enemy move?
    JSR canEnemyMove
    BNE lookLeft

    \ select next animation...
    LDA objectType, X
    AND #ACTION_MASK : BEQ lookLeft \ if (action != ACTION_LOOK)
    
        LDA objectXLo, X
        AND #&F
        CMP #4 : BNE else
            \ can we pursue K9 up or down, doing so if we can
            JSR enemyPursueUpOrDown
            BNE moveLeft
            BEQ lookLeft

        .else
        CMP #0 : BNE moveLeft
            \ can we move to the left at a tile boundary, doing so if we can
            LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY) : STA flags
            JSR querySetObjectLeftTileGridFlags : BEQ moveLeft

            \ otherwise turn or wait
            CMP #TILE_TYPE_SPACE : BEQ lookLeft

            \ turn left to right
            LDA #ANIMATE_TURN_LEFT_TO_RIGHT
            BNE enemyAnimate \ implicit RTS

        .moveLeft
            \ move left
            LDA #ANIMATE_MOVE_LEFT
            BNE enemyAnimate \ implicit RTS

        .lookLeft
            \ look left
            LDA #ANIMATE_LOOK_LEFT
            BEQ enemyAnimate \ implicit RTS
.return
    RTS
}

\
\ enemyFrameCallback_MoveRight(X register) - animation frame callback
\
\ params:
\   X = enemy index
\
.enemyFrameCallback_MoveRight
{
    \ move forward slowly?
    JSR moveForwardSlowly
    BNE return

    \ increment frame counter
    INC objectFrameCounter, X

    \ increment enemyX
    INC objectXLo, X
    BNE skip1
        INC objectXHi, X
    .skip1

    \ set keyframe, set redraw, continue animation?, and accumulator = objectXLo[X] AND &F
    LDA #SPRITE_INDEX_ENEMY_RIGHT
    JSR frameCallback_MoveHorz
    BCS return

    \ clear vacated tile flags
    BNE skip2
        LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY) : STA flags
        JSR clearObjectLeftTileFlags
    .skip2
    
    \ can enemy move?
    JSR canEnemyMove
    BNE lookRight
    
    \ select next animation...
    LDA objectType, X
    AND #ACTION_MASK : BEQ lookRight \ if (action != ACTION_LOOK)
        LDA objectXLo, X
        AND #&F
        CMP #4 : BNE else
            \ can we pursue K9 up or down, doing so if we can
            JSR enemyPursueUpOrDown
            BNE moveRight
            BEQ lookRight

        .else
        CMP #8 : BNE moveRight
            \ can we move to the right at a tile boundary, doing so if we can
            LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY): STA flags
            JSR querySetObjectRightTileGridFlags : BEQ moveRight

            \ otherwise turn or wait
            CMP #TILE_TYPE_SPACE : BEQ lookRight

            \ turn right to left
            LDA #ANIMATE_TURN_RIGHT_TO_LEFT
            BNE enemyAnimate \ implicit RTS

        .moveRight
            \ move right
            LDA #ANIMATE_MOVE_RIGHT
            BNE enemyAnimate \ implicit RTS

        .lookRight 
            \ look right
            LDA #ANIMATE_LOOK_RIGHT
            BNE enemyAnimate \ implicit RTS

.return
    RTS
}

\
\ enemyAnimate(A, X)
\
\ params:
\   A = ANIMATE_LOOK_LEFT etc.
\   X = enemy index
\
.enemyAnimate
{
    PHA \ --> new animation

    \ if we were at the start of a move animation which set the
    \ left or right tile flags, we need to clear these flags
    JSR clearResidualTileFlags \ also sets flags

    \ temp = new animation
    PLA
    AND #ANIMATE_MASK
    STA temp

    \ set animation properties
    LSR A : LSR A
    TAY
    LDA spriteIndexTbl, Y : STA objectSpriteIndex, X
    LDA frameCountTbl, Y : STA objectFrameCounter, X
    LDA frameCallbackLoTbl, Y : STA objectFrameCallbackLo, X
    LDA frameCallbackHiTbl, Y : STA objectFrameCallbackHi, X

    \ update objectType animation
    LDA objectType, X
    AND #LO(NOT(ANIMATE_MASK))
    ORA temp
    STA objectType, X

    \ if turning, round position to nearist multiple of four
    \ ensuring that right tile flags are cleared if needed
    AND #ANIMATE_MASK
    CMP #ANIMATE_TURN_LEFT_TO_RIGHT : BEQ then1
    CMP #ANIMATE_TURN_RIGHT_TO_LEFT : BNE endif1
    .then1
        JSR roundFourObjectPosition \ implicit RTS
    .endif1
    RTS

.spriteIndexTbl
    EQUB SPRITE_INDEX_ENEMY_LEFT, SPRITE_INDEX_ENEMY_RIGHT         \ look
    EQUB SPRITE_INDEX_ENEMY_LEFT, SPRITE_INDEX_ENEMY_RIGHT         \ move
    EQUB SPRITE_INDEX_ENEMY_LEFT + 1, SPRITE_INDEX_ENEMY_RIGHT + 1 \ turn

.frameCountTbl
    EQUB FRAME_COUNT_ENEMY_WAIT, FRAME_COUNT_ENEMY_WAIT            \ look
    EQUB 0, 0                                                      \ move
    EQUB FRAME_COUNT_ENEMY_TURN, FRAME_COUNT_ENEMY_TURN            \ turn
         
.frameCallbackLoTbl
    EQUB LO(enemyFrameCallback_LookLeft), LO(enemyFrameCallback_LookRight)              \ look
    EQUB LO(enemyFrameCallback_MoveLeft), LO(enemyFrameCallback_MoveRight)              \ move
    EQUB LO(enemyFrameCallback_TurnLeftToRight), LO(enemyFrameCallback_TurnRightToLeft) \ turn

.frameCallbackHiTbl
    EQUB HI(enemyFrameCallback_LookLeft), HI(enemyFrameCallback_LookRight)              \ look
    EQUB HI(enemyFrameCallback_MoveLeft), HI(enemyFrameCallback_MoveRight)              \ move
    EQUB HI(enemyFrameCallback_TurnLeftToRight), HI(enemyFrameCallback_TurnRightToLeft) \ turn
}

\
\ enemyLaserHitTest(leftLo, topLo)
\
\ finds the enemy located at leftLo, topLo, and 
\
\ params:
\   leftLo, topLo Screen position
\
\ modifies:
\   leftLo/Hi, topLo/Hi, rightLo/Hi, bottomLo/Hi, index
\
.enemyLaserHitTest
{
    \ left = leftLo + scrnLeft
    LDA leftLo
    CLC
    ADC scrnLeftLo
    STA leftLo
    LDA #0
    ADC scrnLeftHi
    STA leftHi

    \ top = topLo + scrnTop
    LDA topLo
    CLC
    ADC scrnTopLo
    STA topLo
    LDA #0
    ADC scrnTopHi
    STA topHi

    \ right = left - (ENEMY_SPRITE_WIDTH - 1)
    LDA leftLo
    SEC
    SBC #(ENEMY_SPRITE_WIDTH - 1)
    STA rightLo
    LDA leftHi
    SBC #0
    STA rightHi

    \ bottom = top - (ENEMY_SPRITE_HEIGHT - 1)
    LDA topLo
    SEC
    SBC #(ENEMY_SPRITE_HEIGHT - 1)
    STA bottomLo
    LDA topHi
    SBC #0
    STA bottomHi

    \ iterate over all enemies looking for an intersection
    LDA enemyCount : STA index

    \ check last found first
    LDX enemyHitTestLastFound
    BEQ skip1
        INC index
        JMP checkLastFound
    .skip1

    .loop
        LDX index

        .checkLastFound

        \ if (health == 0) continue
        LDA objectState, X
        AND #ENEMY_STATE_HEALTH_MASK
        BEQ continue

        \ if (left < objectX) continue
        LDA leftLo
        CMP objectXLo, X
        LDA leftHi
        SBC objectXHi, X
        BCC continue

        \ if (top < objectY) continue
        LDA topLo
        CMP objectYLo, X
        LDA topHi
        SBC objectYHi, X
        BCC continue

        \ if (right > objectX) continue
        LDA objectXLo, X
        CMP rightLo
        LDA objectXHi, X
        SBC rightHi
        BCC continue

        \ if (bottom > objectY) continue, otherwise found!
        LDA objectYLo, X
        CMP bottomLo
        LDA objectYHi, X
        SBC bottomHi
        BCS found

        .continue
        DEC index
        BNE loop

    \ enemy not found!
    RTS

.found

    \ update last found and reset enemy health (low-byte)
    CPX enemyHitTestLastFound : BEQ skip2
        STX enemyHitTestLastFound
        LDA #&FF : STA enemyHealthLo
    .skip2

    \ fall through to enemyLaserHit
}

\
\ enemyLaserHit(X register)
\
\ enemy hit with laser
\
\ params:
\   X register   Enemy index
\
.enemyLaserHit
{
    \ reduce enemy health
    LDA enemyHealthLo
    SEC
    SBC laserStrength
    STA enemyHealthLo

    LDA objectState, X
    AND #ENEMY_STATE_HEALTH_MASK
    SBC #0
    BCS skip0
        LDA #0
    .skip0
    STA temp \ --> remaining health

    \ update state
    LDA objectState, X
    AND #(OBJECT_STATE_FLAGS_MASK OR ENEMY_STATE_FLAGS_IMMOBILE)
    ORA temp \ <-- remaining health
    ORA #(OBJECT_STATE_FLAGS_LASERED OR OBJECT_STATE_FLAGS_REDRAW)
    STA objectState, X

    \ cache enemy extents
    JSR cacheObjectExtents

    \ enemy destroyed?
    LDA temp \ <-- remaining health
    BNE skip1

        \ erase sprite
        LDA #&FF : STA objectSpriteIndex, X

        \ action = ACTION_LOOK
        JSR enemySetActionLook

        \ stop laser
        INC laserInhibited

        \ set frame callback so it just returns
        LDA #LO(rts_0) : STA objectFrameCallbackLo, X
        LDA #HI(rts_0) : STA objectFrameCallbackHi, X

        \ if we were at the start of a move animation which set the
        \ left or right tile flags, we need to clear these flags
        JSR clearResidualTileFlags \ also sets flags 

        \ clear inside tile flags
        JSR clearObjectInsideTileFlags 

        \ end pursuit sound effect?
        JSR silencePursuitSoundEffect 
        
        \ invoke enemy destroyed sound effect
        JMP (secondarySoundVector_enemyDestroyed) \ implicit RTS
    .skip1

    \ does enemy have sufficient remaining health to pursue or use weapon?
    LDA temp \ <-- remaining health
    CMP #(ENEMY_WEAPON_THRESHOLD + 1)
    BCC enemySetActionLook \ implicit RTS
    
    \ is enemy lasered from behind? (check if K9 and enemy are facing in same direction)
    JSR getObjectDirection
    STA direction
    JSR getK9Direction
    CMP direction
    BNE skip3
        \ turn...
        LDA #ANIMATE_TURN_RIGHT_TO_LEFT
        BIT direction : BPL skip4
            LDA #ANIMATE_TURN_LEFT_TO_RIGHT
        .skip4
        JSR enemyAnimate
    .skip3

    \ invoke enemy lasered sound effect
    JMP (primarySoundVector_enemyLasered) \ implict RTS
}

\
\ enemySetActionLook(X)
\
\ set an enemies action to ACTION_LOOK
\
\ params:
\   X register   Enemy index
\
.enemySetActionLook
{
    \ action = ACTION_LOOK
    LDA objectType, X
    AND #LO(NOT(ACTION_MASK))
    STA objectType, X
    RTS
}

\ end file