\
\ Mode 7 routines
\

\
\ setMode7()
\
\ switch to mode 7 (with no blinking cursor)
\
.setMode7
{
    LDY #11
    .loop
        LDA vduCommands, Y
        JSR oswrch
        DEY
        BPL loop
    RTS

.vduCommands \ declared in reverse order
    EQUB 0, 0, 0
    EQUB 0, 0, 0
    EQUB 32, 10, 0, 23  \ set 6845 register R10 = 32
    EQUB 7, 22          \ set mode 7
}

\
\ memcpyToScreen(srcAddr)
\
\ params:
\   srcAddr Source address
\
\ Modifies:
\   dstAddr, srcAddr
\
.memcpyToScreen
{
    LDA #LO(&7C00) : STA dstAddr
    LDA #HI(&7C00): STA dstAddr+1

    \ copy pages
    LDX #HI(1000)
    .loop1
        LDY #0
        .innerloop
            LDA (srcAddr),Y
            STA (dstAddr),Y
            INY
            BNE innerloop

        INC srcAddr+1
        INC dstAddr+1

        DEX
        BNE loop1

    \ copy sub-page
    LDX #LO(1000)
    LDY #0
    .loop2
        LDA (srcAddr),Y
        STA (dstAddr),Y
        INY

        DEX
        BNE loop2
    RTS
}

\
\ waitForSpaceKeyPress
\
\ waits for the space key to be pressed
\
.waitForSpaceKeyPress
{
    \ wait for release
    .releaseLoop
        LDX #SCAN_KEYS_SPACE
        JSR scanKeys
        LDA keyTbl + KEY_SPACE
        BMI releaseLoop

    \ wait for press
    .pressLoop
        LDX #SCAN_KEYS_SPACE
        JSR scanKeys
        LDA keyTbl + KEY_SPACE
        BPL pressLoop
    RTS
}

\ end file