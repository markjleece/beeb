\
\ Sound routines (sound definitions are defined in titles.6502)
\

\ sound API params
.soundParams EQUB 0, 0, 0, 0, 0, 0, 0, 0

\
\ silenceSoundEffects()
\
.silenceSoundEffects
{
    LDA #SOUND_EFFECT_LASER_OFF
    JSR soundEffect
    JMP endPursuitSoundEffect
}

\
\ pursuitSoundEffect
\
\ sound pursuit sound effect (once)
\
.pursuitSoundEffect
{
    \ sound pursuit sound effect once
    LDA pursuitSoundEffectCounter : BNE rts_3
        LDA #SAMPLE_EXTERMINATE_FRAME_COUNT : STA pursuitSoundEffectCounter

        .^primarySoundVector_beginPursuit \ address patched in initializeSound (level.6502)
        JMP &FFFF \ implicit RTS
}

\
\ levelCompleteSoundEffect()
\
\ sound level complete sound effect
\
.levelCompleteSoundEffect
{
    .^secondarySoundVector_levelComplete \ address patched in initializeSound (level.6502)
    JMP &FFFF \ implicit RTS
}

\
\ secondarySoundEffect_levelComplete()
\
\ invoked via secondarySoundVector_levelComplete
\
.secondarySoundEffect_levelComplete
{
    LDA #SOUND_EFFECT_LEVEL_COMPLETE
    BNE soundEffect \ implicit RTS
}

\
\ primarySoundEffect_beginPursuit()
\
\ invoked by primarySoundVector_beginPursuit
\
.primarySoundEffect_beginPursuit
{
    \ ignore if a sample is playing
    LDA playingSample : BNE rts_3

    LDA #SOUND_EFFECT_PURSUIT_ON
    BNE soundEffect \ implicit RTS
}

\
\ primarySoundEffect_endPursuit()
\
\ invoked via primarySoundVector_endPursuit
\
.primarySoundEffect_endPursuit
{
    LDA #SOUND_EFFECT_PURSUIT_OFF
    BNE soundEffect \ implicit RTS
}

\
\ primarySoundEffect_weaponFired()
\
\ invoked via primarySoundVector_weaponFired
\
.primarySoundEffect_weaponFired
{
    LDA #SOUND_EFFECT_PAIN
    BEQ soundEffect \ implicit RTS
}

\
\ primarySoundEffect_updatePursuit()
\
\ invoked via primarySoundVector_updatePursuit
\
.primarySoundEffect_updatePursuit
{
    \ fall through to RTS
}

\
\ primarySoundEffect_enemyLasered()
\
\ invoked via primarySoundVector_enemyLasered
\
.primarySoundEffect_enemyLasered
{
    \ fall through to RTS
}

\
\ secondarySoundEffect_enemyDestroyed()
\
\ invoked via secondarySoundVector_enemyDestroyed
\
.secondarySoundEffect_enemyDestroyed
{
    \ fall through to RTS
}

\
\ secondarySoundEffect_levelStart()
\
\ invoked via secondarySoundVector_levelStart
\
.secondarySoundEffect_levelStart
{
    RTS
}

\ 
\ updateSoundEffects
\
\ called every frame to update sound effects
\
.updateSoundEffects
{
    \ release tone generator 3?
    LDA playingSample : BPL skip1 \ CMP #SAMPLE_PLAYBACK_STOPPED : BNE skip
        
        \ playingSample = SAMPLE_PLAYBACK_NONE
        LDA #SAMPLE_PLAYBACK_NONE : STA playingSample

        \ release tone generator 3
        JSR releaseToneGenerator3
    .skip1

    \ decrement inhibitMoveSoundEffect (used to inhibit move sound effect)
    LDA inhibitMoveSoundEffect : BEQ endif1
        DEC inhibitMoveSoundEffect
    .endif1

    \ low battery/health sound effect...
    LDA healthHi
    CMP #LOW_HEALTH_HI : BCS endif2

        \ sound low battery/health beep every 64 frames, but not if the laser sound effect is playing
        LDA frameCount
        AND #&3F
        ORA laserSoundEffectOn
        BNE endif2

        LDA #SOUND_EFFECT_LOW_BATTERY
        BNE soundEffect \ implicit RTS
    .endif2

    \ invoke begin level sound effect after level open transition completes
    LDA playBeginLevelSoundEffect : BEQ skip2
    LDA transitionState : BNE skip2
        LSR playBeginLevelSoundEffect \ = 0

        .^secondarySoundVector_levelStart \ address patched in initializeSound (level.6502)
        JMP &FFFF \ implicit RTS
    .skip2

    \ update pursuit sound effects
    .^primarySoundVector_updatePursuit \ address patched in initializeSound (level.6502)
    JMP &FFFF \ implicit RTS
}

\
\ achievementSoundEffect
\
\ sound achievement sound effect
\
.achievementSoundEffect
{
    \ inhibit move sound effects, which use the same channel
    LDA #INHIBIT_MOVE_SOUND_EFFECT_FRAME_COUNT : STA inhibitMoveSoundEffect

    LDA #SOUND_EFFECT_ACHIEVEMENT
    BNE soundEffect \ implicit RTS
}

\
\ laserSoundEffect
\
\ sound laser sound effect (once)
\
.laserSoundEffect
{
    LDA laserSoundEffectOn : BNE rts_3
        INC laserSoundEffectOn
        LDA #SOUND_EFFECT_LASER_ON
        \ fall through to soundEffect
}

\
\ soundEffect(A)
\
\ Calls OS sound API with a sound effect, whilst preserving X register
\
\ params:
\   A (accumulator)   SOUND_EFFECT_PAIN..SOUND_EFFECT_PURSUIT_OFF
\
\ modifies:
\   soundParams, Y
\
.soundEffect
{
    TAY
    TXA : PHA \ preserve X

    \ populate sound params
    LDX #0
    .loop
        LDA soundEffects, Y
        INY
        STA soundParams, X
        INX 
        INX
        CPX #8
        BNE loop

    \ invoke OS sound API
    LDX #LO(soundParams)
    LDY #HI(soundParams)
    LDA #7             
    JSR osword

    PLA : TAX \ restore X

    \ fall through to RTS
}

\
\ common RTS
\
.rts_3
{
    RTS
}

\
\ silenceLaserSoundEffect
\
\ silence laser sound effect (once)
\
.silenceLaserSoundEffect
{
    LDA laserSoundEffectOn : BEQ rts_3
        DEC laserSoundEffectOn
        LDA #SOUND_EFFECT_LASER_OFF
        BNE soundEffect \ implicit RTS
}

\
\ silencePursuitSoundEffect
\
\ silence the pursuit sound effect (once)
\
.silencePursuitSoundEffect
{
    LDA pursuitSoundEffectCounter : BEQ rts_3
        LDA #0 : STA pursuitSoundEffectCounter
        \ fall through to endPursuitSoundEffect
}

\
\ endPursuitSoundEffect
\
\ silence the end pursuit sound effect
\
.endPursuitSoundEffect
{
   .^primarySoundVector_endPursuit \ address patched in initializeSound (level.6502)
   JMP &FFFF \ implicit RTS
}

\
\ enemyDestroyedSoundEffect()
\
\ sound enemy destroyed sound effect
\
.enemyDestroyedSoundEffect
{
    .^secondarySoundVector_enemyDestroyed \ address patched in initializeSound (level.6502)
    JMP &FFFF \ implicit RTS
}

\
\ enemyLaseredSoundEffect()
\
\ sound enemy lasered sound effect
\
.enemyLaseredSoundEffect
{
    .^primarySoundVector_enemyLasered \ address patched in initializeSound (level.6502)
    JMP &FFFF \ implicit RTS
}

\
\ weaponFiredSoundEffect()
\
\ sound weapon fired sound effect
\
.weaponFiredSoundEffect
{
    .^primarySoundVector_weaponFired \ address patched in initializeSound (level.6502)
    JMP &FFFF \ implicit RTS
}

\
\ blockedSoundEffect
\
.blockedSoundEffect
{
    LDA blockedSoundEffectOn : BNE rts_3
        INC blockedSoundEffectOn

        \ inhibit move sound effect, which uses the same channel
        LDA #INHIBIT_MOVE_SOUND_EFFECT_FRAME_COUNT : STA inhibitMoveSoundEffect
  
        LDA #SOUND_EFFECT_BLOCKED
        BNE soundEffect \ implicit RTS
}

\
\ moveSoundEffect
\
\ sound move effect
\
.moveSoundEffect
{
    LDA inhibitMoveSoundEffect : BNE rts_3
        LDA #SOUND_EFFECT_MOVE
        BNE soundEffect \ implicit RTS
}

\
\ teleportSoundEffect
\
\ sound teleport sound effect
\
.teleportSoundEffect
{
    LDA #SOUND_EFFECT_TELEPORT
    BNE soundEffect \ implicit RTS
}

\
\ acquireToneGenerator3()
\
\ called by sample code to acquire tone generator 3
\
.acquireToneGenerator3
{
    \
    \ set up tone generator 3 for sample-based playback
    \
    SEI \ disable interrupts

    LDA #&9F \ zero volume
    JSR sendSoundData

    LDA #&81 \ highest frequency (low-byte)
    JSR sendSoundData

    LDA #0 \ highest frequency (high-byte)
    JSR sendSoundData

    CLI \ re-enable interrupts

    \
    \ pause MOS pursuit sound effect, if its playing
    \
    LDA primarySamplesEnabled : BNE rts_3
    LDA pursuitSoundEffectCounter : BEQ rts_3
    JMP primarySoundEffect_endPursuit \ implicit RTS
}

\
\ releaseToneGenerator3()
\
\ called indirectly by sample code when its finished with tone generator 3
\
.releaseToneGenerator3
{
    \
    \ restore tone generator 3 for MOS sounds
    \
    SEI \ disable interrupts

    LDA #&9F \ zero volume
    JSR sendSoundData

    LDA #&84 \ lowest note frequency (low-byte)
    JSR sendSoundData

    LDA #&3F \ lowest note frequency (high-byte)
    JSR sendSoundData

    CLI \ re-enable interrupts

    \
    \ resume MOS pursuit sound effect, if it should be playing
    \
    LDA primarySamplesEnabled : BNE rts_3
    LDA pursuitSoundEffectCounter : BEQ else
        JMP primarySoundEffect_beginPursuit \ implicit RTS
    .else
        JMP primarySoundEffect_endPursuit \ implicit RTS
}

\
\ sendSoundData(A)
\
\ send sound data to SN76489 sound chip
\
\ params: 
\   A (accumulator)     Sound data
\
.sendSoundData
{
    PHA \ --> sound data

    \ set data direction register A (write &FF to &FE43)
    LDA #&FF
    STA &FE43

    \ output register A (write sound data to &FE4F)
    PLA \ <-- sound data
    STA &FE4F

    \ output register B, prepping write by setting chip write pin low (write 0 to &FE40)
    LDA #0
    STA &FE40

    \ keep the write enable line low for at least 8 us, 16 cycles
    LDA #&44     \ 2 cycles
    .loop
        LSR A    \ 6 cycles
        BCC loop \ 8 cycles
                                                        
    \ write data by setting chip write pin high (write 8 to &FE40)
    STA &FE40
     
    RTS                                                 
}

\ end file