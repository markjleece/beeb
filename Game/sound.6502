\
\ Sound routines (sound definitions are defined in titles.6502)
\

\ sample tables (generated by WAVConverter)
.pcmDataStartAddrLoTbl EQUB &9D, &D3, &2E, &26, &96, &5B
.pcmDataStartAddrHiTbl EQUB &AA, &9C, &83, &B5, &A7, &80
.pcmDataEndAddrHiTbl   EQUB &BF, &AA, &9C, &BF, &B5, &A7

\ sound effect vectors (set in initializeSound)
.primarySoundVectors                        \ REGULAR SOUNDS             SAMPLE-BASED SOUNDS
.primarySoundVector_updatePursuit    SKIP 2 \ soundEffect_updatePursuit  sample_updatePursuit
.primarySoundVector_beginPursuit     SKIP 2 \ soundEffect_beginPursuit   sample_beginPursuit
.primarySoundVector_endPursuit       SKIP 2 \ soundEffect_endPursuit     sample_endPursuit
.primarySoundVector_enemyLasered     SKIP 2 \ soundEffect_enemyLasered   sample_enemyLasered
.primarySoundVector_weaponFired      SKIP 2 \ soundEffect_weaponFired    sample_weaponFired
                                            
.secondarySoundVectors                      \ REGULAR SOUNDS             SAMPLE-BASED SOUNDS
.secondarySoundVector_enemyDestroyed SKIP 2 \ soundEffect_enemyDestroyed sample_enemyDestroyed
.secondarySoundVector_beginLevel     SKIP 2 \ soundEffect_levelStart     sample_levelStart
.secondarySoundVector_levelComplete  SKIP 2 \ soundEffect_levelComplete  sample_levelComplete

\ sound API params
.soundParams EQUB 0, 0, 0, 0, 0, 0, 0, 0

\
\ silenceSoundEffects()
\
.silenceSoundEffects
{
    LDA #SOUND_EFFECT_LASER_OFF
    JSR soundEffect
    JMP (primarySoundVector_endPursuit) \ implicit RTS
}

\
\ pursuitSoundEffect
\
\ sound pursuit sound effect (once)
\
.pursuitSoundEffect
{
    \ sound pursuit sound effect once
    LDA pursuitSoundEffectCounter : BNE rts_3
        LDA #SAMPLE_EXTERMINATE_FRAME_COUNT : STA pursuitSoundEffectCounter
        JMP (primarySoundVector_beginPursuit) \ implicit RTS
}

\
\ levelCompleteSoundEffect()
\
\ sound level complete sound effect
\
.levelCompleteSoundEffect
{
    JMP (secondarySoundVector_levelComplete) \ implicit RTS
}

\
\ soundEffect_levelComplete()
\
\ invoked via secondarySoundVector_levelComplete
\
.soundEffect_levelComplete
{
    LDA #SOUND_EFFECT_LEVEL_COMPLETE
    BNE soundEffect \ implicit RTS
}

\
\ soundEffect_beginPursuit()
\
\ invoked via primarySoundVector_beginPursuit
\
.soundEffect_beginPursuit
{
    LDA #SOUND_EFFECT_PURSUIT_ON
    BNE soundEffect \ implicit RTS
}

\
\ soundEffect_endPursuit()
\
\ invoked via primarySoundVector_endPursuit
\
.soundEffect_endPursuit
{
    LDA #SOUND_EFFECT_PURSUIT_OFF
    BNE soundEffect \ implicit RTS
}

\
\ soundEffect_weaponFired()
\
\ invoked via primarySoundVector_weaponFired
\
.soundEffect_weaponFired
{
    LDA #SOUND_EFFECT_PAIN
    BEQ soundEffect \ implicit RTS
}

\
\ soundEffect_updatePursuit()
\
\ invoked via primarySoundVector_updatePursuit
\
.soundEffect_updatePursuit
{
    \ fall through to RTS
}

\
\ soundEffect_enemyLasered()
\
\ invoked via primarySoundVector_enemyLasered
\
.soundEffect_enemyLasered
{
    \ fall through to RTS
}

\
\ soundEffect_enemyDestroyed()
\
\ invoked via secondarySoundVector_enemyDestroyed
\
.soundEffect_enemyDestroyed
{
    \ fall through to RTS
}

\
\ soundEffect_levelStart()
\
\ invoked via secondarySoundVector_levelStart
\
.soundEffect_levelStart
{
    RTS
}

\ 
\ updateSoundEffects
\
\ called every frame to update sound effects
\
.updateSoundEffects
{
    \ has sample stopped?
    LDA playingSample : BPL skip \ CMP #SAMPLE_PLAYBACK_STOPPED : BNE skip

        \ reset playingSamples
        LDA #SAMPLE_PLAYBACK_NONE : STA playingSample

        \ release tone generator 3
        JSR releaseToneGenerator3
    .skip

    \ decrement inhibitMoveSoundEffect (used to inhibit move sound effect)
    LDA inhibitMoveSoundEffect : BEQ endif1
        DEC inhibitMoveSoundEffect
    .endif1

    \ heart beat sound effect...
    LDA healthHi
    CMP #LASER_HEALTH_THRESHOLD_HI : BCS endif2

        \ sound heart beat every 64 frames, but not if the laser sound effect is playing
        LDA frameCount
        AND #&3F
        ORA laserSoundEffectOn
        BNE endif2

        LDA #SOUND_EFFECT_HEART_BEAT
        BNE soundEffect \ implicit RTS
    .endif2

    \ update pursuit sound effects
    JMP (primarySoundVector_updatePursuit) \ implicit RTS
}

\
\ achievementSoundEffect
\
\ sound achievement sound effect
\
.achievementSoundEffect
{
    \ inhibit move sound effects, which use the same channel
    LDA #INHIBIT_MOVE_SOUND_EFFECT_FRAME_COUNT : STA inhibitMoveSoundEffect

    LDA #SOUND_EFFECT_ACHIEVEMENT
    BNE soundEffect \ implicit RTS
}

\
\ laserSoundEffect
\
\ sound laser sound effect (once)
\
.laserSoundEffect
{
    LDA laserSoundEffectOn : BNE rts_3
        INC laserSoundEffectOn
        LDA #SOUND_EFFECT_LASER_ON
        \ fall through to soundEffect
}

\
\ soundEffect(A)
\
\ Calls OS sound API with a sound effect, whilst preserving X register
\
\ params:
\   A (accumulator)   SOUND_EFFECT_PAIN..SOUND_EFFECT_PURSUIT_OFF
\
\ modifies:
\   soundParams, Y
\
.soundEffect
{
    TAY
    TXA : PHA \ preserve X

    \ populate sound params
    LDX #0
    .loop
        LDA soundEffects, Y
        INY
        STA soundParams, X
        INX 
        INX
        CPX #8
        BNE loop

    \ invoke OS sound API
    LDX #LO(soundParams)
    LDY #HI(soundParams)
    LDA #7             
    JSR osword

    PLA : TAX \ restore X

    \ fall through to RTS
}

\
\ common RTS
\
.rts_3
{
    RTS
}

\
\ silenceLaserSoundEffect
\
\ silence laser sound effect (once)
\
.silenceLaserSoundEffect
{
    LDA laserSoundEffectOn : BEQ rts_3
        DEC laserSoundEffectOn
        LDA #SOUND_EFFECT_LASER_OFF
        BNE soundEffect \ implicit RTS
}

\
\ silencePursuitSoundEffect
\
\ silence the pursuit sound effect, first checking that no enemies are in pursuit
\
.silencePursuitSoundEffect
{
    \ do nothing if any enemy is in pursuit
    LDX enemyCount
    BEQ loopEnd
    .loop
        LDA objectType, X : BMI rts_3
        DEX
        BNE loop
    .loopEnd

    \ silence sound effect (once)
    LDA pursuitSoundEffectCounter : BEQ rts_3
        STX endPursuitCounter \ reset counter
        STX pursuitSoundEffectCounter \ reset counter
        JMP (primarySoundVector_endPursuit) \ implicit RTS
}

\
\ blockedSoundEffect
\
.blockedSoundEffect
{
    LDA blockedSoundEffectOn : BNE rts_3
        INC blockedSoundEffectOn

        \ inhibit move sound effect, which uses the same channel
        LDA #INHIBIT_MOVE_SOUND_EFFECT_FRAME_COUNT : STA inhibitMoveSoundEffect
  
        LDA #SOUND_EFFECT_BLOCKED
        BNE soundEffect \ implicit RTS
}

\
\ moveSoundEffect
\
\ sound move effect
\
.moveSoundEffect
{
    LDA inhibitMoveSoundEffect : BNE rts_3
        LDA #SOUND_EFFECT_MOVE
        BNE soundEffect \ implicit RTS
}

\
\ moveSoundToggle
\
\ toggle move sound effect volume
\
.moveSoundToggle
{
    soundEffectVolumeAddr = soundEffects + SOUND_EFFECT_MOVE + 1
    LDA soundEffectVolumeAddr
    EOR #&FE
    STA soundEffectVolumeAddr
    RTS
}

\
\ acquireToneGenerator3()
\
\ called by sample code to acquire tone generator 3
\
.acquireToneGenerator3
{
    \
    \ set up tone generator 3 for sample-based playback
    \
    SEI \ disable interupts

    LDA #&9F \ zero volume
    JSR sendSoundData

    LDA #&81 \ highest frequency (low-byte)
    JSR sendSoundData

    LDA #0 \ highest frequency (high-byte)
    JSR sendSoundData

    CLI \ re-enable interrupts

    \
    \ pause pursuit MOS sound effect, if its playing (on tone generator 3)
    \
    LDA endPursuitCounter : BEQ rts_3
    LDA primarySamplesEnabled : BNE rts_3
    JMP soundEffect_endPursuit \ implicit RTS
}

\
\ releaseToneGenerator3()
\
\ called indirectly by sample code when its finished with tone generator 3
\
.releaseToneGenerator3
{
    \
    \ restore tone generator 3 for MOS sounds
    \
    SEI \ disable interupts

    LDA #&9F \ zero volume
    JSR sendSoundData

    LDA #&8F \ lowest frequency (low-byte)
    JSR sendSoundData

    LDA #&3F \ lowest frequency (high-byte)
    JSR sendSoundData

    CLI \ re-enable interrupts

    \
    \ resume pursuit MOS sound effect, if it should be playing (on tone generator 3)
    \
    LDA endPursuitCounter : BEQ rts_3
    LDA primarySamplesEnabled : BNE rts_3
    JMP soundEffect_beginPursuit \ implicit RTS
}

\
\ sendSoundData(A)
\
\ send sound data to SN76489 sound chip
\
\ params: 
\   A (accumulator)     Sound data
\
.sendSoundData
{
    PHA \ --> sound data

    \ set data direction register A (write &FF to &FE43)
    LDA #&FF
    STA &FE43

    \ output register A (write sound data to &FE4F)
    PLA \ <-- sound data
    STA &FE4F

    \ output register B, prepping write by setting chip write pin low (write 0 to &FE40)
    LDA #0
    STA &FE40

    \ keep the write enable line low for at least 8 us, 16 cycles
    LDA #&44     \ 2 cycles
    .loop
        LSR A    \ 6 cycles
        BCC loop \ 8 cycles
                                                        
    \ write data by setting chip write pin high (write 8 to &FE40)
    STA &FE40
     
    RTS                                                 
}

\ end file