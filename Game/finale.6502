\
\ Finale routines and data.  
\


\
\ finale
\
\ show final screen
\
.finale
{
    JSR showCongratsScreen
    JSR playMusic
    JSR waitForSpaceKeyPress
    JSR showCreditsScreen
    .loop NOP : JMP loop \ loop forever
}

\
\ showCongratsScreen()
\
.showCongratsScreen
{
    \ populate screen memory
    LDA #LO(congratsTeletext) : STA srcAddr
    LDA #HI(congratsTeletext) : STA srcAddr+1
    JMP memcpyToScreen \ implicit RTS

.congratsTeletext
INCBIN "data\\congrats.bin"
}

\
\ showCreditsScreen()
\
.showCreditsScreen
{
    \ populate screen memory
    LDA #LO(creditsTeletext) : STA srcAddr
    LDA #HI(creditsTeletext) : STA srcAddr+1
    JMP memcpyToScreen \ implicit RTS

.creditsTeletext
INCBIN "data\\credits.bin"
}

\
\ memcpyToScreen(srcAddr)
\
\ params:
\   srcAddr Source address
\
\ Modifies:
\   dstAddr, srcAddr
\
.memcpyToScreen
{
    LDA #LO(&7C00) : STA dstAddr
    LDA #HI(&7C00): STA dstAddr+1

    \ copy pages
    LDX #HI(1000)
    .loop1
        LDY #0
        .innerloop
            LDA (srcAddr),Y
            STA (dstAddr),Y
            INY
            BNE innerloop

        INC srcAddr+1
        INC dstAddr+1

        DEX
        BNE loop1

    \ copy sub-page
    LDX #LO(1000)
    LDY #0
    .loop2
        LDA (srcAddr),Y
        STA (dstAddr),Y
        INY

        DEX
        BNE loop2
    RTS
}

\ end file