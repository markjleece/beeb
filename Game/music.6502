\
\ Music routines and data (overwritten when game starts)
\

\ music data
.musicData
INCBIN "data\\music.dat"

\ music data cursor (resuses dstBaseAddr)
musicDataAddr = dstBaseAddr

\ music envelope definitions
.musicEnvelopes
    EQUB 0, 2, 0, 0, 0, 0, 0, 0, 63, -2, -1, -2, 63, 31  \ tone generator 0 (bass line)
    EQUB 1, 7, 1, -1, 1, 1, 2, 1, 24, -1, 0, -2, 71, 63  \ tone generator 1 (melody line)
    EQUB 2, 11, 1, -1, 1, 1, 2, 1, 24, -1, 0, -2, 71, 63 \ tone generator 2 (harmony line)

\
\ pitch tables (generated by MIDIConverter console app)
\ 
\ The first eighty entries hold half frequency durations, in 1/100th second units. The
\ remaining entries hold 76489 registry frequency values.
\

lowestNativeFrequency = 80

.pitchTblLo
    \ timer-based frequencies...
    EQUB &38, &80, &CA, &17, &66, &B8, &0D, &64, &BD, &19, &77, &D8, &3A, &9F, &07, &70
    EQUB &DC, &49, &B9, &2B, &9F, &15, &8D, &07, &82, &00, &80, &01, &84, &09, &90, &18
    EQUB &A3, &2E, &BC, &4B, &DC, &6E, &02, &98, &2F, &C8, &62, &FD, &9A, &38, &D8, &79
    EQUB &1C, &C0, &65, &0B, &B3, &5C, &06, &B2, &5E, &0C, &BB, &6C, &1D, &CF, &83, &38
    EQUB &EE, &A4, &5C, &15, &CF, &8A, &46, &03, &C1, &80, &40, &00, &C2, &84, &48, &0C

    \ native frequencies...
    EQUB &04, &05, &07, &09, &0B, &0D, &00, &03, &05, &09, &0C, &0F, &03, &07, &0B, &0F
    EQUB &03, &08, &0C, &01, &06, &0B, &00, &06, &0B, &01, &07, &0D, &03, &09, &00, &07
    EQUB &0D, &04, &0B, &02, &09, &01, &08, &00, &08, &00, &08, &00, &08, &00, &09, &01
    EQUB &0A, &02, &0B, &04, &0D, &06, &00, &09, &02, &0C, &06, &0F, &09, &03, &0D, &07
    EQUB &01, &0C, &06, &00, &0B, &05, &00, &0B, &05, &00, &0B, &06, &01, &0C, &08, &03
    EQUB &0E, &0A, &05, &01, &0C, &08, &04, &00, &0C, &08, &04, &00, &0C, &08, &04, &00
    EQUB &0D, &09, &05, &02, &0E, &0B, &08, &04, &01, &0E, &0B, &07, &04, &01, &0E, &0B
    EQUB &08, &06, &03, &00, &0D, &0A, &08, &05, &02, &00, &0D, &0B, &08, &06, &04, &01
    EQUB &0F, &0D, &0A, &08, &06, &04, &02, &00, &0E, &0C, &0A, &08, &06, &04, &02, &00
    EQUB &0E, &0C, &0A, &09, &07, &05, &04, &02, &00, &0F, &0D, &0B, &0A, &08, &07, &05
    EQUB &04, &03, &01, &00, &0E, &0D, &0C, &0A, &09, &08, &06, &05, &04, &03, &02, &00

.pitchTblHi
    \ timer-based frequencies...
    EQUB &32, &31, &30, &30, &2F, &2E, &2E, &2D, &2C, &2C, &2B, &2A, &2A, &29, &29, &28
    EQUB &27, &27, &26, &26, &25, &25, &24, &24, &23, &23, &22, &22, &21, &21, &20, &20
    EQUB &1F, &1F, &1E, &1E, &1D, &1D, &1D, &1C, &1C, &1B, &1B, &1A, &1A, &1A, &19, &19
    EQUB &19, &18, &18, &18, &17, &17, &17, &16, &16, &16, &15, &15, &15, &14, &14, &14
    EQUB &13, &13, &13, &13, &12, &12, &12, &12, &11, &11, &11, &11, &10, &10, &10, &10

    \ native frequencies...
    EQUB &3F, &3E, &3D, &3C, &3B, &3A, &3A, &39, &38, &37, &36, &35, &35, &34, &33, &32
    EQUB &32, &31, &30, &30, &2F, &2E, &2E, &2D, &2C, &2C, &2B, &2A, &2A, &29, &29, &28
    EQUB &27, &27, &26, &26, &25, &25, &24, &24, &23, &23, &22, &22, &21, &21, &20, &20
    EQUB &1F, &1F, &1E, &1E, &1D, &1D, &1D, &1C, &1C, &1B, &1B, &1A, &1A, &1A, &19, &19
    EQUB &19, &18, &18, &18, &17, &17, &17, &16, &16, &16, &15, &15, &15, &14, &14, &14
    EQUB &13, &13, &13, &13, &12, &12, &12, &12, &11, &11, &11, &11, &10, &10, &10, &10
    EQUB &0F, &0F, &0F, &0F, &0E, &0E, &0E, &0E, &0E, &0D, &0D, &0D, &0D, &0D, &0C, &0C
    EQUB &0C, &0C, &0C, &0C, &0B, &0B, &0B, &0B, &0B, &0B, &0A, &0A, &0A, &0A, &0A, &0A
    EQUB &09, &09, &09, &09, &09, &09, &09, &09, &08, &08, &08, &08, &08, &08, &08, &08
    EQUB &07, &07, &07, &07, &07, &07, &07, &07, &07, &06, &06, &06, &06, &06, &06, &06
    EQUB &06, &06, &06, &06, &05, &05, &05, &05, &05, &05, &05, &05, &05, &05, &05, &05
 
\ delta-time counter
.deltaTimeCounterLo         EQUB 0 \ used to schedule when the next note event(s) will be interpreted
.deltaTimeCounterHi         EQUB 0

\ low frequency generator variables
.lowFrequencyToneGenerator  EQUB &FF \ used to control the low frequency tone generator
.lowFrequencyToggle         EQUB 0 \ used by the low frequency tone generator
    
\ envelope constants (from Beeb User Guide)
ENVELOPE_N = 0      \ envelope number (not used)
ENVELOPE_T = 1      \ step length in 1/100th seconds (1..127) (bit-7 assumed set)
ENVELOPE_PI1 = 2    \ change in pitch in section 1 (-128..127)
ENVELOPE_PI2 = 3    \ change in pitch in section 2 (-128..127)
ENVELOPE_PI3 = 4    \ change in pitch in section 3 (-128..127)
ENVELOPE_PN1 = 5    \ number of steps in section 1 (0..255)
ENVELOPE_PN2 = 6    \ number of steps in section 2 (0..255)
ENVELOPE_PN3 = 7    \ number of steps in section 3 (0..255)
ENVELOPE_AA = 8     \ change in amplitude per step during attack phase (-128..127)
ENVELOPE_AD = 9     \ change in amplitude per step during decay phase (-128..127)
ENVELOPE_AS = 10    \ change in amplitude per step during sustain phase (-128..127)
ENVELOPE_AR = 11    \ change in amplitude per step during release phase (-128..127)
ENVELOPE_ALA = 12   \ target amplitude at end of attach phase (0..126)
ENVELOPE_ALD = 13   \ target amplitude at end of decay phase (0..126)
ENVELOPE_SIZE = 14

\ amplitude envelope phases
AMPLITUDE_PHASE_ATTACK = 0
AMPLITUDE_PHASE_DECAY = 1
AMPLITUDE_PHASE_SUSTAIN = 2
AMPLITUDE_PHASE_RELEASE = 3

\ envelope offsets
.envelopeOffsetTbl
    EQUB ENVELOPE_SIZE * 0
    EQUB ENVELOPE_SIZE * 1
    EQUB ENVELOPE_SIZE * 2

\ envelope variables (for each of the three envelopes)
.stepCounter           EQUB 0, 0, 0 \ step counter
.amplitudePhase        EQUB 3, 3, 3 \ amplitude phase: attach (0), decay (1), sustain (2), release (3)
.amplitudeAccumulator  EQUB 0, 0, 0 \ amplitude accumulator
.pitchSection          EQUB 0, 0, 0 \ pitch section (0..2)
.pitchSectionCounter   EQUB 0, 0, 0 \ pitch section counter
.pitchAccumulator      EQUB 0, 0, 0 \ pitch accumulator

\
\ playMusic
\
\ initiate music playback
\
.playMusic
{
    \ initialize envelope variables
    LDX #0
    .loop
        JSR resetEnvelopeVariables
        INX
        CPX #3
        BNE loop

    \ initialize interrupts
    JSR initializeMusicInterrupts

    \ fall through to replayMusic
}

\
\ replayMusic
\
\ replay the music
\
.replayMusic
{
    \ musicDataAddr = musicData
    LDA #LO(musicData) : STA musicDataAddr
    LDA #HI(musicData) : STA musicDataAddr+1

    \ skip over first delta time (we ignore the value)
    LDY #0
    LDA (musicDataAddr), Y
    BPL skip
        INY
    .skip
    INY

    \ musicDataAddr += Y
    TYA
    CLC
    ADC musicDataAddr
    STA musicDataAddr
    BCC nocarry
        INC musicDataAddr+1
    .nocarry

    \ initialize delta-time counter
    LDY #0
    STY deltaTimeCounterHi
    INY
    STY deltaTimeCounterLo

    RTS
}

\
\ stopMusic
\
\ stop music playback
\
.stopMusic
{
    \ restore MOS IRQ1V
    SEI \ disable interupts
    LDA mosIRQ1V : STA IRQ1V
    LDA mosIRQ1V+1 : STA IRQ1V+1
    CLI \ re-enable interrupts

    \ silence sound channels, setting frequency to lowest value
    LDX #0
    .loop
        \ set lowest frequency low bits
        LDA #&0F
        JSR setSoundChipFrequencyLo
         
        \ set lowest frequency high bits
        LDA #&3F
        JSR setSoundChipFrequencyHi

        \ set zero volume
        LDA #&0F
        JSR setSoundChipVolume

        INX
        CPX #3
        BNE loop
    RTS
}

\
\ processNextNoteEvents
\
\ process the next note events populating the pitch accumulator and/or amplitude phase. Also
\ set delteTimeCounter, controlling when this routine is called again
\
\ modifies:
\   pitchAccumulator
\   deltaTimeCounterLo/Hi
\
.processNextNoteEvents
{
    .loop
        \ note-on / note-off / terminator
        LDY #0
        LDA (musicDataAddr), Y
        STA temp

        \ if (terminator) replay music
        CMP #&FF : BEQ replayMusic \ implicit RTS

        \ tone generator (bits 0,1)
        AND #3
        TAX \ --> tone generator

        \ pitch (bits 2..7)
        LDA temp
        AND #&FC
        BEQ else1
            \ note-on
            STA pitchAccumulator, X
            LDA #AMPLITUDE_PHASE_ATTACK : STA amplitudePhase, X
            JSR resetEnvelopeVariables
            JMP endif1
        .else1
            \ note-off
            LDA #AMPLITUDE_PHASE_RELEASE : STA amplitudePhase, X
            LDA #0 : STA stepCounter, X
        .endif1

        \ delta time
        INY
        LDA (musicDataAddr), Y
        BMI else2
            STA deltaTimeCounterLo
            LDA #0
            STA deltaTimeCounterHi
            BEQ endif2
        .else2
            AND #&7F
            STA deltaTimeCounterHi
            INY
            LDA (musicDataAddr), Y
            STA deltaTimeCounterLo
        .endif2

        \ musicDataAddr += Y
        INY
        TYA
        CLC
        ADC musicDataAddr
        STA musicDataAddr
        BCC nocarry1
            INC musicDataAddr+1
        .nocarry1

        \ loop while (deltaTimeCounter == 0)
        LDA deltaTimeCounterLo : BNE skip
        LDA deltaTimeCounterHi : BEQ loop
        .skip

.return
    RTS
}

\
\ initializeMusicInterrupts
\
.initializeMusicInterrupts
{
    SEI \ disable interupts

    \ remember MOS IRQ1V
    LDA IRQ1V : STA mosIRQ1V
    LDA IRQ1V+1 : STA mosIRQ1V+1

    \ set IRQ1V vector to music IRQ
    LDA #LO(music_irq) : STA IRQ1V
    LDA #HI(music_irq) : STA IRQ1V+1

    \ disable all System-VIA and User-VIA interrupts
    LDA #&7F
    STA &FE4E
    STA &FE6E

    \ enable System-VIA Timer1 & Timer2
    LDA #&E0
    STA &FE4E

    \ set Timer1 to continous mode and Timer2 to one-shot mode
    LDA #&40
    STA &FE4B

    \ set Timer1 length to 1/100th second
    LDA #LO(5000) : STA &FE44
    LDA #HI(5000) : STA &FE45
    LDA #LO(10000 - 2) : STA &FE46
    LDA #HI(10000 - 2) : STA &FE47  

    \ set default Timer2 length
    LDA #&FF
    STA &FE48
    STA &FE49

    CLI \ re-enable interrupts

    RTS
}

\
\ music interrupt request routine, used to play music
\
.music_irq
{
    \ preserve state
    LDA &FC : PHA
    TXA : PHA : TYA : PHA

    \ Handle Timer1 interrupt
    LDA &FE4D
    AND #&40
    BEQ skip_timer1
        LDA &FE44 \ mark interrupt as handled
        JSR updateSound
    .skip_timer1

    \ Handle Timer2 interrupt
    LDA &FE4D
    AND #&20
    BEQ skip_timer2
        LDA &FE48 \ mark interrupt as handled
        JSR generateLowFrequencyTone
    .skip_timer2

    \ restore state and return
    PLA : TAY : PLA : TAX
    PLA : STA &FC 

    RTI
}

\
\ generateLowFrequencyTone()
\
\ invoked by music interrupt routine to generate low frequency tone 
\ by toggling the volume at twice the frequency
\
.generateLowFrequencyTone
{
    \ low frequency tone?
    LDX lowFrequencyToneGenerator
    CPX #&FF : BEQ skip1

        \ reset Timer2 duration
        LDY pitchAccumulator, X
        LDA pitchTblLo, Y : STA &FE48
        LDA pitchTblHi, Y : STA &FE49
    
        \ toggle volume with zero
        LDA lowFrequencyToggle
        EOR #&0F
        STA lowFrequencyToggle
        BNE skip2
            LDA #63
            SEC
            SBC amplitudeAccumulator, X
            LSR A : LSR A
        .skip2
    
        \ set tone generator's volume
        JMP setSoundChipVolume \ implicit RTS
    .skip1

    RTS
}

\
\ updateSound()
\
\ invoked by music interrupt routine to play in the background. The 
\ routine is called every 1/100th of a second.
\
.updateSound
{
    \ update sound chip
    JSR updateSoundChip

    \ if (deltaTimeCounter == 0)
    LDA deltaTimeCounterLo : BNE skip1
    LDA deltaTimeCounterHi : BNE skip1
        \ process next sound event(s)
        JSR processNextNoteEvents
    .skip1

    \ decrement deltaTimeCounter
    LDA deltaTimeCounterLo
    BNE skip2
        DEC deltaTimeCounterHi
    .skip2
    DEC deltaTimeCounterLo

    \ update sound accumulators
    JMP updateSoundAccumulators \ implicit RTS
}

\
\ updateSoundChip()
\
\ updates the sound chip
\
.updateSoundChip
{
    \ for each sound generator...
    LDX #0
    .loop
        \ Y = pitchAccumulator
        LDY pitchAccumulator, X

        \ if (pitch < lowest native frequency)
        CPY #lowestNativeFrequency : BCS else

            \ is lower frequency tone generator already active?
            LDA lowFrequencyToneGenerator
            CMP #&FF : BNE endif
        
            \ set Timer2 duration
            LDA pitchTblLo, Y : STA &FE48
            LDA pitchTblHi, Y : STA &FE49
        
            \ set highest frequency low bits
            LDA #1
            JSR setSoundChipFrequencyLo
        
            \ set highest frequency high bits
            LDA #0
            JSR setSoundChipFrequencyHi
        
            \ set zero volume
            LDA #&0F
            JSR setSoundChipVolume
        
            \ prime low frequency toggle
            LDA #0 : STA lowFrequencyToggle
        
            \ enable lower frequency tone generator
            STX lowFrequencyToneGenerator

            JMP endif

        .else
            CPX lowFrequencyToneGenerator : BNE skip2
                \ stop low frequency tone generation
                LDA #&FF : STA lowFrequencyToneGenerator
            .skip2

            \ has pitch changed?
            TYA \ <-- pitch
            CMP lastPitch, X : BEQ noPitchChange

                \ update lastPitch
                STA lastPitch, X

                \ set frequency low bits
                LDA pitchTblLo, Y
                JSR setSoundChipFrequencyLo
         
                \ set frequency high bits
                LDA pitchTblHi, Y
                JSR setSoundChipFrequencyHi

            .noPitchChange

            \ get volume
            LDA #127
            SEC
            SBC amplitudeAccumulator, X
            LSR A : LSR A : LSR A
            AND #&0F

            \ has volume changed?
            CMP lastVolume, X : BEQ noVolumeChange

                \ update lastVolume
                STA lastVolume, X

                \ set volume
                JSR setSoundChipVolume

            .noVolumeChange

        .endif

        INX
        CPX #3
        BNE loop

.return
    RTS

.lastPitch EQUB 0, 0, 0
.lastVolume EQUB &FF, &FF, &FF
}

\
\ updateSoundAccumulators()
\
\ update the pitch and amplitude accumulators
\
.updateSoundAccumulators
{
    \ for each tone generator ...
    LDX #0
    .loop
    
        \ if (stepCounter != 0) 
        LDA stepCounter, X : BEQ skip
            \ decrement stepCounter
            DEC stepCounter, X

            \ if (stepCounter != 0) continue
            LDA stepCounter, X
            BNE continue
        .skip

        \ reset stepCounter
        LDY envelopeOffsetTbl, X
        LDA musicEnvelopes + ENVELOPE_T, Y : STA stepCounter, X

        \ update accumulators
        JSR updatePitchAccumulator
        JSR updateAmplitudeAccumulator

        \ next tone generator
        .continue
        INX
        CPX #3
        BNE loop

.return
    RTS
}

\
\ updatePitchAccumulator(X)
\
\ params:
\   X register  tone generator
\
.updatePitchAccumulator
{
    \ if ((ENVELOPE_PN1 | ENVELOPE_PN2 | ENVELOPE_PN3) == 0) return
    LDY envelopeOffsetTbl, X
    LDA musicEnvelopes + ENVELOPE_PN1, Y
    ORA musicEnvelopes + ENVELOPE_PN2, Y
    ORA musicEnvelopes + ENVELOPE_PN3, Y
    BEQ return

    \ if (pitchSectionCounter != 0)
    LDA pitchSectionCounter, X : BEQ skip1

        \ decrement pitchSectionCounter
        DEC pitchSectionCounter, X

        \ pitchAccumulator += ENVELOPE_PI1 or ENVELOPE_PI2 or ENVELOPE_PI3
        TYA
        CLC
        ADC pitchSection, X
        TAY

        LDA pitchAccumulator, X
        CLC
        ADC musicEnvelopes + ENVELOPE_PI1, Y
        STA pitchAccumulator, X

        \ if (pitchSectionCounter != 0) return
        LDA pitchSectionCounter, X
        BNE return

    .skip1

    \ move to next section
    .loop

        \ pitchSection = (pitchSection + 1) % 3
        LDA pitchSection, X
        CLC
        ADC #1
        CMP #3 : BNE skip2
            LDA #0
        .skip2
        STA pitchSection, X

        \ pitchSectionCounter = ENVELOPE_PN1 or ENVELOPE_PN2 or ENVELOPE_PN3
        CLC
        ADC envelopeOffsetTbl, X
        TAY
        LDA musicEnvelopes + ENVELOPE_PN1, Y
        STA pitchSectionCounter, X

        \ loop while zero
        BEQ loop

.return
    RTS
}

\
\ updateAmplitudeAccumulator(X)
\
\ params:
\   X register  tone generator
\
.updateAmplitudeAccumulator
{
    \ Y = X * ENVELOPE_SIZE
    LDY envelopeOffsetTbl, X

    \ if (amplitudePhase == AMPLITUDE_PHASE_ATTACK)
    LDA amplitudePhase, X
    CMP #AMPLITUDE_PHASE_ATTACK : BNE else1
            
        \ if (ENVELOPE_AA == 0) return
        LDA musicEnvelopes + ENVELOPE_AA, Y : BEQ endif

        \ amplitudeAccumulator += ENVELOPE_AA
        CLC
        ADC amplitudeAccumulator, X

        \ if (amplitudeAccumulator >= ENVELOPE_ALA) 
        CMP musicEnvelopes + ENVELOPE_ALA, Y : BCC skip_1 \ assumes ENVELOPE_AA is positive
            \ amplitudePhase = AMPLITUDE_PHASE_DECAY
            INC amplitudePhase, X

            \ clamp amplitudeAccumulator to ENVELOPE_ALA
            LDA musicEnvelopes + ENVELOPE_ALA, Y
        .skip_1
        STA amplitudeAccumulator, X

        JMP endif

    \ else if (amplitudePhase == AMPLITUDE_PHASE_DECAY)
    .else1
    CMP #AMPLITUDE_PHASE_DECAY : BNE else2

        \ if (ENVELOPE_AD == 0) return
        LDA musicEnvelopes + ENVELOPE_AD, Y : BEQ endif

        \ amplitudeAccumulator += ENVELOPE_AD
        CLC
        ADC amplitudeAccumulator, X

        \ if (amplitudeAccumulator <= ENVELOPE_ALD) 
        CMP musicEnvelopes + ENVELOPE_ALD, Y : BEQ then_2 : BCS skip_2 \ assumes ENVELOPE_AD is negative
        .then_2
            \ amplitudePhase = AMPLITUDE_PHASE_SUSTAIN
            INC amplitudePhase, X

            \ clamp amplitudeAccumulator to ENVELOPE_ALD
            LDA musicEnvelopes + ENVELOPE_ALD, Y
        .skip_2
        STA amplitudeAccumulator, X

        JMP endif

    \ else if (amplitudePhase == AMPLITUDE_PHASE_SUSTAIN)
    .else2
    CMP #AMPLITUDE_PHASE_SUSTAIN : BNE else3
        \ if (amplitudeAccumulator == 0 || ENVELOPE_AS == 0) return
        LDA musicEnvelopes + ENVELOPE_AS, Y : BEQ endif
        LDA amplitudeAccumulator, X : BEQ endif

        \ amplitudeAccumulator += ENVELOPE_AS
        \ if (amplitudeAccumulator < 0) amplitudeAccumulator = 0
        CLC
        ADC musicEnvelopes + ENVELOPE_AS, Y
        BPL skip_3 \ assumes ENVELOPE_AS is negative
            LDA #0
        .skip_3
        STA amplitudeAccumulator, X

        JMP endif

    \ else if (amplitudePhase == AMPLITUDE_PHASE_RELEASE)
    .else3
    CMP #AMPLITUDE_PHASE_RELEASE : BNE endif
        \ if (amplitudeAccumulator == 0 || ENVELOPE_AR == 0) return
        LDA musicEnvelopes + ENVELOPE_AR, Y : BEQ endif
        LDA amplitudeAccumulator, X : BEQ endif

        \ amplitudeAccumulator += ENVELOPE_AR
        \ if (amplitudeAccumulator < 0) amplitudeAccumulator = 0
        CLC
        ADC musicEnvelopes + ENVELOPE_AR, Y
        BPL skip_4 \ assumes ENVELOPE_AR is negative
            LDA #0
        .skip_4
        STA amplitudeAccumulator, X
    .endif

    RTS
}

\
\ resetEnvelopeVariables(X)
\
\ params:
\   X register  Envelope index
\
.resetEnvelopeVariables
{
    TYA : PHA \ save Y

    \ Y = X * ENVELOPE_SIZE
    LDY envelopeOffsetTbl, X

    \ reset stepCounter
    LDA musicEnvelopes + ENVELOPE_T, Y : STA stepCounter, X

    \ reset pitchSection and pitchSectionCounter
    LDA #0
    STA pitchSectionCounter, X
    STA pitchSection, X

    LDA musicEnvelopes + ENVELOPE_PN1, Y : BEQ else1
        STA pitchSectionCounter, X
        LDA #0 : STA pitchSection, X
        JMP endif                      
    .else1
    LDA musicEnvelopes + ENVELOPE_PN2, Y : BEQ else2
        STA pitchSectionCounter, X
        LDA #1 : STA pitchSection, X
        JMP endif                      
    .else2
    LDA musicEnvelopes + ENVELOPE_PN3, Y : BEQ endif
        STA pitchSectionCounter, X
        LDA #2 : STA pitchSection, X
    .endif

    PLA : TAY \ restore Y
    RTS
}

\
\ setSoundChipVolume(A, X)
\
\ set sound chip's volume
\
\ params
\   X register  Tone generator 0..2
\   A register  Volume: 0 (loudest) to &F (silent)
\
.setSoundChipVolume
{
    AND #&0F
    ORA volumeMaskTbl, X
    JMP sendSoundData \ implicit RTS

.volumeMaskTbl EQUB %11010000, %10110000, %10010000
}

\
\ setSoundChipFrequencyLo(A, X)
\
\ set sound chip's frequency (low 4 bits)
\
\ params
\   X register  Tone generator 0..2
\   A register  Frequency data (low 4 bits)
\
.setSoundChipFrequencyLo
{
    AND #&0F
    ORA frequencyMaskTbl, X
    BNE sendSoundData \ implicit RTS

.frequencyMaskTbl EQUB %11000000, %10100000, %10000000
}

\
\ setSoundChipFrequencyHi(A)
\
\ set sound chip's frequency (high 6 bits). This routine
\ is called after setSoundChipFrequencyLo(A, X)
\
\ params
\   A register  Frequency data (high 6 bits)
\
.setSoundChipFrequencyHi
{
    AND #&3F
    \ fall through to sendSoundData
}

\
\ sendSoundData(A)
\
\ send sound data to 76489 sound chip
\
\ params: 
\    A (accumulator)    Sound data
\
\ modifies:
\   temp
\
.sendSoundData
{
    STY temp \ save Y

    \ set data direction register A (write &FF to &FE43)
    LDY #&FF
    STY &FE43

    \ output register A (write sound data to &FE4F)
    STA &FE4F

    \ output register B, prepping write by setting chip write pin low (write 0 to &FE40)
    INY
    STY &FE40

    \ keep the write enable line low for at least 8 us, 16 cycles
    LDY #2
    .loop
        DEY
        BNE loop
                                                        
    \ write data by setting chip write pin high (write 8 to &FE40)
    LDY #8
    STY &FE40
     
    LDY temp \ restore Y
    RTS                                                 
}

\ end file