\
\ Game levels are stored on disc in files named: 'level1', 'level2' 'level3' etc.
\ Each level file contains layout data, sprite data, and code (this file).
\ Levels are loaded using the loadLevel routine defined in program.6502
\ The loadLevel routine calls initializeLevel in this file to set up the level.
\ Much of the loaded file data (including this code) is overwritten when the level starts.
\
\ A level file contains the following information:
\  - Palette (levels can have their own distinct 4-color palette)
\  - Tile definitions (types and pixel grids)
\  - Tile grid (extents and data)
\  - Sprite definitions (enemies, elevators, doors...)
\  - Object descriptors
\  - Switch pairings
\  - Settings
\
\ The first level is packaged with the game binary
\

\
\ Level routines (packaged with level data)
\

\
\ initialiseLevel()
\
\ initialize level after its been loaded
\
\ Note that this routine is packaged with each level and is overwritten
\
.initializeLevel
{
    JSR acquireNMImemory
    JSR initializeLevelVariables
    JSR relocateObjectExtents
    JSR initializeObjects
    JSR relocateTileAddrTbl
    JSR relocateSpriteAddrTbl
    JSR relocateEnemyHealthBarTbls
    JSR relocateSoundEffectData
    JSR initializeSound
    JSR relocateLevelData
    JSR relocateDrawObjectJumpTbl
    JSR setCustomScreenMode
    JSR initializeSidewaysRam
    JSR relocateSampleParams
    LDA #0 : STA startup
    JMP showLevel \ implicit RTS
}

\
\ Acquire NMI memory (&0D00-&0D5F)
\
.acquireNMImemory
{
    LDA #143 : JSR osbyte
    LDA #12 : JSR osbyte
    LDA #255 : JSR osbyte

    STY &A0 \ NMI owner's zero page variables
    LDA #&40 : STA &0D00 \ store RTI at &0D00
    RTS
}

\
\ initializeLevelVariables
\
\ initialize level variables
\
\ Note that this routine is packaged with each level and is overwritten
\
.initializeLevelVariables
{
    \ reset game variables
    LDA #0
    STA keyCount
    STA frameCount
    STA laserFrameCount
    STA k9DamageCounter
    STA endPursuitCounter
    STA primarySamplesEnabled
    STA laserSoundEffectOn 
    STA pursuitSoundEffectCounter
    STA blockedSoundEffectOn
    STA enemyHitTestLastFound
    STA doorScrollRedrawCount
    STA inhibitMoveSoundEffect
    STA groanInhibited
    STA laseredTileLeft
    STA laseredTileTop
    STA laseredTileStrength
    STA laseredTileRedraw
    STA enemyWeaponStrengthHi
    STA playingSample

    LDA #12 : STA healthHi
    LDA #&FF : STA healthLo : STA enemyHealthLo
    
    LDA #1
    STA laserInhibited \ make sure space key is lifted
    STA playBeginLevelSoundEffect
            
    \ set level settings
    LDA levelEnemyWeaponStrengthLoaded : STA enemyWeaponStrengthLo
    LDA levelLaserStrengthLoaded : STA laserStrength
    LDA levelLaserHealthDrainLoaded : STA laserHealthDrain
    LDA levelJewelHealthGainHiLoaded : STA jewelHealthGainHi
    LDA levelEnemyTypeLoaded : STA enemyType

    \ enemyWeaponStrength *= 4 (serialized value is divided by four)
    ASL enemyWeaponStrengthLo : ROL enemyWeaponStrengthHi
    ASL enemyWeaponStrengthLo : ROL enemyWeaponStrengthHi

    \ apply God mode?
    LDA godMode : BMI skip
        JSR applyGodMode
    .skip

    \ set switchOnTileGridValue
    LDY #0
    STY switchOnTileGridValue
    .loop1
        LDA levelTileTypesLoaded, Y
        CMP #TILE_TYPE_SWITCH_ON
        BNE skip1
            TYA
            ORA #TILE_GRID_FLAGS_OPAQUE
            STA switchOnTileGridValue
        .skip1
        INY
        CPY #TILE_COUNT
        BNE loop1

    \ set enemyWeaponRangePlusOne
    LDX #(ENEMY_WEAPON_RANGE + 1)
    LDA enemyType
    CMP #ENEMY_TYPE_WEEPING_ANGEL : BNE skip2
        LDX #1 \ Weeping Angel use their teeth!
    .skip2
    STX enemyWeaponRangePlusOne 

    \ set primarySamplesEnabled
    LDA enemyType
    CMP #ENEMY_TYPE_DALEK : BNE else
        LDA primarySamplesROMSEL : BEQ endif
            LDA #1 \ enable
            BNE endif \ always branch
    .else
        LDA #0 \ disable
    .endif
    STA primarySamplesEnabled

    \ set secondarySamplesEnabled flag
    LDA secondarySamplesROMSEL : BEQ skip3
        LDA #1 \ enable
    .skip3
    STA secondarySamplesEnabled

    \ patch BCC instruction in getObjectTileGridAddr (tilegrid.6502)
    LDA levelHorzTileCountLoaded
    CMP #128 : BNE else1
        LDA #0
        BEQ endif4
    .else1
    CMP #64 : BNE else2
        LDA #3
        BNE endif4
    .else2
    CMP #32 : BNE else3
        LDA #6
        BNE endif4
    .else3
    CMP #16 : BNE endif
        LDA #9
    .endif4
    STA bcc_inst+1

    \ patch JSR routine in inflictK9Damage (program.6502)
    LDX #LO(setBlackPalette)
    LDY #HI(setBlackPalette)
    LDA enemyType
    CMP #ENEMY_TYPE_DALEK : BNE skip4
        LDX #LO(setInvertedLevelPalette)
        LDY #HI(setInvertedLevelPalette)
    .skip4
    STX jsr_inst+1
    STY jsr_inst+2

    \ horzTileCount = levelHorzTileCountLoaded
    LDA levelHorzTileCountLoaded : STA horzTileCount

    \ set scrolling limits
    LSR A : LSR A : LSR A : LSR A
    SEC 
    SBC #1
    STA scrnLeftHiMaxMinusOne

    LDA levelVertTileCountLoaded
    LSR A : LSR A : LSR A : LSR A
    SEC
    SBC #1
    STA scrnTopHiMaxMinusOne

    \ patch black color 'or-mask' in drawGameBar (draw.6502) which is used to show that the game 
    \ is in God mode. We iterate over the level palette entries (which hasn't been relocated yet), 
    \ looking for a black one, and set the or-mask based on matching entry's index
    LDX #0
    .loop2
        \ if (levelPaletteLoaded[4*X] == blackPaletteEntries[X]) break
        TXA 
        ASL A : ASL A
        TAY
        LDA levelPaletteLoaded, Y
        CMP blackPaletteEntries, X
        BEQ loop2end

        \ increment and loop?
        INX
        CPX #4
        BNE loop2
    .loop2end

    LDA blackPixelOrMasks, X
    STA ora_inst+1

    RTS

    \ logical colors
    PAL_color_0 = &00
    PAL_color_1 = &20
    PAL_color_2 = &80
    PAL_color_3 = &A0

    \ physical color
    PAL_black = (0 EOR 7)

.blackPaletteEntries
    EQUB PAL_color_0 + PAL_black
    EQUB PAL_color_1 + PAL_black
    EQUB PAL_color_2 + PAL_black
    EQUB PAL_color_3 + PAL_black

.blackPixelOrMasks
    EQUB &00
    EQUB &01
    EQUB &10
    EQUB &11
    EQUB &00
}

\
\ set custom screen mode.  Mode 1, with 256 x 256 resolution
\
.setCustomScreenMode
{
    \
    \ first, clear the screen
    \

    \ make changes after next v-sync
    JSR waitForNextVSync

    \ fill Mode 7 screen memory with spaces
    LDA #&20 \ space
    LDY #4
    LDX #0
    .loop1
        STA &7C00, X
        INX
        BNE loop1
        INC loop1+2
        DEY
        BNE loop1

    \
    \ next, set custom screen mode (with palette set to black)
    \

    \ make changes after next v-sync
    JSR waitForNextVSync

    \ set up video 6845 CRTC
    LDX #13
    .loop
        STX &FE00
        LDA crtcRegs, X
        STA &FE01
        DEX
        BPL loop

    \ set up video ULA
    LDA #&D8
    STA &FE20

    \ set black palette
    JSR setBlackPalette

    \ set screen wrap to 16K
    SEI
    LDA #&0F : STA &FE42 \ set data direction register B (bits 0..3 write)
    LDA #4 : STA &FE40   \ clear screen wraps bit 4
    LDA #5 : STA &FE40   \ clear screen wraps bit 5
    CLI

    \
    \ finally, set game variables
    \

    \ initialize screen address
    LDA #LO(&4000 + &200) : STA scrnAddr
    LDA #HI(&4000 + &200) : STA scrnAddr+1

    \ initialize screen position
    LDA #0
    STA scrnTopLo
    STA scrnTopHi
    STA scrnLeftLo
    LDA #1
    STA scrnLeftHi

    RTS

.crtcRegs
    EQUB 127            \ R0  horizontal total
    EQUB 64             \ R1  horizontal displayed
    EQUB 90             \ R2  horizontal position
    EQUB 40             \ R3  sync width
    EQUB 38             \ R4  vertical total
    EQUB 0              \ R5  vertical total adjust
    EQUB 32             \ R6  vertical displayed
    EQUB 34             \ R7  vertical position
    EQUB 0              \ R8  interlace
    EQUB 7              \ R9  scan-lines per row
    EQUB 32             \ R10 cursor start
    EQUB 8              \ R11 cursor end
    EQUB HI(&4000/8)    \ R12 screen start address, high
    EQUB LO(&4000/8)    \ R13 screen start address, low
}

\
\ relocate tile address table
\
.relocateTileAddrTbl
{
    LDA #LO(tileAddrTblLoLocal) : STA srcAddr
    LDA #HI(tileAddrTblLoLocal) : STA srcAddr+1

    LDA #LO(tileAddrTblLo) : STA dstAddr
    LDA #HI(tileAddrTblLo) : STA dstAddr+1

    LDX #LO(TILE_COUNT)
    LDY #HI(TILE_COUNT)

    JSR memcpy

    LDA #LO(tileAddrTblHiLocal) : STA srcAddr
    LDA #HI(tileAddrTblHiLocal) : STA srcAddr+1

    LDA #LO(tileAddrTblHi) : STA dstAddr
    LDA #HI(tileAddrTblHi) : STA dstAddr+1

    LDX #LO(TILE_COUNT)
    LDY #HI(TILE_COUNT)

    JMP memcpy \ implicit RTS

.tileAddrTblLoLocal
    FOR i, 0, TILE_COUNT
        EQUB LO(levelTiles - 64 + (i * 64))
    NEXT

.tileAddrTblHiLocal
    FOR i, 0, TILE_COUNT
        EQUB HI(levelTiles - 64 + (i * 64))
    NEXT
}

\
\ relocate sprite address table
\
.relocateSpriteAddrTbl
{
    LDA #LO(spriteAddrTblLoLocal) : STA srcAddr
    LDA #HI(spriteAddrTblLoLocal) : STA srcAddr+1

    LDA #LO(spriteAddrTblLo) : STA dstAddr
    LDA #HI(spriteAddrTblLo) : STA dstAddr+1

    LDX #LO(SPRITE_COUNT)
    LDY #HI(SPRITE_COUNT)

    JSR memcpy

    LDA #LO(spriteAddrTblHiLocal) : STA srcAddr
    LDA #HI(spriteAddrTblHiLocal) : STA srcAddr+1

    LDA #LO(spriteAddrTblHi) : STA dstAddr
    LDA #HI(spriteAddrTblHi) : STA dstAddr+1

    LDX #LO(SPRITE_COUNT)
    LDY #HI(SPRITE_COUNT)

    JSR memcpy

    LDA primarySamplesROMSEL
    ORA secondarySamplesROMSEL
    BEQ skip
        \ game bar atlas resides in sideways RAM
        LDA #LO(gamebarAtlas_sidewaysRAM) : STA spriteAddrTblLo + SPRITE_INDEX_GAMEBAR
        LDA #HI(gamebarAtlas_sidewaysRAM) : STA spriteAddrTblHi + SPRITE_INDEX_GAMEBAR
    .skip
    RTS

.spriteAddrTblLoLocal
    \ 11 enemy sprites
    EQUB LO(enemyAtlas1)
    EQUB LO(enemyAtlas2)

    FOR addr, enemyAtlas3, enemyAtlas3 + ENEMY_SPRITE_SIZE, ENEMY_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    FOR addr, enemyAtlas4, enemyAtlas4 + (4 * ENEMY_SPRITE_SIZE), ENEMY_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    FOR addr, enemyAtlas5, enemyAtlas5 + ENEMY_SPRITE_SIZE, ENEMY_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    \ 4 door sprites
    EQUB LO(doorAtlas1)

    FOR addr, doorAtlas2, doorAtlas2 + DOOR_SPRITE_SIZE, DOOR_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    EQUB LO(doorAtlas3)

    \ 4 elevator sprites
    EQUB LO(elevatorAtlas1)

    FOR addr, elevatorAtlas2, elevatorAtlas2 + (2 * ELEVATOR_SPRITE_SIZE), ELEVATOR_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    \ 4 teleport sprites
    FOR addr, teleportAtlas, teleportAtlas + (3 * ELEVATOR_SPRITE_SIZE), ELEVATOR_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    \ 11 k9 sprites
    FOR addr, k9Atlas1, k9Atlas1 + K9_SPRITE_SIZE, K9_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    EQUB LO(k9Atlas2)

    FOR addr, k9Atlas3, k9Atlas3 + (7 * K9_SPRITE_SIZE), K9_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

    \ 1 game bar sprite
    EQUB LO(gamebarAtlas)

.spriteAddrTblHiLocal
    \ 11 enemy sprites
    EQUB HI(enemyAtlas1)
    EQUB HI(enemyAtlas2)

    FOR addr, enemyAtlas3, enemyAtlas3 + ENEMY_SPRITE_SIZE, ENEMY_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    FOR addr, enemyAtlas4, enemyAtlas4 + (4 * ENEMY_SPRITE_SIZE), ENEMY_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    FOR addr, enemyAtlas5, enemyAtlas5 + ENEMY_SPRITE_SIZE, ENEMY_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    \ 4 door sprites
    EQUB HI(doorAtlas1)

    FOR addr, doorAtlas2, doorAtlas2 + DOOR_SPRITE_SIZE, DOOR_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    EQUB HI(doorAtlas3)

    \ 4 elevator sprites
    EQUB HI(elevatorAtlas1)

    FOR addr, elevatorAtlas2, elevatorAtlas2 + (2 * ELEVATOR_SPRITE_SIZE), ELEVATOR_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    \ 4 teleport sprites
    FOR addr, teleportAtlas, teleportAtlas + (3 * ELEVATOR_SPRITE_SIZE), ELEVATOR_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    \ 11 k9 sprites
    FOR addr, k9Atlas1, k9Atlas1 + K9_SPRITE_SIZE, K9_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    EQUB HI(k9Atlas2)

    FOR addr, k9Atlas3, k9Atlas3 + (7 * K9_SPRITE_SIZE), K9_SPRITE_SIZE
        EQUB HI(addr)
    NEXT

    \ 1 game bar sprite
    EQUB HI(gamebarAtlas)
}

\
\ relocateEnemyHealthBarTbls()
\
\ relocate enemy health bar tables
\
.relocateEnemyHealthBarTbls
{
    \ sprite health bar table
    LDA #LO(spriteHealthBarTblLocal) : STA srcAddr
    LDA #HI(spriteHealthBarTblLocal) : STA srcAddr+1

    LDA #LO(spriteHealthBarTbl) : STA dstAddr
    LDA #HI(spriteHealthBarTbl) : STA dstAddr+1

    LDX #LO(ENEMY_HEALTH_BAR_TABLE_SIZE)
    LDY #HI(ENEMY_HEALTH_BAR_TABLE_SIZE)

    JSR memcpy

    \ sprite health bar table
    LDA #LO(healthBarAtlasLocal) : STA srcAddr
    LDA #HI(healthBarAtlasLocal) : STA srcAddr+1

    LDA #LO(healthBarAtlas) : STA dstAddr
    LDA #HI(healthBarAtlas) : STA dstAddr+1

    LDX #LO(ENEMY_HEALTH_BAR_ATLAS_SIZE)
    LDY #HI(ENEMY_HEALTH_BAR_ATLAS_SIZE)

    JMP memcpy \ implicit RTS

.spriteHealthBarTblLocal
    EQUB &80, &86, &8C, &92, &06, &0C, &12, &18, &0C, &0C, &8C, &00

.healthBarAtlasLocal
    EQUB &7F, &00, &3F, &00, &1F, &00
    EQUB &37, &88, &17, &88, &07, &88
    EQUB &13, &CC, &03, &CC, &03, &4C
    EQUB &01, &EE, &01, &6E, &01, &2E
    EQUB &00, &7F, &00, &3F, &00, &1F
}

\
\ relocateDrawObjectJumpTbl()
\
\ relocate drawObject jump table
\
.relocateDrawObjectJumpTbl
{
    \ relocate jump table
    LDA #LO(jumpTbl) : STA srcAddr
    LDA #HI(jumpTbl) : STA srcAddr+1

    LDA #LO(drawObject_jumpTbl) : STA dstAddr
    LDA #HI(drawObject_jumpTbl) : STA dstAddr+1

    LDX #LO(DRAW_OBJECT_JUMP_TABLE_SIZE)
    LDY #HI(DRAW_OBJECT_JUMP_TABLE_SIZE)

    JMP memcpy

.jumpTbl
    EQUB 40, 35, 30, 25, 20, 15, 10, 5, 0
}


\
\ relocateObjectExtents()
\
\ relocate object extents table
\
.relocateObjectExtents
{
    LDA #LO(extentsTbl) : STA srcAddr
    LDA #HI(extentsTbl) : STA srcAddr+1

    LDA #LO(objectExtents) : STA dstAddr
    LDA #HI(objectExtents) : STA dstAddr+1

    LDX #LO(OBJECT_EXTENTS_SIZE)
    LDY #HI(OBJECT_EXTENTS_SIZE)

    JMP memcpy

.extentsTbl
    EQUB K9_SPRITE_WIDTH, ENEMY_SPRITE_WIDTH, ELEVATOR_SPRITE_WIDTH, DOOR_SPRITE_WIDTH
    EQUB K9_SPRITE_HEIGHT, ENEMY_SPRITE_HEIGHT, ELEVATOR_SPRITE_HEIGHT, DOOR_SPRITE_HEIGHT
}

\
\ relocateSoundEffectData
\
\ relocate sound effect data
\
.relocateSoundEffectData
{
    \ copy sound effect data
    LDA #LO(soundEffectsLocal) : STA srcAddr
    LDA #HI(soundEffectsLocal) : STA srcAddr+1

    LDA #LO(soundEffects) : STA dstAddr
    LDA #HI(soundEffects) : STA dstAddr+1

    LDX #LO(SOUND_EFFECTS_SIZE)
    LDY #HI(SOUND_EFFECTS_SIZE)

    JMP memcpy \ implicit RTS

.soundEffectsLocal
    EQUB &10, &F7, &04, &02 \ SOUND_EFFECT_PAIN 
    EQUB &10, &FC, &06, &0A \ SOUND_EFFECT_TELEPORT
    EQUB &11, &01, &00, &01 \ SOUND_EFFECT_LASER_ON
    EQUB &11, &00, &00, &00 \ SOUND_EFFECT_LASER_OFF
    EQUB &11, &F7, &60, &01 \ SOUND_EFFECT_LOW_BATTERY
    EQUB &11, &F7, &60, &FF \ SOUND_EFFECT_FLAT_BATTERY
    EQUB &11, &02, &00, &05 \ SOUND_EFFECT_LEVEL_COMPLETE
    EQUB &12, &02, &18, &03 \ SOUND_EFFECT_ACHIEVEMENT
    EQUB &12, &03, &28, &01 \ SOUND_EFFECT_BLOCKED
    EQUB &12, &FE, &00, &01 \ SOUND_EFFECT_MOVE
    EQUB &13, &04, &48, &01 \ SOUND_EFFECT_PURSUIT_ON
    EQUB &13, &00, &00, &00 \ SOUND_EFFECT_PURSUIT_OFF
}

\
\ relocateLevelData()
\
\ relocate level data
\
\ Note that this routine is packaged with each level and is overwritten
\
.relocateLevelData
{
    \
    \ relocate palette
    \
    LDA #LO(levelPaletteLoaded) : STA srcAddr
    LDA #HI(levelPaletteLoaded) : STA srcAddr+1

    LDA #LO(levelPalette) : STA dstAddr
    LDA #HI(levelPalette) : STA dstAddr+1

    LDX #LO(PALETTE_SIZE)
    LDY #HI(PALETTE_SIZE)

    JSR memcpy

    \
    \ relocate tile types
    \
    LDA #LO(levelTileTypesLoaded) : STA srcAddr
    LDA #HI(levelTileTypesLoaded) : STA srcAddr+1

    LDA #LO(levelTileTypes) : STA dstAddr
    LDA #HI(levelTileTypes) : STA dstAddr+1

    LDX #LO(TILE_COUNT)
    LDY #HI(TILE_COUNT)

    JSR memcpy

    \
    \ relocate switch pairings
    \
    LDA #LO(levelSwitchPairingsLoaded) : STA srcAddr
    LDA #HI(levelSwitchPairingsLoaded) : STA srcAddr+1

    LDA #LO(switchPairings) : STA dstAddr
    LDA #HI(switchPairings) : STA dstAddr+1

    LDX #LO(SWITCH_PAIRINGS_SIZE)
    LDY #HI(SWITCH_PAIRINGS_SIZE)

    JSR memcpy

    \
    \ relocate sprite data
    \

    \ first enemy sprite at enemyAtlas1
    LDA #LO(levelAltasLoaded) : STA srcAddr
    LDA #HI(levelAltasLoaded) : STA srcAddr+1

    LDA #LO(enemyAtlas1) : STA dstAddr
    LDA #HI(enemyAtlas1) : STA dstAddr+1

    LDX #LO(ENEMY_SPRITE_SIZE)
    LDY #HI(ENEMY_SPRITE_SIZE)

    JSR memcpy

    \ next enemy sprite at enemyAtlas2
    srcAddr1 = levelAltasLoaded + ENEMY_SPRITE_SIZE

    LDA #LO(srcAddr1) : STA srcAddr
    LDA #HI(srcAddr1) : STA srcAddr+1

    LDA #LO(enemyAtlas2) : STA dstAddr
    LDA #HI(enemyAtlas2) : STA dstAddr+1

    LDX #LO(ENEMY_SPRITE_SIZE)
    LDY #HI(ENEMY_SPRITE_SIZE)

    JSR memcpy

    \ next two enemy sprite at enemyAtlas3
    srcAddr2 = srcAddr1 + ENEMY_SPRITE_SIZE

    LDA #LO(srcAddr2) : STA srcAddr
    LDA #HI(srcAddr2) : STA srcAddr+1

    LDA #LO(enemyAtlas3) : STA dstAddr
    LDA #HI(enemyAtlas3) : STA dstAddr+1

    LDX #LO(ENEMY_SPRITE_SIZE * 2)
    LDY #HI(ENEMY_SPRITE_SIZE * 2)

    JSR memcpy

    \ next five enemy sprites at enemyAtlas4
    srcAddr3 = srcAddr2 + (ENEMY_SPRITE_SIZE * 2)

    LDA #LO(srcAddr3) : STA srcAddr
    LDA #HI(srcAddr3) : STA srcAddr+1

    LDA #LO(enemyAtlas4) : STA dstAddr
    LDA #HI(enemyAtlas4) : STA dstAddr+1

    LDX #LO(ENEMY_SPRITE_SIZE * 5)
    LDY #HI(ENEMY_SPRITE_SIZE * 5)

    JSR memcpy

    \ ...remaining two sprites at enemyAtlas5
    srcAddr4 = srcAddr3 + (ENEMY_SPRITE_SIZE * 5)

    LDA #LO(srcAddr4) : STA srcAddr
    LDA #HI(srcAddr4) : STA srcAddr+1

    LDA #LO(enemyAtlas5) : STA dstAddr
    LDA #HI(enemyAtlas5) : STA dstAddr+1

    LDX #LO(ENEMY_SPRITE_SIZE * 2)
    LDY #HI(ENEMY_SPRITE_SIZE * 2)

    JSR memcpy

    \ first door sprite at doorAtlas1
    srcAddr5 = srcAddr4 + (ENEMY_SPRITE_SIZE * 2)

    LDA #LO(srcAddr5) : STA srcAddr
    LDA #HI(srcAddr5) : STA srcAddr+1

    LDA #LO(doorAtlas1) : STA dstAddr
    LDA #HI(doorAtlas1) : STA dstAddr+1

    LDX #LO(DOOR_SPRITE_SIZE)
    LDY #HI(DOOR_SPRITE_SIZE)

    JSR memcpy

    \ next two door sprite at doorAtlas2
    srcAddr6 = srcAddr5 + DOOR_SPRITE_SIZE

    LDA #LO(srcAddr6) : STA srcAddr
    LDA #HI(srcAddr6) : STA srcAddr+1

    LDA #LO(doorAtlas2) : STA dstAddr
    LDA #HI(doorAtlas2) : STA dstAddr+1

    LDX #LO(DOOR_SPRITE_SIZE * 2)
    LDY #HI(DOOR_SPRITE_SIZE * 2)

    JSR memcpy

    \ last door sprite at doorAtlas3    
    srcAddr7 = srcAddr6 + (DOOR_SPRITE_SIZE * 2)

    LDA #LO(srcAddr7) : STA srcAddr
    LDA #HI(srcAddr7) : STA srcAddr+1

    LDA #LO(doorAtlas3) : STA dstAddr
    LDA #HI(doorAtlas3) : STA dstAddr+1

    LDX #LO(DOOR_SPRITE_SIZE)
    LDY #HI(DOOR_SPRITE_SIZE)

    JSR memcpy

    \ first elevator sprite at elevatorAtlas1
    srcAddr8 = srcAddr7 + DOOR_SPRITE_SIZE

    LDA #LO(srcAddr8): STA srcAddr
    LDA #HI(srcAddr8): STA srcAddr+1

    LDA #LO(elevatorAtlas1) : STA dstAddr
    LDA #HI(elevatorAtlas1) : STA dstAddr+1

    LDX #LO(ELEVATOR_SPRITE_SIZE)
    LDY #HI(ELEVATOR_SPRITE_SIZE)

    JSR memcpy

    \ remaining three elevator sprites at elevatorAtlas2
    srcAddr9 = srcAddr8 + ELEVATOR_SPRITE_SIZE

    LDA #LO(srcAddr9): STA srcAddr
    LDA #HI(srcAddr9): STA srcAddr+1

    LDA #LO(elevatorAtlas2) : STA dstAddr
    LDA #HI(elevatorAtlas2) : STA dstAddr+1

    LDX #LO(ELEVATOR_SPRITE_SIZE * 3)
    LDY #HI(ELEVATOR_SPRITE_SIZE * 3)

    JSR memcpy

    \ four teleport sprites at teleportAtlas
    srcAddr10 = srcAddr9 + (ELEVATOR_SPRITE_SIZE * 3)

    LDA #LO(srcAddr10): STA srcAddr
    LDA #HI(srcAddr10): STA srcAddr+1

    LDA #LO(teleportAtlas) : STA dstAddr
    LDA #HI(teleportAtlas) : STA dstAddr+1

    LDX #LO(ELEVATOR_SPRITE_SIZE * 4)
    LDY #HI(ELEVATOR_SPRITE_SIZE * 4)

    JSR memcpy

    \ first two k9 sprites at k9Atlas1
    srcAddr11 = srcAddr10 + (ELEVATOR_SPRITE_SIZE * 4)

    LDA #LO(srcAddr11) : STA srcAddr
    LDA #HI(srcAddr11) : STA srcAddr+1

    LDA #LO(k9Atlas1) : STA dstAddr
    LDA #HI(k9Atlas1) : STA dstAddr+1

    LDX #LO(K9_SPRITE_SIZE * 2)
    LDY #HI(K9_SPRITE_SIZE * 2)

    JSR memcpy

    \ next k9 sprite at k9Atlas2
    srcAddr12 = srcAddr11 + (K9_SPRITE_SIZE * 2)

    LDA #LO(srcAddr12) : STA srcAddr
    LDA #HI(srcAddr12) : STA srcAddr+1

    LDA #LO(k9Atlas2) : STA dstAddr
    LDA #HI(k9Atlas2) : STA dstAddr+1

    LDX #LO(K9_SPRITE_SIZE)
    LDY #HI(K9_SPRITE_SIZE)

    JSR memcpy

    \ remaining eight k9 sprites at k9Atlas3
    srcAddr13 = srcAddr12 + K9_SPRITE_SIZE

    LDA #LO(srcAddr13) : STA srcAddr
    LDA #HI(srcAddr13) : STA srcAddr+1

    LDA #LO(k9Atlas3) : STA dstAddr
    LDA #HI(k9Atlas3) : STA dstAddr+1

    LDX #LO(K9_SPRITE_SIZE * 8)
    LDY #HI(K9_SPRITE_SIZE * 8)

    JSR memcpy

    \ copy game bar atlas...
    srcAddr14 = srcAddr13 + (K9_SPRITE_SIZE * 8)

    LDA primarySamplesROMSEL
    ORA secondarySamplesROMSEL
    BEQ else
        \ copy atlas to primary sideways RAM
        LDA primarySamplesROMSEL : BEQ skip1
            JSR selectROM

            LDA #LO(gamebarAtlas_sidewaysRAM) : STA dstAddr
            LDA #HI(gamebarAtlas_sidewaysRAM) : STA dstAddr+1
        
            JSR copyGamebarAsset
        .skip1

        \ copy atlas to secondary sideways RAM
        LDA secondarySamplesROMSEL : BEQ skip2
            JSR selectROM

            LDA #LO(gamebarAtlas_sidewaysRAM) : STA dstAddr
            LDA #HI(gamebarAtlas_sidewaysRAM) : STA dstAddr+1
        
            JSR copyGamebarAsset
        .skip2

        RTS
    .else
        \ copy atlas to normal location, overwriting sample.6502
        LDA #LO(gamebarAtlas) : STA dstAddr
        LDA #HI(gamebarAtlas) : STA dstAddr+1
        
        \ fall through to copyGamebarAsset

.copyGamebarAsset
    LDA #LO(srcAddr14) : STA srcAddr
    LDA #HI(srcAddr14) : STA srcAddr+1

    LDX #LO(GAMEBAR_SPRITE_SIZE)
    LDY #HI(GAMEBAR_SPRITE_SIZE)

    JMP memcpy \ implicit RTS
}

\
\ initialize objects
\
\ Note that this routine is packaged with each level and is overwritten
\
.initializeObjects
{
    \ initialize counts (incremented below)
    LDA #0
    STA enemyCount
    STA elevatorCount
    STA doorCount

    STA index \ levelObjectsLoaded index
    LDX #0    \ game object index
    .loop1
        LDY index

        \ zero state
        LDA #0 : STA objectState, X

        \ objectType = animation | type
        LDA levelObjectsLoaded, Y
        BPL skip1
            JMP loop_exit \ sentinel, so exit loop
        .skip1
        INY

        STA temp
        AND #(OBJECT_TYPE_MASK OR ANIMATE_MASK)
        STA objectType, X

        \ disabled
        LDA temp
        AND #&40
        STA disabled
        
        \ objectX = (posX * 16)
        LDA levelObjectsLoaded, Y
        INY
        STA temp

        ASL A : ASL A : ASL A : ASL A
        STA objectXLo, X

        LDA temp
        LSR A : LSR A : LSR A : LSR A
        STA objectXHi, X
        
        \ objectY = (posY * 16)
        LDA levelObjectsLoaded, Y
        INY
        STA temp

        ASL A : ASL A : ASL A : ASL A
        STA objectYLo, X

        LDA temp
        LSR A : LSR A : LSR A : LSR A
        STA objectYHi, X

        \ data
        LDA levelObjectsLoaded, Y
        TAY \ --> data

        LDA objectType, X
        AND #OBJECT_TYPE_MASK \ extract type
        CMP #OBJECT_TYPE_ELEVATOR : BNE else_1
            \
            \ elevator / teleport specific properties
            \

            \ increment count
            INC elevatorCount
            
            CPY #0 : BNE else1
                \ elevator sprite index
                TXA
                AND #3
                CLC
                ADC #SPRITE_INDEX_ELEVATOR
                STA objectSpriteIndex, X

                \ elevator callback
                LDA #FRAME_CALLBACK_ELEVATOR : STA objectFrameCallback, X

                JMP endif1
            .else1
                \ teleport destination index (held in data)
                TYA
                STA objectFrameCounter, X

                \ teleport sprite index
                TXA
                AND #3
                CLC
                ADC #SPRITE_INDEX_TELEPORT
                STA objectSpriteIndex, X

                \ teleport callback
                LDA #FRAME_CALLBACK_TELEPORT : STA objectFrameCallback, X
            .endif1

            \ set tile flags
            LDA #TILE_GRID_FLAGS_OPAQUE : STA flags
            BNE endif

        .else_1
        CMP #OBJECT_TYPE_K9 : BNE else_2
            \
            \ k9 specific properties
            \

            \ animation
            LDA objectType, X
            AND #ANIMATE_MASK
            JSR k9Animate

            \ set tile flags
            LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_K9) : STA flags
            BNE endif

        .else_2
        CMP #OBJECT_TYPE_ENEMY : BNE else_3
            \
            \ enemy specific properties
            \

            \ increment count
            INC enemyCount

            \ set enemy health
            LDA objectState, X
            ORA #ENEMY_STATE_HEALTH_MASK
            STA objectState, X

            \ action 
            LDA objectType, X
            AND #ANIMATE_MASK
            BEQ endif2 \ if (A == ANIMATE_LOOK_LEFT)
            CMP #ANIMATE_LOOK_RIGHT : BEQ endif2
                ORA #(ACTION_PACE OR OBJECT_TYPE_ENEMY)
                STA objectType, X
            .endif2

            \ animation
            AND #ANIMATE_MASK
            JSR enemyAnimate

            \ set tile flags
            LDA #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY) : STA flags
            BNE endif

        .else_3
        CMP #OBJECT_TYPE_DOOR : BNE endif
            \
            \ elevator specific properties
            \

            \ increment count
            INC doorCount

            \ objectX += 8
            LDA objectXLo, X
            CLC
            ADC #8
            STA objectXLo, X

            \ sprite index
            TXA
            AND #3
            CLC
            ADC #SPRITE_INDEX_DOOR
            STA objectSpriteIndex, X

            \ callback
            LDA #FRAME_CALLBACK_DOOR : STA objectFrameCallback, X

            \ set tile flags
            LDA #TILE_GRID_FLAGS_OPAQUE : STA flags
        .endif

        JSR cacheObjectExtents
        JSR setObjectInsideTileFlags

        \ set disabled and redraw flags
        LDA disabled : BEQ else3
            LDA objectState, X
            ORA #OBJECT_STATE_FLAGS_DISABLED \ set disabled
            AND #LO(NOT(OBJECT_STATE_FLAGS_REDRAW)) \ clear redraw
            STA objectState, X
            BNE endif3
        .else3
            JSR setRedrawFlag
        .endif3
        
        \ index += 4
        LDA index
        CLC
        ADC #4
        STA index

        \ loop?
        INX
        CPX #MAX_OBJECT_COUNT
        BEQ loop_exit
        JMP loop1

    .loop_exit
    STX objectCount

    \ initialize object reverse draw order array
    DEX
    LDY #0
    .loop2
        \ objectReverseDrawOrder[Y] = X
        TXA
        STA objectReverseDrawOrder, Y
        INY
        DEX
        BPL loop2

    JMP sortObjectDrawOrder \ implicit RTS

.disabled SKIP 1
}

\
\ memcpy(dstAddr, srcAddr, X/Y registers)
\
\ params:
\   dstAddr         Destination address
\   srcAddr         Source address
\   X/Y registers   Size, number of bytes to copy (X = low-byte, Y = high-byte)
\
\ Modifies:
\   dstAddr += size
\   srcAddr += size
\
.memcpy
{
    STX sizeLo

    \ copy page(s)
    TYA : TAX
    BEQ skip1
    .pageLoop
        LDY #0
        .innerloop
            LDA (srcAddr),Y
            STA (dstAddr),Y
            INY
            BNE innerloop

        INC srcAddr+1
        INC dstAddr+1

        DEX
        BNE pageLoop
    .skip1

    \ copy sub-page
    LDX sizeLo
    BEQ skip2

    LDY #0
    .loop
        LDA (srcAddr),Y
        STA (dstAddr),Y
        INY

        DEX
        BNE loop

    LDA srcAddr
    CLC
    ADC sizeLo
    STA srcAddr
    BCC nocarry1
        INC srcAddr+1
    .nocarry1

    LDA dstAddr
    CLC
    ADC sizeLo
    STA dstAddr
    BCC nocarry2
        INC dstAddr+1
    .nocarry2

    .skip2

    RTS

.sizeLo SKIP 1
}

\
\ initializeSound()
\
.initializeSound
{
    \ set primary sounds vectors (write JMP addresses)
    LDX #8
    .loop1
        LDA primarySoundVectors, X : STA dstAddr
        LDA primarySoundVectors+1, X : STA dstAddr+1

        \ low byte
        LDA primarySounds_Regular, X
        LDY primarySamplesEnabled : BEQ skip1
            LDA primarySounds_SampleBased, X
        .skip1

        LDY #1
        STA (dstAddr), Y

        \ high byte
        LDA primarySounds_Regular+1, X
        LDY primarySamplesEnabled : BEQ skip2
            LDA primarySounds_SampleBased+1, X
        .skip2

        LDY #2
        STA (dstAddr), Y

        DEX
        DEX
        BPL loop1

    \ set secondary sounds vectors (write JMP addresses)
    LDX #4
    .loop2
        LDA secondarySoundVectors, X : STA dstAddr
        LDA secondarySoundVectors+1, X : STA dstAddr+1

        \ low byte
        LDA secondarySounds_Regular, X
        LDY secondarySamplesEnabled : BEQ skip3
            LDA secondarySounds_SampleBased, X
        .skip3

        LDY #1
        STA (dstAddr), Y

        \ high byte
        LDA secondarySounds_Regular+1, X
        LDY secondarySamplesEnabled : BEQ skip4
            LDA secondarySounds_SampleBased+1, X
        .skip4

        LDY #2
        STA (dstAddr), Y

        DEX
        DEX
        BPL loop2

    \ ensure tone generator 3 is initialized correctly
    JMP releaseToneGenerator3 \ implicit RTS

\ primary sound vectors (JMP xxxx)
.primarySoundVectors
    EQUW primarySoundVector_updatePursuit
    EQUW primarySoundVector_beginPursuit
    EQUW primarySoundVector_endPursuit
    EQUW primarySoundVector_enemyLasered
    EQUW primarySoundVector_weaponFired

\ secondary sound vectors (JMP xxxx)
.secondarySoundVectors
    EQUW secondarySoundVector_enemyDestroyed
    EQUW secondarySoundVector_levelStart
    EQUW secondarySoundVector_levelComplete

\ primary sound effect implementations
.primarySounds_Regular
    EQUW primarySoundEffect_updatePursuit       \ updatePursuit
    EQUW primarySoundEffect_beginPursuit        \ beginPursuit 
    EQUW primarySoundEffect_endPursuit          \ endPursuit   
    EQUW primarySoundEffect_enemyLasered        \ enemyLasered 
    EQUW primarySoundEffect_weaponFired         \ weaponFired  
                                        
.primarySounds_SampleBased
    EQUW primarySoundSample_updatePursuit       \ updatePursuit
    EQUW primarySoundSample_beginPursuit        \ beginPursuit 
    EQUW primarySoundSample_endPursuit          \ endPursuit   
    EQUW primarySoundSample_enemyLasered        \ enemyLasered 
    EQUW primarySoundSample_weaponFired         \ weaponFired  

\ secondary sound effect implementations
.secondarySounds_Regular
    EQUW secondarySoundEffect_enemyDestroyed    \ enemyDestroyed
    EQUW secondarySoundEffect_levelStart        \ levelStart
    EQUW secondarySoundEffect_levelComplete     \ levelComplete

.secondarySounds_SampleBased 
    EQUW secondarySoundSample_enemyDestroyed    \ enemyDestroyed
    EQUW secondarySoundSample_levelStart        \ levelStart
    EQUW secondarySoundSample_levelComplete     \ levelComplete 
}

\
\ selectROM(A)
\
\ select ROM helper
\
\ params:
\  Accumulator  ROM selector
\
.selectROM
{
    SEI
    STA &F4 : STA &FE30 \ ROMSEL
    CLI
    RTS
}

\
\ initializeSidewaysRam()
\
ASSERT (HI(P%) > &1C) \ ensure initializeSidewaysRam is assembled after page &17 and &1C

.initializeSidewaysRam
{
IF DEBUG_DISABLE_SIDEWAYS_RAM != 0
    RTS
    SKIP 32 \ ensure disabled routine uses same code space
ELSE
    \ relocate lasered enemy atlas to sideways RAM, but not
    \ during startup as the atlas was relocated in titles.6502
    LDA startup
    BNE skip
        LDA primarySamplesROMSEL : BEQ skip1
            JSR relocateLaseredEnemyAtlas
        .skip1

        LDA secondarySamplesROMSEL : BEQ skip2
            JSR relocateLaseredEnemyAtlas
        .skip2
    .skip

    \ relocate lasered sprite address table
    LDA primarySamplesROMSEL : BEQ skip3
        JSR relocateLaseredSpriteAddressTbl
    .skip3

    LDA secondarySamplesROMSEL : BEQ skip4
        JSR relocateLaseredSpriteAddressTbl
    .skip4

    RTS
ENDIF
}

\
\ loadLaseredSpriteData(Accumulator)
\
\ params:
\   Accumulator ROM selector
\
.relocateLaseredEnemyAtlas
{
    JSR selectROM

    LDA #LO(levelLaseredEnemyAtlasLoaded) : STA srcAddr
    LDA #HI(levelLaseredEnemyAtlasLoaded) : STA srcAddr+1

    LDA #LO(laseredEnemyAtlas) : STA dstAddr
    LDA #HI(laseredEnemyAtlas) : STA dstAddr+1

    LDX #LO(LASERED_EMEMY_ATLAS_SIZE)
    LDY #HI(LASERED_EMEMY_ATLAS_SIZE)

    JMP memcpy \ implcit RTS
}

\
\ populateSpriteAddressTbl(Accumulator)
\
\ params:
\   Accumulator ROM selector
\
.relocateLaseredSpriteAddressTbl
{
    JSR selectROM

    LDA #LO(spriteAddrTblLoLocal) : STA srcAddr
    LDA #HI(spriteAddrTblLoLocal) : STA srcAddr+1

    LDA #LO(laseredSpriteAddrTblLo) : STA dstAddr
    LDA #HI(laseredSpriteAddrTblLo) : STA dstAddr+1

    LDX #LO(LASERED_ENEMY_SPRITE_COUNT)
    LDY #HI(LASERED_ENEMY_SPRITE_COUNT)

    JSR memcpy

    LDA #LO(spriteAddrTblHiLocal) : STA srcAddr
    LDA #HI(spriteAddrTblHiLocal) : STA srcAddr+1

    LDA #LO(laseredSpriteAddrTblHi) : STA dstAddr
    LDA #HI(laseredSpriteAddrTblHi) : STA dstAddr+1

    LDX #LO(LASERED_ENEMY_SPRITE_COUNT)
    LDY #HI(LASERED_ENEMY_SPRITE_COUNT)

    JMP memcpy \ implicit RTS

.spriteAddrTblLoLocal
    FOR addr, laseredEnemyAtlas, laseredEnemyAtlas + ((LASERED_ENEMY_SPRITE_COUNT - 1) * ENEMY_SPRITE_SIZE), ENEMY_SPRITE_SIZE
        EQUB LO(addr)
    NEXT

.spriteAddrTblHiLocal
    FOR addr, laseredEnemyAtlas, laseredEnemyAtlas + ((LASERED_ENEMY_SPRITE_COUNT - 1) * ENEMY_SPRITE_SIZE), ENEMY_SPRITE_SIZE
        EQUB HI(addr)
    NEXT
}

\
\ relocateSampleParams
\
\ we relocate the params on top of the drawLaserObject routine
\

pcmDataStartAddrLoTbl = drawLaseredObject
pcmDataStartAddrHiTbl = drawLaseredObject+6
pcmDataEndAddrHiTbl = drawLaseredObject+12

.relocateSampleParams
{
    LDA primarySamplesROMSEL
    ORA secondarySamplesROMSEL
    BEQ return \ no sideways RAM, so no samples

    LDA #LO(pcmDataStartAddrLoTblLocal) : STA srcAddr
    LDA #HI(pcmDataStartAddrLoTblLocal) : STA srcAddr+1

    LDA #LO(pcmDataStartAddrLoTbl) : STA dstAddr
    LDA #HI(pcmDataStartAddrLoTbl) : STA dstAddr+1

    LDX #LO(6)
    LDY #HI(6)

    JSR memcpy

    LDA #LO(pcmDataStartAddrHiTblLocal) : STA srcAddr
    LDA #HI(pcmDataStartAddrHiTblLocal) : STA srcAddr+1

    LDA #LO(pcmDataStartAddrHiTbl) : STA dstAddr
    LDA #HI(pcmDataStartAddrHiTbl) : STA dstAddr+1

    LDX #LO(6)
    LDY #HI(6)

    JSR memcpy

    LDA #LO(pcmDataEndAddrHiTblLocal) : STA srcAddr
    LDA #HI(pcmDataEndAddrHiTblLocal) : STA srcAddr+1

    LDA #LO(pcmDataEndAddrHiTbl) : STA dstAddr
    LDA #HI(pcmDataEndAddrHiTbl) : STA dstAddr+1

    LDX #LO(6)
    LDY #HI(6)

    JSR memcpy 

    .return
    RTS

\ pasted from WAVConverter console app
.pcmDataStartAddrLoTblLocal EQUB &9D, &66, &82, &26, &96, &C5
.pcmDataStartAddrHiTblLocal EQUB &A1, &95, &80, &AC, &9E, &81
.pcmDataEndAddrHiTblLocal   EQUB &B6, &A1, &95, &B6, &AC, &9E
}

\ end file