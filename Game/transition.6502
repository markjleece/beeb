\
\ transition routines
\

\ transition constants
.transitionOpenConstants
    EQUW VSYNC_DELAY + 124 * 64 \ transitionUpperTimer
    EQUW 8 * 64                 \ transitionLowerTimer
    EQUB HI(-8 * 64)            \ transitionUpperTimerDelta
    EQUB HI(16 * 64)            \ transitionLowerTimerDelta
    EQUB 32                     \ transitionCounter
    EQUB TRANSITION_RUNNING     \ transitionState

.transitionCloseConstants
    EQUW VSYNC_DELAY + 4 * 64   \ transitionUpperTimer
    EQUW 248 * 64               \ transitionLowerTimer
    EQUB HI(8 * 64)             \ transitionLowerTimerDelta
    EQUB HI(-16 * 64)           \ transitionLowerTimerDelta
    EQUB 32                     \ transitionCounter
    EQUB TRANSITION_RUNNING     \ transitionState

\
\ completeTransition
\
\ invoked by the game loop after the v-sync
\
\ The routine invokes the transition callback when 
\ an crop open transition completes
\
.completeTransition
{
    \ if (transitionState != TRANSITION_COMPLETE) return
    LDA transitionState : BPL rts_9

    \ transitionState = TRANSITION_VOID
    LDA #TRANSITION_VOID
    STA transitionState

    \ invoke callback
    JMP (transitionCompleteCallback) \ implicit RTS
}

\
\ cropCloseTransition
\
\ performs a crop close transition, returning when the transition completes
\
.cropCloseTransition
{
    \ initiate transition
    LDA #LO(transitionCloseConstants)
    LDY #HI(transitionCloseConstants)
    JSR startTransition

    \ wait for until transitionState is TRANSITION_COMPLETE
    .loop
        LDA transitionState
        BPL loop

    \ transitionState = TRANSITION_VOID
    LDA #TRANSITION_VOID
    STA transitionState

    \ fall through to RTS
}

\
\ common RTS
\
.rts_9
{
    RTS
}

\
\ startCropOpenTransition(callback)
\
\ starts a crop open transition. The passed callback is invoked by 
\ completeTransition routine when the transition completes
\
\ params:
\   Accumulator     Callback address (low byte)
\   Y register      Callback address (high byte)
\
.startCropOpenTransition
{
    \ store callback
    STA transitionCompleteCallback
    STY transitionCompleteCallback+1

    LDA #LO(transitionOpenConstants)
    LDY #HI(transitionOpenConstants)
    \ fall through to startTransition
}

\
\ startTransition
\
\ params:
\   Accumulator     Transition constants (low byte)
\   Y register      Transition constants (high byte)
\
.startTransition
{
    SEI \ disable interrupts

    \ initialize variables (transitionUpperTimer..transitionState)
    STA srcAddr
    STY srcAddr+1
    LDY #7
    .loop
        LDA (srcAddr), Y
        STA transitionVariables, Y
        DEY
        BPL loop

    \ save IRQ (will be either ingame_isr or ingame_sample_isr)
    LDA IRQ1V : STA transitionPreviousIRQ1V
    LDA IRQ1V+1 : STA transitionPreviousIRQ1V+1

    \ set IRQ 
    LDA #LO(cropTransition_isr) : STA IRQ1V
    LDA #HI(cropTransition_isr) : STA IRQ1V+1

    \ switch System-VIA Timer1 to continuous mode
    LDA #&40
    STA &FE4B
    
    \ set System-VIA Timer1 default length
    LDA #&FF
    STA &FE44
    STA &FE45
   
    \ re-enable interrupts
    CLI

    RTS
}

\
\ crop transition interrupt service routine
\
.cropTransition_isr
{
    \ save accumulator
    LDA &FC : PHA

    \ System-VIA v-sync IRQ?
    LDA &FE4D 
    AND #2
    BEQ skip_vsync
        \
        \ Handle v-sync
        \
        STA &FE4D \ mark interrupt as handled
    
        \ signal v-sync (so the game continues to run)
        INC vsync

        \ stop transition?
        LDA transitionCounter
        BEQ stop_transition

        \ initiate timer for crop effect
        LDA transitionUpperTimer : STA &FE44
        LDA transitionUpperTimer+1 : STA &FE45
        LDA transitionLowerTimer : STA &FE46
        LDA transitionLowerTimer+1 : STA &FE47

        \ return with RTI (we don't want MOS processing v-syncs)
        JMP return_rti
    .skip_vsync

    \ System-VIA Timer1 IRQ?
    .try_timer_one
    LDA &FE4D
    AND #&40
    BEQ skip_timer1
        \
        \ Handle Timer1
        \

        \ save Y, as setLevelPalette and setBlackPalette modify Y
        TYA : PHA

        \ decrement counter
        LDA transitionCounter
        DEC transitionCounter
        LSR A : BCC else
            \
            \ Bottom crop boundary
            \

            \ set palette
            JSR setBlackPalette

            \ restore Y
            PLA : TAY

            \ set default timer (so no further interrupts occur this frame)
            LDA #&FF
            STA &FE44
            STA &FE45

            \ transitionUpperTimer += transitionUpperTimerDelta
            CLC
            LDA transitionUpperTimer+1
            ADC transitionUpperTimerDelta
            STA transitionUpperTimer+1

            \ transitionLowerTimer += transitionLowerTimerDelta
            CLC
            LDA transitionLowerTimer+1
            ADC transitionLowerTimerDelta
            STA transitionLowerTimer+1

            \ return with RTI (we don't want MOS processing sounds at the bottom crop boundary)
            JMP return_rti

        .else
            \
            \ Top crop boundary
            \

            \ set palette
            JSR setLevelPalette

            \ restore Y
            PLA : TAY

            \ fall through to let MOS process sounds at the top crop boundary
    .skip_timer1

    \ restore accumulator, updating &FC
    PLA : STA &FC

    \ pass System-VIA Timer1 IRQ to MOS, which processes sounds using this timer
    JMP (mosIRQ1V) \ implicit RTI

.stop_transition

    \ restore IRQ
    LDA transitionPreviousIRQ1V : STA IRQ1V
    LDA transitionPreviousIRQ1V+1 : STA IRQ1V+1

    \ restore System-VIA Timer1 to one-shot mode
    LDA #0
    STA &FE4B

    \ mark transition as complete (TRANSITION_RUNNING -> TRANSITION_COMPLETE)
    DEC transitionState
    DEC transitionState

    \ fall through to return RTI

.return_rti

    \ restore accumulator, updating &FC
    PLA : STA &FC

    \ just return (we don't want MOS to process System-VIA v-sync IRQ)
    RTI
}

\ end file
