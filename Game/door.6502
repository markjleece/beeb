\
\ Door routines
\

\
\ doorFrameCallback(X register) - animation frame callback
\
\ params:
\   X register   Door index
\
\ modifies:
\   self: dstAddr
\   getObjectTileGridAddr: tileGridAddr, temp, Y
\
.doorFrameCallback
{
    \ process every eight frames
    TXA
    CLC
    ADC frameCount
    AND #7
    BNE return

    \ temp = union of left and right opaque/enemy flags
    LDA #(DOOR_SPRITE_HEIGHT - 1) : STA offsetY
    LDA #LO(-9) : STA offsetX
    JSR getObjectTileGridValue
    INY : INY
    ORA (tileGridAddr), Y

    AND #(TILE_GRID_FLAGS_OPAQUE OR TILE_GRID_FLAGS_ENEMY)
    STA temp

    \ check if door is disabled
    LDA objectState, X
    AND #OBJECT_STATE_FLAGS_DISABLED : BEQ skip1
        .return
        RTS
    .skip1

    \ is the door open?
    LDA objectState, X
    AND #DOOR_STATE_FLAGS_DOOR_OPEN

    \ open / close door?
    ASL A : ASL A : ASL A : ASL A \ shift so door-open and opaque flags aligns
    EOR temp
    AND #TILE_GRID_FLAGS_OPAQUE : BEQ endif1

        \ open / close door
        LDA objectState, X
        AND #DOOR_STATE_FLAGS_DOOR_OPEN : BNE endif2

            SEC \ clear unlocked flag

            \ is k9 alone by a locked door?
            LDA temp
            AND #TILE_GRID_FLAGS_ENEMY : BNE endif3

                \ is the door locked?
                LDA objectState, X
                AND #DOOR_STATE_FLAGS_DOOR_UNLOCKED : BNE endif2

                    \ does K9 have a key?
                    LDA keyCount : BEQ endif1

                        \ use key and invoke sound effect
                        DEC keyCount
                        JSR keyJewelSoundEffect

                        CLC \ set unlocked flag
            .endif3

            \ clear or set unlocked flag
            LDA objectState, X
            ORA #DOOR_STATE_FLAGS_DOOR_UNLOCKED \ set
            BCC skip
                EOR #DOOR_STATE_FLAGS_DOOR_UNLOCKED \ clear
            .skip
            STA objectState, X

        .endif2

        \ toggle door open flag, and set redraw flag
        LDA objectState, X
        EOR #DOOR_STATE_FLAGS_DOOR_OPEN
        ORA #OBJECT_STATE_FLAGS_REDRAW
        STA objectState, X
    
        \ toggle door opaque lower and upper flags
        LDY #1
        LDA (tileGridAddr), Y
        EOR #TILE_GRID_FLAGS_OPAQUE
        STA (tileGridAddr), Y

        JSR tileGridAddr_sub_horzTileCount

        LDA (tileGridAddr), Y
        EOR #TILE_GRID_FLAGS_OPAQUE
        STA (tileGridAddr), Y
    .endif1

    \ set sprite index
    LDA objectState, X
    AND #DOOR_STATE_FLAGS_DOOR_OPEN : BNE else
        \ set redraw flag
        JSR setRedrawFlag
       
        \ next keyframe
        LDA objectSpriteIndex, X
        BMI resetIndex
        CLC
        ADC #1
        CMP #(SPRITE_INDEX_DOOR + 4)
        BNE endif
        .resetIndex
            LDA #SPRITE_INDEX_DOOR
            BNE endif
    .else
        LDA #&FF \ blank
    .endif
    STA objectSpriteIndex, X

    \ set redraw flag after scrolling?
    LDA doorScrollRedrawCount
    BEQ return

    DEC doorScrollRedrawCount
    JMP setRedrawFlag \ implicit RTS
}

\ end file