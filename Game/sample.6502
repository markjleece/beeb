\
\ Sample routines, used to play samples when 16K or 32K of sideways RAM is available
\
\ This code is overwritten with the gamebar atlas asset on machines that don't 
\ have 16K or 32K of sideways RAM
\

\
\ in-game sample interrupt request routine
\
.ingame_sample_irq
{
    \ save accumalator
    LDA &FC : PHA 

    \ User-VIA Timer1 irq?
    LDA &FE6D
    AND #&80
    BEQ try_vsync

    \
    \ Play sample (invoked 8000 times a second)
    \

    \ mark interrupt as handled
    LDA &FE64

    \ save Y
    TYA : PHA

    \ set data direction register A (write &FF to &FE43)
    LDY #&FF
    STY &FE43
        
    \ load sample (amplitude will be in high or low nibble)
    INY \ Y = 0
    LDA (pcmDataAddr), Y

    \ extract low or high nibble E.g. 'A &= 0xF' or 'A >>= 4'
    .^irq_inst1 NOP : NOP : NOP : NOP

    \ add 'set tone-3 volume' control bits
    ORA #&90

    \ output register A (write sound sample to &FE4F)
    STA &FE4F

    \ output register B, prepping write by setting chip write enable pin low (write 0 to &FE40)
    STY &FE40
        
    \ note: we need to keep the write enable line low for 8 us (16 cycles)

    \ increment pcmDataAddr
    INC pcmDataAddr \ 5 cycles
    BNE skip        \ 3 cycles (branch)
        INC pcmDataAddr+1

        \ have we reached the end of the first half or second half?
        LDA pcmDataAddr+1
        .^irq_inst2 CMP #0
        BNE skip

        \ have we played the first half or the second half?
        LDA irq_inst1 : CMP #&4A : BEQ else

            \ at end of first half, so reset pcmDataAddr
            .^irq_inst3 LDA #0 : STA pcmDataAddr
            .^irq_inst4 LDA #0 : STA pcmDataAddr+1

            \ and rewrite code to extract high nibbles
            LDA #&4A \ LSR A
            LDY #3
            .loop
                STA irq_inst1, Y
                DEY
                BPL loop
            BMI endif
        .else
            \ at end of second half, so disable User-VIA Timer1
            LDA #&40
            STA &FE6E
            
            \ playingSample = false
            LDA #0 
            STA playingSample
        .endif
    .skip

    \ restore Y
    PLA : TAY   \ 6 cycles

    \ complete write by setting chip write pin high (write 8 to &FE40)
    LDA #8      \ 2 cycles
    STA &FE40
   
    \ restore accumulator, updating &FC
    PLA : STA &FC

    \ just return (we don't want MOS to process User-VIA Timer1 irqs)
    RTI

.try_vsync
    JMP irq_try_vsync \ invoke regular IRQ
}

\
\ sample_play(A, Y)
\
\ plays a sample
\
\ params:
\   Accumalator     primarySamplesROMSEL or secondarySamplesROMSEL
\   Y register      SAMPLE_DALEK_EXTERMINATE, SAMPLE_DALEK_GROAN, SAMPLE_DALEK_WEAPON, SAMPLE_AFFIRMATIVE
\
.sample_play
{
    SEI \ disable interupts

    \ select sideways RAM bank
    STA &F4 : STA &FE30

    \ rewrite irq instructions to play first half of sample
    LDA pcmDataEndAddrHiTbl, Y : STA irq_inst2+1
    LDA pcmDataStartAddrLoTbl, Y : STA irq_inst3+1 : STA pcmDataAddr \ also set pcmDataAddr
    LDA pcmDataStartAddrHiTbl, Y : STA irq_inst4+1  : STA pcmDataAddr+1

    \ rewrite irq instuctions to extract low nibbles
    LDY #3
    .loop
        LDA instructions, Y
        STA irq_inst1, Y
        DEY
        BPL loop

    \ enable User-VIA Timer1
    LDA #&C0
    STA &FE6E

    \ playingSample = true
    INC playingSample

    CLI \ re-enable interrupts

    RTS

\ instructions: AND #&F : AND #&F
.instructions EQUB &29, &0F, &29, &0F
}

\
\ sample_stop()
\
\ stops sample playing
\
.sample_stop
{
    SEI \ disable interupts

    \ disable User-VIA Timer1
    LDA #&40
    STA &FE6E

    \ playingSample = false
    LDA #0 
    STA playingSample

    CLI \ re-enable interrupts

    \ fall through to RTS
}

\
\ common RTS
\
.rts_7
{
    RTS
}

\
\ sample_soundK9InsufficientData
\
\ invoked via primarySoundVector_startLevel
\
.sample_soundK9InsufficientData
{
    LDY #SAMPLE_K9_INSUFFICIENT_DATA
    LDA secondarySamplesROMSEL
    BNE sample_play \ implicit RTS
}

\
\ sample_soundK9Affirmative
\
.sample_soundK9Affirmative
{
    LDY #SAMPLE_K9_AFFIRMATIVE
    LDA secondarySamplesROMSEL
    BNE sample_play \ implicit RTS
}

\
\ sample_sample_soundTardisDoor
\
\ invoked via primarySoundVector_levelComplete
\
.sample_soundTardisDoor
{
    LDY #SAMPLE_TARDIS_DOOR
    LDA secondarySamplesROMSEL
    BNE sample_play \ implicit RTS
}

\
\ sample_soundDalekGroan()
\
\ invoked via primarySoundVector_enemyLasered by enemyLaserHit
\
.sample_soundDalekGroan
{
    LDA groanInhibited : BNE rts_7

        \ set flag
        INC groanInhibited

        \ reset exterminate frame counter
        LDA #SAMPLE_EXTERMINATE_FRAME_COUNT : STA pursuitSoundEffectCounter

        \ play sample
        LDY #SAMPLE_DALEK_GROAN
        LDA primarySamplesROMSEL
        BNE sample_play \ implicit RTS
}

\
\ sample_soundDalekWeapon()
\
\ invoked via primarySoundVector_weaponFired by inflictK9Damage
\
.sample_soundDalekWeapon
{
    LDY #SAMPLE_DALEK_WEAPON
    LDA primarySamplesROMSEL
    BNE sample_play \ implicit RTS
}

\
\ sample_updatePursuit()
\
\ invoked via primarySoundVector_updatePursuit by updateSoundEffects
\
.sample_updatePursuit
{
    \ is pursuit in progress?
    LDA pursuitSoundEffectCounter : BEQ rts_7

        \ decrement counter
        DEC pursuitSoundEffectCounter : BNE rts_7

            \ reset frame counter and play sample
            LDA #SAMPLE_EXTERMINATE_FRAME_COUNT : STA pursuitSoundEffectCounter

            \ fall through to sample_soundExterminate
}

\
\ sample_soundExterminate()
\
\ invoked via primarySoundVector_beginPursuit by pursuitSoundEffect
\
.sample_soundExterminate
{
    LDY #SAMPLE_DALEK_EXTERMINATE
    LDA primarySamplesROMSEL
    BNE sample_play \ implicit RTS
}

\ end file