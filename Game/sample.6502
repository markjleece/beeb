\
\ Sample routines, used to play samples when 16K of sideways RAM is available
\
\ This code is overwritten with the gamebar atlas asset on machines that don't 
\ have 16K of sideways RAM
\

\
\ in-game sample interrupt request routine
\
.ingame_sample_irq
{
    LDA &FC : PHA \ save accumalator

    \ User-VIA Timer1 irq?
    LDA &FE6D
    AND #&80
    BEQ try_vsync

    \
    \ Play sample (invoked 8000 times a second)
    \

    \ mark interrupt as handled
    LDA &FE64

    \ save Y
    TYA : PHA

    \ set data direction register A (write &FF to &FE43)
    LDY #&FF
    STY &FE43

    \ load sample (amplitude will be in high or low nibble)
    INY \ Y = 0
    LDA (pcmDataAddr), Y
        
    \ code rewritten to extract sample as 'A &= 0xF' or 'A >>= 4'
    .^irq_inst1 NOP : NOP : NOP : NOP

    \ add 'set tone-3 volume' control bits
    ORA #&90

    \ output register A (write sound sample to &FE4F)
    STA &FE4F

    \ output register B, prepping write by setting chip write enable pin low (write 0 to &FE40)
    STY &FE40 
        
    \ note: we need to keep the write enable line low for at least 8 us (16 cycles)

    \ increment pcmDataAddr
    INC pcmDataAddr
    BNE skip
        INC pcmDataAddr+1

        \ have we reached the end of the first half or second half?
        LDA pcmDataAddr+1
        .^irq_inst2 CMP #0
        BNE skip

        \ have we played the first half or the second half?
        LDA irq_inst1 : CMP #&4A : BEQ else

            \ reset pcmDataAddr
            .^irq_inst3 LDA #0 : STA pcmDataAddr
            .^irq_inst4 LDA #0 : STA pcmDataAddr+1

            \ rewrite code to play the second half
            LDA #&4A \ LSR A
            LDY #3
            .loop
                STA irq_inst1, Y
                DEY
                BPL loop
            BMI endif
        .else
            \ stop playback by disabling User-VIA Timer1
    	    LDA #&40
            STA &FE6E
        .endif
    .skip

    PLA : TAY \ restore Y

    \ write data by setting chip write pin high (write 8 to &FE40)
    LDA #8
    STA &FE40

    \ just return (we don't want MOS to process User-VIA Timer1 irqs)
    PLA \ restore accumulator
    RTI

.try_vsync
    JMP irq_try_vsync \ invoke regular IRQ
}

\
\ sample_play(Y)
\
\ plays a sample
\
\ params:
\   Y register  SAMPLE_EXTERMINATE, SAMPLE_GROAN, SAMPLE_WEAPON
\
.sample_play
{
    SEI \ disable interupts

    \ rewrite irq instructions to play first half of sample
    LDA pcmDataEndAddrHiTbl, Y : STA irq_inst2+1
    LDA pcmDataStartAddrLoTbl, Y : STA irq_inst3+1 : STA pcmDataAddr \ also set pcmDataAddr
    LDA pcmDataStartAddrHiTbl, Y : STA irq_inst4+1  : STA pcmDataAddr+1

    LDY #3
    .loop
        LDA instructions, Y
        STA irq_inst1, Y
        DEY
        BPL loop

    \ start playback
    LDA #&C0
    STA &FE6E

    \ select sideways RAM
    LDA dalekSamplesRAMBankNumber
    STA &F4 : STA &FE30 \ ROMSEL

    CLI \ re-enable interrupts

    RTS

\ instructions: AND #&F : AND #&F
.instructions EQUB &29, &0F, &29, &0F

\ generated by WAVConverter 
.pcmDataStartAddrLoTbl EQUB &9D, &D3, &6D
.pcmDataStartAddrHiTbl EQUB &AA, &9C, &80
.pcmDataEndAddrHiTbl   EQUB &BF, &AA, &9C
}

\
\ sample_stop()
\
\ stops sample playing
\
.sample_stop
{
    SEI \ disable interupts

    \ disable User-VIA Timer1
    LDA #&40
    STA &FE6E

    CLI \ re-enable interrupts
    RTS
}

\
\ sample_updatePursuit()
\
\ invoked via soundVector_updatePursuit by updateSoundEffects
\
.sample_updatePursuit
{
    \ is pursuit in progress?
    LDA pursuitSoundEffectCounter : BEQ return

        \ decrement counter
        DEC pursuitSoundEffectCounter : BNE return

            \ reset frame counter and play sample
            LDA #SAMPLE_EXTERMINATE_FRAME_COUNT : STA pursuitSoundEffectCounter

            \ sound exterminate
            BNE sample_soundExterminate

    .return
    RTS
}

\
\ sample_updatePursuit()
\
\ invoked via soundVector_beginPursuit by pursuitSoundEffect
\
.sample_soundExterminate
{
    LDY #SAMPLE_EXTERMINATE
    BEQ sample_play \ implicit RTS
}

\
\ sample_soundGrown()
\
\ invoked via soundVector_enemyLasered by enemyLaserHit
\
.sample_soundGrown
{
    LDA groanInhibited : BNE return

        \ set flag
        INC groanInhibited

        \ reset exterminate frame counter
        LDA #SAMPLE_EXTERMINATE_FRAME_COUNT : STA pursuitSoundEffectCounter

        \ play sample
        LDY #SAMPLE_GROAN
        JMP sample_play \ implicit RTS

    .return
    RTS
}

\
\ sample_soundWeapon()
\
\ invoked via soundVector_weaponFired by inflictK9Damage
\
.sample_soundWeapon
{
    LDY #SAMPLE_WEAPON
    BNE sample_play \ implicit RTS
}

\ end file