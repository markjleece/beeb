\
\ Title routines and data (overwritten when game starts)
\

\
\ titles
\
\ show titles screen, setting up the game
\
.titles
{
    JSR resetOSVectors
    JSR showTitleScreen
    JSR initializeVariables
    JSR playMusic
    JSR initializeSidewaysRAM
    JSR showTitleScreenPrompt
    JSR waitForSpaceKeyPress

    JSR showInstructionsScreen
    JSR waitForSpaceKeyPress
    
    JSR stopMusic
    JSR initializeInGameInterrupts
    JSR initializeEnvelopes
    JSR relocateBlackPalette
    JSR setBlackPalette
    JMP initializeLevel \ implicit RTS
}

\
\ initializeEnvelopes
\

.envelopesLocal
    EQUB 1, 1, 8, 4, -12, 4, 4, 4, 63, 0, 0, 0, 63, 63      \ SOUND_EFFECT_LASER_ON
    EQUB 2, 1, 0, 100, 0, 3, 1, 40, 96, -1, -1, -5, 96, 96  \ SOUND_EFFECT_LEVEL_COMPLETE & SOUND_EFFECT_ACHIEVEMENT
    EQUB 3, 1, 0, -10, 0, 10, 1, 40, 96, -1, -5, -5, 96, 96 \ SOUND_EFFECT_BLOCKED
    EQUB 4, 4, 6, -3, -3, 4, 2, 2, 0, 0, -1, 0, 63, 58      \ SOUND_EFFECT_PURSUIT_ON

MACRO DEFINE_ENVELOPE index
    \ call OSWORD with A = 8 to set up sound envelope
    LDX #LO(envelopesLocal + index * 14) 
    LDY #HI(envelopesLocal + index * 14)      
    LDA #8
    JSR osword
ENDMACRO

.initializeEnvelopes
{
    DEFINE_ENVELOPE 0
    DEFINE_ENVELOPE 1
    DEFINE_ENVELOPE 2
    DEFINE_ENVELOPE 3
}

\
\ relocate black palette
\

\ logical colors
PAL_color_0 = &00
PAL_color_1 = &20
PAL_color_2 = &80
PAL_color_3 = &A0

\ phycical colors
PAL_black   = (0 EOR 7)
PAL_red     = (1 EOR 7)
PAL_green   = (2 EOR 7)
PAL_yellow  = (3 EOR 7)
PAL_blue    = (4 EOR 7)
PAL_magenta = (5 EOR 7)
PAL_cyan    = (6 EOR 7)
PAL_white   = (7 EOR 7)

MACRO PALETTE_ENTRY logicalColor, physicalColor
    EQUB logicalColor + &00 + physicalColor
    EQUB logicalColor + &10 + physicalColor
    EQUB logicalColor + &40 + physicalColor
    EQUB logicalColor + &50 + physicalColor
ENDMACRO

.relocateBlackPalette
{
    \ black palette
    LDA #LO(blackPaletteLocal) : STA srcAddr
    LDA #HI(blackPaletteLocal) : STA srcAddr+1

    LDA #LO(blackPalette) : STA dstAddr
    LDA #HI(blackPalette) : STA dstAddr+1

    LDA #LO(16) : STA sizeLo
    LDA #HI(16) : STA sizeHi

    JMP memcpy \ implicit RTS

.blackPaletteLocal
    PALETTE_ENTRY PAL_color_0, PAL_black
    PALETTE_ENTRY PAL_color_1, PAL_black
    PALETTE_ENTRY PAL_color_2, PAL_black
    PALETTE_ENTRY PAL_color_3, PAL_black
}

\
\ showTitleScreen() & showTitleScreenPrompt()
\
\ Note that this routine is overwritten
\
.showTitleScreen
{
    titlesMinusPromptSize = (1000 - 40)

    \ switch to mode 7
    JSR setMode7  

    \ populate mode 7 screen memory (minus prompt line)
    LDA #LO(titles) : STA srcAddr
    LDA #HI(titles) : STA srcAddr+1

    LDA #LO(&7C00) : STA dstAddr
    LDA #HI(&7C00) : STA dstAddr+1

    LDA #LO(titlesMinusPromptSize) : STA sizeLo
    LDA #HI(titlesMinusPromptSize) : STA sizeHi

    JMP memcpy \ implicit RTS

.^showTitleScreenPrompt
    \ populate mode 7 screen memory (just the prompt line)
    LDA #LO(titles + titlesMinusPromptSize) : STA srcAddr
    LDA #HI(titles + titlesMinusPromptSize) : STA srcAddr+1

    LDA #LO(&7C00 + titlesMinusPromptSize) : STA dstAddr
    LDA #HI(&7C00 + titlesMinusPromptSize) : STA dstAddr+1

    LDA #LO(40) : STA sizeLo
    LDA #HI(40) : STA sizeHi

    JMP memcpy \ implicit RTS

.titles
INCBIN "data\\titles.bin"
}

\
\ showInstructionsScreen
\
.showInstructionsScreen
{
    \ switch to mode 7
    JSR setMode7  

    \ populate mode 7 screen memory
    LDA #LO(instructions) : STA srcAddr
    LDA #HI(instructions) : STA srcAddr+1

    LDA #LO(&7C00) : STA dstAddr
    LDA #HI(&7C00): STA dstAddr+1

    LDA #LO(1000) : STA sizeLo
    LDA #HI(1000) : STA sizeHi

    JMP memcpy \ implicit RTS

.instructions
INCBIN "data\\instructions.bin"
}


\
\ initialize variables
\ 
.initializeVariables
{
    \ zero zero-page variables
    LDX #(zeroPageMOS - 1)
    LDA #0
    .loop
        STA 0, X
        DEX
        BNE loop
    STA 0

    \ set level
    LDA #1 : STA level

    RTS
}

\
\ resetOSVectors()
\
.resetOSVectors
{
    \ get OS version, in X (1 denotes version 1.20)
    LDA #0
    LDX #1
    JSR osbyte

    SEI \ disable interrupts

    LDY #0
    CPX #1
    BEQ os120
     
    .os100
        .loop1
            \ copy vector
            LDA &D941,Y
            STA &0200,Y
            INY

            \ copied 27 vectors?
            CPY #54
            BNE loop1

        BEQ endif

    .os120
        \ srcAddr = &FFB7/&FFB8
        LDA &FFB7
        STA srcAddr
        LDA &FFB8
        STA srcAddr+1

        .loop2
            \ copy vector
            LDA (srcAddr),Y
            STA &0200,Y
            INY                

            \ copied all vectors?
            CPY &FFB6
            BNE loop2
    .endif

    CLI \ re-enable interrupts
    RTS
}

\
\ initialize in game interrupts
\
.initializeInGameInterrupts
{
    SEI \ disable interupts

    \ remember MOS IRQ1V
    LDA IRQ1V : STA mosIRQ1V
    LDA IRQ1V+1 : STA mosIRQ1V+1

    \ set IRQ1V vector to ingame interrupt IRQ
    LDA primarySamplesROMSEL
    ORA secondarySamplesROMSEL
    BEQ else
        LDA #LO(ingame_sample_irq) : STA IRQ1V
        LDA #HI(ingame_sample_irq) : STA IRQ1V+1
        JMP endif
    .else
        LDA #LO(ingame_irq) : STA IRQ1V
        LDA #HI(ingame_irq) : STA IRQ1V+1
    .endif

    \ disable System-VIA Timer2, CB1, CB2, and CA2 interrupts
    LDA #&7F
    STA &FE4E

    \ enable System-VIA Timer1 and vSync interrupts
    LDA #&C2
    STA &FE4E   

    \ set addressable latch for writing
    LDA #&0F
    STA &FE42

    \ set System-VIA Timer1 to one shot mode
    LDA #0
    STA &FE4B

    \ set System-VIA Timer1 default length
    LDA #&FF
    STA &FE44
    STA &FE45  

    LDA primarySamplesROMSEL
    ORA secondarySamplesROMSEL
    BEQ skip
        \ set User-VIA Timer1 to continous mode
        LDA #&40
        STA &FE6B
    
        \ set User-VIA Timer1 length to 1/8000th second
        LDA #LO(125) : STA &FE64
        LDA #HI(125) : STA &FE65
        LDA #LO(125 - 2) : STA &FE66
        LDA #HI(125 - 2) : STA &FE67
    .skip

    \ disable all User-VIA interupts
    LDA #&3F
    STA &FE6E

    CLI \ reenable interrupts

    RTS
}

\
\ initialize sideways RAM
\
.initializeSidewaysRAM
{
IF DEBUG_DISABLE_SIDEWAYS_RAM != 0
    RTS
    SKIP 81 \ ensure disabled routine uses same code space
ELSE
    \ save current ROM
    LDA &F4 : STA temp

    \ find sideways RAM, setting primarySamplesROMSEL and secondarySamplesROMSEL
    LDX #15
    .loop
        \ select ROM 'X'
        TXA
        JSR selectROM

        \ test for 16K of RAM, by writing and reading at address &8000 and &BFFF
        LDA #&FF : STA &8000 : STA &BFFF
        LDA &8000 : AND &BFFF : CMP #&FF : BNE continue

        LDA #0 : STA &8000 : STA &BFFF
        LDA &8000 : ORA &BFFF : BNE continue

        \ 16K RAM found, so assign to primarySamplesROMSEL first, then secondarySamplesROMSEL
        LDA primarySamplesROMSEL : BNE else
            STX primarySamplesROMSEL
            BEQ continue
        .else
            STX secondarySamplesROMSEL
            BNE break

        .continue
        DEX
        BNE loop

    .break

    \ populate sideways RAM
    LDA primarySamplesROMSEL : BEQ skip1
        LDX #'P'
        JSR populateSidewaysRAM
    .skip1

    LDA secondarySamplesROMSEL : BEQ skip2
        LDX #'S'
        JSR populateSidewaysRAM
    .skip2
   
    \ restore ROM
    LDA temp
    JMP selectROM \ implicit RTS

ENDIF
}

\
\ populateSidewaysRAM(A, X)
\
\ populate sideway RAM with PCM data
\
\ params:
\   Accumulator ROM selector
\   X register  File qualifier: 'P' for primary, 'S' for secondary
\

ASSERT (HI(P%) > &17) \ ensure populateSidewaysRAM is assembled after page &17

.populateSidewaysRAM
{
    \ save ROM selector in local
    STA sidewaysRamROMSEL

    \ set file qualifier
    STX cmdLoadPCMData+8

    \ clear page &17 (after saving the code) so DFS uses it as a buffer
    COPY_CLEAR_PAGE loadLevelPageBackup, &1700 

    \ switch to DFS
    JSR selectDFS

    \ save DFS ROM selector
    LDA &F4 : STA dfsROMSEL

    \ load pcm1..pcm5 files into sideways RAM
    LDA #LO(&8000) : STA dstAddr
    LDA #HI(&8000) : STA dstAddr+1

    LDA #LO(PCM_DATA_LOAD_BUFFER_SIZE) : STA sizeLo
    LDA #HI(PCM_DATA_LOAD_BUFFER_SIZE) : STA sizeHi

    LDA #'1' : STA index

    .loop
        \ update filename
        LDA index : STA cmdLoadPCMData+9

        \ load level file
        LDX #LO(cmdLoadPCMData)
        LDY #HI(cmdLoadPCMData)
        JSR oscli

        \ select sideways RAM
        LDA sidewaysRamROMSEL
        JSR selectROM

        \ copy data to sideways RAM (we need to reset srcAddr)
        LDA #LO(pcmDataLoadBuffer) : STA srcAddr
        LDA #HI(pcmDataLoadBuffer) : STA srcAddr+1
        JSR memcpy

        \ restore DFS ROM
        LDA dfsROMSEL
        JSR selectROM

        \ loop while index < '6'
        INC index
        LDA index
        CMP #'6'
        BNE loop

    \ restore code in page &17
    COPY_PAGE &1700, loadLevelPageBackup

    RTS

.cmdLoadPCMData
    EQUS "LOAD pcmTN", 13

.sidewaysRamROMSEL  SKIP 1
.dfsROMSEL          SKIP 1
}

.titlesEnd

\ end file